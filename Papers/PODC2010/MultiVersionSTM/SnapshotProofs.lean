import Papers.PODC2010.MultiVersionSTM.SnapshotLemmas

/-!
# The snapshot STMs are valid

For both the eager and the lazy snapshot STM (`snapSTM lazy`, `Snapshot.lean`) we prove
`snapSTM_valid`: it is strictly serializable, MV-permissive, its reads return written versions,
a read returns a kept version, and garbage collection is final (`STM.Valid`).

The proofs are first done at the level of histories generated by the strategy (`Gen lazy h`)
and then transferred to the STM.

* **Reads of written versions.** A latest version was written by a committed writer
  (`writes_of_latest`); an update transaction returns its own write only after writing.
* **MV-permissiveness.** The only aborts are reads and commits of update transactions that fail
  the read-set validation. The failed read returned the then-latest version, so some update
  transaction committed a write of the object after the read: it is concurrent with the aborted
  transaction and conflicts with it (`conflict_of_not_validates`).
* **Strict serializability** (of the complete transactions). The serialization position of a
  complete transaction is given by a key: `2 * i + 1` for an update transaction committing at
  index `i`; `2 * s` for a read-only transaction whose snapshot (at its commit) has length `s`,
  and for an aborted update transaction whose last external read has index `s` (`abSnap`: every
  read validates the earlier ones, so all its reads return versions of the prefix of length `s`);
  ties are broken by the index of the first event (`serPos`). The version of `o` in the prefix of
  length `s` is the one of the committed writer of `o` with the largest commit index below `s`
  (`WF.of_latest_some`), hence the last committed writer of `o` below the reader in the
  serialization.
* **Versions kept.** A version that is not kept is neither the latest one nor in the snapshot of
  a live read-only transaction; a step only installs a version of the committing transaction (not
  an existing version) and moves snapshots only to the new end of the history (`snap_snoc`).
-/

namespace Podc.MultiVersionSTM

open scoped Classical

variable {Tx O P : Type} [TxSys Tx P]

section HistLevel

variable {lazy : Bool} {h : Hist Tx O} {T : Tx} {o : O}

/-! ### Reads of written versions -/

theorem readsWritten_of_gen (hg : Gen lazy h) : ReadsWritten h := by
  intro h₁ T o W h₂ hdec
  have hr := hg _ _ _ hdec
  simp only [snapResp] at hr
  split_ifs at hr with hro hwr
  · exact (writes_of_latest (Option.some.inj hr).symm).of_take
  · obtain rfl : W = T := by simpa using hr
    exact hwr
  · exact writes_of_latest (Option.some.inj hr).symm

/-! ### MV-permissiveness -/

/-- If the read-set validation of a live update transaction `T` fails after `h₁`, then `T`
conflicts with a concurrent update transaction (whatever the aborted step `i` of `T` is). -/
lemma conflict_of_not_validates {h₁ : Hist Tx O} (hw₁ : WF h₁) (hg₁ : Gen lazy h₁)
    (hro : ro T = false) (hTnt : ¬ Terminated h₁ T) (hval : ¬ Validates h₁ T)
    (i : Inv Tx O) :
    ∃ T', T' ≠ T ∧ ro T' = false ∧ Concurrent (h₁ ++ [⟨i, none⟩]) T T' ∧
      Conflict (h₁ ++ [⟨i, none⟩]) T T' := by
  simp only [Validates, not_forall] at hval
  obtain ⟨a, o, v, b, hab, hnw, hne⟩ := hval
  have hrd := hg₁ _ _ _ hab
  simp only [snapResp, hro, hnw, Bool.false_eq_true, ↓reduceIte] at hrd
  replace hrd : v = latest a o := by
    split_ifs at hrd
    · exact Option.some.inj hrd
  have hj : h₁[a.length]? = some ⟨.read T o, some v⟩ := getElem?_of_decomp hab
  have hta : h₁.take a.length = a := take_of_decomp hab
  -- an overwrite of `o` after the read
  obtain ⟨k, e, hjk, hk, hce⟩ : ∃ k e, a.length ≤ k ∧ h₁[k]? = some e ∧
      CommitWrites (h₁.take k) e o := by
    by_contra! hno
    exact hne (hrd.trans (by rw [latest_eq_latest_take (j := a.length) hno, hta]))
  have hjk' : a.length < k := by
    rcases hjk.lt_or_eq with hlt | rfl
    · exact hlt
    · rw [hj] at hk; cases hk
      exact absurd hce (not_commitWrites_of_inv (by simp))
  obtain ⟨r, he⟩ := hce.eq
  set W := e.inv.tx with hW
  have hkW : h₁[k]? = some ⟨.commit W, some r⟩ := he ▸ hk
  have hWc : Committed h₁ W := committed_iff_getElem?.2 ⟨k, r, hkW⟩
  have hWw : Writes h₁ W o := hce.writes.of_take
  have hWT : W ≠ T := fun hWT => hTnt (Or.inl (hWT ▸ hWc))
  have hTb : Began h₁ T := ⟨_, List.mem_iff_getElem?.2 ⟨_, hj⟩, rfl⟩
  refine ⟨W, hWT, hw₁.ro_of_writes hWw, ⟨hTb.mono _, hWc.began.mono _, ?_, ?_⟩,
    ⟨o, ⟨_, List.mem_append_left _ (List.mem_iff_getElem?.2 ⟨_, hj⟩), rfl, rfl⟩,
      hWw.accesses.mono _, Or.inr (hWw.mono _)⟩⟩
  · -- `T` never commits
    rintro ⟨-, p, q, hpq, hpc, -⟩
    have : Committed (h₁ ++ [⟨i, none⟩]) T := hpq ▸ hpc.mono q
    rcases committed_append.1 this with hc | ⟨r', hr'⟩
    · exact hTnt (Or.inl hc)
    · simp at hr'
  · -- `W` commits after the read of `T`
    rintro ⟨-, p, q, hpq, hpc, hpb⟩
    obtain ⟨k', r', hk'⟩ := committed_iff_getElem?.1 hpc
    have hk'p := lt_length_of_getElem? hk'
    have hplen : p.length ≤ a.length := by
      by_contra! hlt
      apply hpb
      refine ⟨⟨.read T o, some v⟩, List.mem_iff_getElem?.2 ⟨a.length, ?_⟩, rfl⟩
      have : (p ++ q)[a.length]? = some ⟨.read T o, some v⟩ := by
        rw [← hpq, List.getElem?_append_left (by simp [lt_length_of_getElem? hj])]; exact hj
      rwa [List.getElem?_append_left hlt] at this
    have hk'1 : h₁[k']? = some ⟨.commit W, some r'⟩ := by
      have : (p ++ q)[k']? = some ⟨.commit W, some r'⟩ := by
        rw [List.getElem?_append_left hk'p]; exact hk'
      rw [← hpq, List.getElem?_append_left (by have := lt_length_of_getElem? hk; omega)] at this
      exact this
    have := hw₁.le_of_commit_at hk'1 hk hW.symm
    omega

theorem mvPerm_of_gen (hw : WF h) (hg : Gen lazy h) : MVPerm h := by
  intro h₁ i h₂ hdec
  have hr := hg _ _ _ hdec
  have hok : OKNext h₁ i := hw _ _ _ hdec
  have hw₁ : WF h₁ := (hdec ▸ hw : WF (h₁ ++ _)).of_append
  have hg₁ : Gen lazy h₁ := (hdec ▸ hg : Gen lazy (h₁ ++ _)).of_append
  cases i with
  | read T o =>
    simp only [snapResp] at hr
    split_ifs at hr with hro _ hval
    simp only [Bool.not_eq_true] at hro
    exact ⟨hro, conflict_of_not_validates hw₁ hg₁ hro hok.1 hval _⟩
  | write T o => simp [snapResp] at hr
  | commit T =>
    simp only [snapResp] at hr
    split_ifs at hr with hro hval
    simp only [Bool.not_eq_true] at hro
    exact ⟨hro, conflict_of_not_validates hw₁ hg₁ hro hok.1 hval _⟩

/-! ### Strict serializability -/

/-- The `j`-th event of `h` is a successful read of `T` that does not follow a write of `T` to
the object read (an *external* read). -/
def ExtRead (h : Hist Tx O) (T : Tx) (j : ℕ) : Prop :=
  ∃ o v, h[j]? = some ⟨.read T o, some v⟩ ∧ ¬ Writes (h.take j) T o

/-- The snapshot of an update transaction that did not commit: the index of its last external
read (or of its first event, if it has no external read). -/
noncomputable def abSnap (h : Hist Tx O) (T : Tx) : ℕ :=
  max (firstIdx h T) (Nat.findGreatest (ExtRead h T) h.length)

/-- The serialization key: `2 * i + 1` for an update transaction committing at index `i`;
`2 * s` for a read-only transaction whose snapshot at its commit has length `s`, and for an
aborted update transaction whose last external read has index `s` (`abSnap`). -/
noncomputable def serKey (lazy : Bool) (h : Hist Tx O) (T : Tx) : ℕ :=
  if ro T then 2 * snap lazy (h.take (cidx h T)) T
  else if Committed h T then 2 * cidx h T + 1 else 2 * abSnap h T

/-- The serialization position: the key, ties broken by the index of the first event. -/
noncomputable def serPos (lazy : Bool) (h : Hist Tx O) (T : Tx) : ℕ :=
  serKey lazy h T * (h.length + 1) + firstIdx h T

private lemma lt_of_key_lt {k₁ k₂ c₁ c₂ N : ℕ} (hc : c₁ < N) (hk : k₁ < k₂) :
    k₁ * N + c₁ < k₂ * N + c₂ := by
  have : (k₁ + 1) * N ≤ k₂ * N := Nat.mul_le_mul_right _ hk
  nlinarith

lemma serPos_lt_of_serKey_lt {A B : Tx} (hk : serKey lazy h A < serKey lazy h B) :
    serPos lazy h A < serPos lazy h B :=
  lt_of_key_lt (Nat.lt_succ_of_le firstIdx_le_length) hk

lemma serKey_le_of_serPos_lt {A B : Tx} (hp : serPos lazy h A < serPos lazy h B) :
    serKey lazy h A ≤ serKey lazy h B := by
  by_contra! hk
  exact absurd (serPos_lt_of_serKey_lt hk) (not_lt.2 hp.le)

lemma firstIdx_eq_of_serPos_eq {A B : Tx} (hp : serPos lazy h A = serPos lazy h B) :
    firstIdx h A = firstIdx h B := by
  have hkk : serKey lazy h A = serKey lazy h B := by
    rcases lt_trichotomy (serKey lazy h A) (serKey lazy h B) with hlt | heq | hgt
    · exact absurd hp (serPos_lt_of_serKey_lt hlt).ne
    · exact heq
    · exact absurd hp (serPos_lt_of_serKey_lt hgt).ne'
  unfold serPos at hp
  rw [hkk] at hp
  omega

lemma serKey_le (hc : Committed h T) : serKey lazy h T ≤ 2 * cidx h T + 1 := by
  unfold serKey
  split_ifs
  · have := snap_le_length lazy (h := h.take (cidx h T)) (T := T)
    simp at this; omega
  · exact le_rfl

lemma serKey_of_committed_update (hro : ro T = false) (hc : Committed h T) :
    serKey lazy h T = 2 * cidx h T + 1 := by
  simp [serKey, hro, hc]

lemma serKey_of_aborted_update (hro : ro T = false) (hc : ¬ Committed h T) :
    serKey lazy h T = 2 * abSnap h T := by
  simp [serKey, hro, hc]

lemma serKey_of_ro_true (hro : ro T = true) :
    serKey lazy h T = 2 * snap lazy (h.take (cidx h T)) T := by
  simp [serKey, hro]

lemma serKey_cwriter (hw : WF h) {W : Tx} (hcw : CWriter h o W) :
    serKey lazy h W = 2 * cidx h W + 1 :=
  serKey_of_committed_update (hw.ro_of_cwriter hcw) hcw.1

lemma serKey_ge : 2 * firstIdx h T ≤ serKey lazy h T := by
  have hf : firstIdx h T ≤ cidx h T := firstIdx_le_cidx
  have hfl : firstIdx h T ≤ h.length := firstIdx_le_length
  unfold serKey
  split_ifs
  · unfold snap
    split_ifs
    · cases hfz : frz (h.take (cidx h T)) T with
      | none => simp; omega
      | some k =>
        obtain ⟨-, ⟨e, -, o, -, v, hv⟩, -⟩ := frz_eq_some_iff.1 hfz
        rw [List.take_take] at hv
        obtain ⟨k', hk', hk'e⟩ := mem_take_iff_getElem?.1 hv
        have : firstIdx h T ≤ k' := firstIdx_le hk'e rfl
        simp only [Option.getD_some]
        have : k' < k := lt_of_lt_of_le hk' (min_le_left _ _)
        omega
    · rw [firstIdx_take]; omega
  · omega
  · unfold abSnap; omega

lemma cidx_lt_firstIdx_of_RT {A B : Tx} (hrt : RT h A B) : cidx h A < firstIdx h B := by
  obtain ⟨hB, p, q, rfl, hpc, hpb⟩ := hrt
  obtain ⟨k, r, hk⟩ := committed_iff_getElem?.1 hpc
  have hkp := lt_length_of_getElem? hk
  have h1 : cidx (p ++ q) A ≤ k := cidx_le_of (by rw [List.getElem?_append_left hkp]; exact hk)
  have h2 : p.length ≤ firstIdx (p ++ q) B := by
    by_contra! hlt
    obtain ⟨e, he, heT⟩ := firstIdx_getElem? hB
    rw [List.getElem?_append_left hlt] at he
    exact hpb ⟨e, List.mem_iff_getElem?.2 ⟨_, he⟩, heT⟩
  omega

/-- Read-only transactions never abort. -/
lemma committed_of_ro (hg : Gen lazy h) (hro : ro T = true) (ht : Terminated h T) :
    Committed h T := by
  rcases ht with hc | ⟨e, he, heT, hen⟩
  · exact hc
  · exfalso
    obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 he
    have hr := hg.at hk
    rw [hen] at hr
    obtain ⟨i, r⟩ := e
    subst heT
    cases i with
    | read T' o => simp only [Inv.tx_read] at hro; simp [snapResp, hro] at hr
    | write T' o => simp [snapResp] at hr
    | commit T' => simp only [Inv.tx_commit] at hro; simp [snapResp, hro] at hr

/-- An external read of an update transaction returns the latest version at the time of its
last external read (every read validates the earlier ones). -/
lemma update_read_value (hg : Gen lazy h) (hro : ro T = false) {j : ℕ} {v : Option Tx}
    (hj : h[j]? = some ⟨.read T o, some v⟩) (hnw : ¬ Writes (h.take j) T o) :
    v = latest (h.take (abSnap h T)) o := by
  have hjl := lt_length_of_getElem? hj
  have hext : ExtRead h T j := ⟨o, v, hj, hnw⟩
  have hjm : j ≤ Nat.findGreatest (ExtRead h T) h.length := Nat.le_findGreatest hjl.le hext
  have hextm := Nat.findGreatest_spec (P := ExtRead h T) hjl.le hext
  have hfj : firstIdx h T ≤ j := firstIdx_le hj rfl
  have habs : abSnap h T = Nat.findGreatest (ExtRead h T) h.length := by
    unfold abSnap; exact max_eq_right (hfj.trans hjm)
  rw [habs]
  generalize Nat.findGreatest (ExtRead h T) h.length = m at hjm hextm
  obtain ⟨o', v', hm', hnw'⟩ := hextm
  rcases hjm.lt_or_eq with hlt | heq
  · have hresp := hg.at hm'
    simp only [snapResp, hro, hnw', Bool.false_eq_true, ↓reduceIte] at hresp
    have hval : Validates (h.take m) T := by
      by_contra hnv; simp [hnv] at hresp
    have hj' : (h.take m)[j]? = some ⟨.read T o, some v⟩ := by
      rw [List.getElem?_take_of_lt hlt]; exact hj
    exact hval _ o v _ (eq_take_append_cons hj') (by rwa [List.take_take, min_eq_left hlt.le])
  · subst heq
    have hresp := hg.at hj
    simp only [snapResp, hro, hnw, Bool.false_eq_true, ↓reduceIte] at hresp
    split_ifs at hresp
    exact Option.some.inj hresp

/-- The read of a version of the prefix of length `s` is legal, if the key of the reader
compares with the keys of the committed writers of `o` according to their commit index and `s`. -/
lemma extLegal_latest_take (hw : WF h) {s : ℕ}
    (hlt : ∀ W, CWriter h o W → cidx h W < s → W ≠ T ∧ serKey lazy h W < serKey lazy h T)
    (hge : ∀ W, CWriter h o W → W ≠ T → s ≤ cidx h W → serKey lazy h T < serKey lazy h W) :
    ExtLegal h (serPos lazy h) T o (latest (h.take s) o) := by
  cases hl : latest (h.take s) o with
  | none =>
    intro W hcw hne
    exact serPos_lt_of_serKey_lt (hge W hcw hne (hw.le_cidx_of_latest_none hl hcw))
  | some W =>
    obtain ⟨hcw, hcs, hmax⟩ := hw.of_latest_some hl
    obtain ⟨hne, hkey⟩ := hlt W hcw hcs
    refine ⟨hne, hcw, serPos_lt_of_serKey_lt hkey, fun W' hcw' hne' hpos' => ?_⟩
    have hk' := serKey_le_of_serPos_lt hpos'
    have hcs' : cidx h W' < s := by
      by_contra! hle
      exact absurd hk' (not_le.2 (hge W' hcw' hne' hle))
    rcases (hmax W' hcw' hcs').lt_or_eq with hlt' | heq
    · apply le_of_lt
      apply serPos_lt_of_serKey_lt
      rw [serKey_cwriter hw hcw, serKey_cwriter hw hcw']
      omega
    · rw [cidx_inj hcw'.1 hcw.1 heq]

/-- A read of a read-only transaction returns a version of the snapshot of the transaction at
its commit. -/
lemma ro_read_value (hc : Committed h T) {j : ℕ} {v : Option Tx}
    (hj : h[j]? = some ⟨.read T o, some v⟩) (hjc : j < cidx h T)
    (hv : v = latest ((h.take j).take (snap lazy (h.take j) T)) o) :
    v = latest (h.take (snap lazy (h.take (cidx h T)) T)) o := by
  have hjl := lt_length_of_getElem? hj
  have hcl := cidx_lt hc
  set c := cidx h T with hcdef
  have htj : (h.take c).take j = h.take j := by rw [List.take_take, min_eq_left hjc.le]
  cases lazy with
  | false =>
    have hf : firstIdx h T ≤ j := firstIdx_le hj rfl
    simp only [snap, Bool.false_eq_true, ↓reduceIte, firstIdx_take] at hv ⊢
    rw [hv, min_eq_right hf, min_eq_right (hf.trans hjc.le), List.take_take, min_eq_left hf]
  | true =>
    simp only [snap, ↓reduceIte] at hv ⊢
    cases hfz : frz (h.take j) T with
    | some k =>
      have hk := frz_lt_length hfz
      have hfz' : frz (h.take c) T = some k := frz_of_frz_take (by rw [htj]; exact hfz)
      rw [hfz] at hv
      rw [hfz', hv]
      simp only [Option.getD_some]
      rw [List.take_take, min_eq_left (by simp at hk; omega)]
    | none =>
      rw [hfz] at hv
      simp only [Option.getD_none, List.length_take, min_eq_left hjl.le, List.take_take,
        min_self] at hv
      rw [hv]
      set s := (frz (h.take c) T).getD (h.take c).length with hs
      have hsc : s ≤ c := by
        have := snap_le_length true (h := h.take c) (T := T)
        simp only [snap, ↓reduceIte] at this
        exact this.trans (List.length_take_le _ _)
      have hjs : j ≤ s := by
        cases hfz' : frz (h.take c) T with
        | none => simp only [hs, hfz', Option.getD_none, List.length_take]; omega
        | some k =>
          simp only [hs, hfz', Option.getD_some]
          exact le_of_frz_take_none (by rw [htj]; exact hfz) hfz'
      symm
      rw [latest_eq_latest_take (j := j), List.take_take, min_eq_left hjs]
      intro k e hjk hke hce
      obtain ⟨hks, hk⟩ := getElem?_take_eq_some hke
      rw [List.take_take, min_eq_left hks.le] at hce
      rcases hjk.lt_or_eq with hlt | rfl
      · have hfr : Freezes h T k :=
          ⟨e, hk, o, hce, v, mem_take_of_getElem? hj hlt⟩
        obtain ⟨k', hk', hk'k⟩ := frz_take_some_of_freezes (lt_of_lt_of_le hks hsc) hfr
        simp only [hs, hk', Option.getD_some] at hks
        omega
      · rw [hj] at hk; cases hk
        exact not_commitWrites_of_inv (by simp) hce

/-- Every read of a complete transaction (not after its own write) is legal. -/
lemma legal_read (hw : WF h) (hg : Gen lazy h) (ht : Terminated h T) {j : ℕ} {v : Option Tx}
    (hj : h[j]? = some ⟨.read T o, some v⟩) (hnw : ¬ Writes (h.take j) T o) :
    ExtLegal h (serPos lazy h) T o v := by
  by_cases hro : ro T = true
  · have hc := committed_of_ro hg hro ht
    have hjc : j < cidx h T := hw.lt_cidx hc hj rfl (by simp)
    have hresp := hg.at hj
    simp only [snapResp, hro, ↓reduceIte, Option.some.injEq] at hresp
    rw [ro_read_value hc hj hjc hresp]
    apply extLegal_latest_take hw
    · intro W hcw _
      have hWro := hw.ro_of_cwriter hcw
      refine ⟨fun hWT => (by subst hWT; simp [hro] at hWro), ?_⟩
      rw [serKey_cwriter hw hcw, serKey_of_ro_true hro]; omega
    · intro W hcw _ hle
      rw [serKey_cwriter hw hcw, serKey_of_ro_true hro]; omega
  simp only [Bool.not_eq_true] at hro
  by_cases hc : Committed h T
  · have hjc : j < cidx h T := hw.lt_cidx hc hj rfl (by simp)
    -- the commit of `T` validated the read
    obtain ⟨r, hr⟩ := cidx_spec hc
    have hresp := hg.at hr
    simp only [snapResp, hro, Bool.false_eq_true, ↓reduceIte] at hresp
    have hval : Validates (h.take (cidx h T)) T := by
      by_contra hnv; simp [hnv] at hresp
    have htj : (h.take (cidx h T)).take j = h.take j := by
      rw [List.take_take, min_eq_left hjc.le]
    have hv : v = latest (h.take (cidx h T)) o := by
      have hj' : (h.take (cidx h T))[j]? = some ⟨.read T o, some v⟩ := by
        rw [List.getElem?_take_of_lt hjc]; exact hj
      exact hval _ o v _ (eq_take_append_cons hj') (by rwa [htj])
    rw [hv]
    apply extLegal_latest_take hw
    · intro W hcw hlt
      refine ⟨fun hWT => by rw [hWT] at hlt; omega, ?_⟩
      rw [serKey_cwriter hw hcw, serKey_of_committed_update hro hc]; omega
    · intro W hcw hne hle
      have : cidx h W ≠ cidx h T := fun heq => hne (cidx_inj hcw.1 hc heq)
      rw [serKey_cwriter hw hcw, serKey_of_committed_update hro hc]; omega
  · -- an aborted update transaction
    rw [update_read_value hg hro hj hnw]
    apply extLegal_latest_take hw
    · intro W hcw _
      refine ⟨fun hWT => hc (hWT ▸ hcw.1), ?_⟩
      rw [serKey_cwriter hw hcw, serKey_of_aborted_update hro hc]; omega
    · intro W hcw _ hle
      rw [serKey_cwriter hw hcw, serKey_of_aborted_update hro hc]; omega

theorem strictSer_of_gen (hw : WF h) (hg : Gen lazy h) : StrictSer h := by
  refine ⟨serPos lazy h,
    fun A B hA hB heq => firstIdx_inj hA.began hB.began (firstIdx_eq_of_serPos_eq heq),
    fun A B hA _ hrt => ?_, fun T ht h₁ o v h₂ hdec => ?_⟩
  · apply serPos_lt_of_serKey_lt
    have h1 := serKey_le (lazy := lazy) hA
    have h2 := serKey_ge (lazy := lazy) (h := h) (T := B)
    have h3 := cidx_lt_firstIdx_of_RT hrt
    omega
  · have hj := getElem?_of_decomp hdec
    have htake := take_of_decomp hdec
    refine ⟨fun hwr => ?_, fun hnw => legal_read hw hg ht hj (by rwa [htake])⟩
    have hro : ro T = false := hw.ro_of_writes (hdec ▸ hwr.mono _)
    have := hg _ _ _ hdec
    simp only [snapResp, hro, hwr, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at this
    exact this

/-! ### Versions kept -/

lemma VExists.mono {v : Version Tx O} (hv : VExists h v) (t : Hist Tx O) : VExists (h ++ t) v := by
  obtain ⟨o, _ | W⟩ := v
  · trivial
  · exact ⟨hv.1.mono t, hv.2.mono t⟩

lemma mem_snapKept {v : Version Tx O} :
    v ∈ snapKept lazy h ↔ v.2 = latest h v.1 ∨
      ∃ T, ro T = true ∧ ¬ Terminated h T ∧ v.2 = latest (h.take (snap lazy h T)) v.1 :=
  Iff.rfl

/-- A read returns a kept version. -/
lemma snapKept_of_read (hok : OKNext h (.read T o)) {v : Option Tx}
    (hr : snapResp lazy h (.read T o) = some v) (hnw : ¬ Writes h T o) :
    (o, v) ∈ snapKept lazy h := by
  simp only [snapResp, hnw, ↓reduceIte] at hr
  split_ifs at hr with hro
  · exact Or.inr ⟨T, hro, hok.1, (Option.some.inj hr).symm⟩
  · exact Or.inl (Option.some.inj hr).symm

/-- One step: an existing version that is not kept is not kept after the step. -/
lemma not_mem_snapKept_snoc {e : Event Tx O} (hw : WF (h ++ [e])) {v : Version Tx O}
    (hv : VExists h v) (hnk : v ∉ snapKept lazy h) : v ∉ snapKept lazy (h ++ [e]) := by
  obtain ⟨o, x⟩ := v
  simp only [mem_snapKept, not_or, not_exists, not_and] at hnk ⊢
  obtain ⟨hnl, hns⟩ := hnk
  have hok : OKNext h e.inv := hw h e [] rfl
  have hlat : x ≠ latest (h ++ [e]) o := by
    rw [latest_snoc]
    split_ifs with hce
    · rintro rfl
      exact hok.1 (Or.inl hv.1)
    · exact hnl
  refine ⟨hlat, fun T hro hnt => ?_⟩
  have hnt' : ¬ Terminated h T := fun ht => hnt (ht.mono _)
  rcases snap_snoc (h := h) (T := T) lazy e with heq | heq
  · rw [heq, List.take_append_of_le_length (snap_le_length lazy)]
    exact hns T hro hnt'
  · rw [heq, List.take_of_length_le (by simp)]
    exact hlat

lemma not_mem_snapKept_append {t : Hist Tx O} (hw : WF (h ++ t)) {v : Version Tx O}
    (hv : VExists h v) (hnk : v ∉ snapKept lazy h) : v ∉ snapKept lazy (h ++ t) := by
  induction t using List.reverseRecOn with
  | nil => simpa using hnk
  | append_singleton t e ih =>
    rw [← List.append_assoc] at hw ⊢
    exact not_mem_snapKept_snoc hw (hv.mono t) (ih hw.of_append)

end HistLevel

/-! ### The snapshot STMs -/

section STMLevel

variable (lazy : Bool)

lemma snapSTM_conf_mem (σ : List (Inv Tx O)) :
    ((snapSTM (Tx := Tx) (O := O) (P := P) lazy).conf σ).mem () =
      (snapSTM (Tx := Tx) (O := O) (P := P) lazy).hist σ :=
  ofStrategy.conf_mem _ σ

lemma snapSTM_resp (σ : List (Inv Tx O)) (i : Inv Tx O) :
    (snapSTM (Tx := Tx) (O := O) (P := P) lazy).resp σ i =
      snapResp lazy ((snapSTM (Tx := Tx) (O := O) (P := P) lazy).hist σ) i :=
  ofStrategy.resp_eq _ σ i

/-- The snapshot STMs are strictly serializable. -/
theorem snapSTM_correct : (snapSTM (Tx := Tx) (O := O) (P := P) lazy).Correct :=
  fun σ hw => strictSer_of_gen hw (gen_hist lazy σ)

/-- The snapshot STMs are MV-permissive (Definition 2). -/
theorem snapSTM_mvPermissive : (snapSTM (Tx := Tx) (O := O) (P := P) lazy).MVPermissive :=
  fun σ hw => mvPerm_of_gen hw (gen_hist lazy σ)

/-- The reads of the snapshot STMs return written versions. -/
theorem snapSTM_readsWritten : (snapSTM (Tx := Tx) (O := O) (P := P) lazy).ReadsWrittenOnly :=
  fun σ _ => readsWritten_of_gen (gen_hist lazy σ)

/-- A read of the snapshot STMs returns a kept version. -/
theorem snapSTM_keepsReads :
    (snapSTM (Tx := Tx) (O := O) (P := P) lazy).KeepsReads (snapKeptC lazy) := by
  intro σ T o v hw hr hnw
  rw [STM.hist_snoc] at hw
  have hok := ((WF.snoc_iff _).1 hw).2
  rw [snapSTM_resp] at hr
  show (o, v) ∈ snapKept lazy (((snapSTM (Tx := Tx) (O := O) (P := P) lazy).conf σ).mem ())
  rw [snapSTM_conf_mem]
  exact snapKept_of_read hok hr hnw

/-- Garbage collection of the snapshot STMs is final. -/
theorem snapSTM_gcFinal :
    (snapSTM (Tx := Tx) (O := O) (P := P) lazy).GCFinal (snapKeptC lazy) := by
  intro σ τ v hw hv hnk
  show v ∉ snapKept lazy (((snapSTM (Tx := Tx) (O := O) (P := P) lazy).conf (σ ++ τ)).mem ())
  change v ∉ snapKept lazy (((snapSTM (Tx := Tx) (O := O) (P := P) lazy).conf σ).mem ()) at hnk
  rw [snapSTM_conf_mem] at hnk ⊢
  rw [STM.hist_append] at hw ⊢
  exact not_mem_snapKept_append hw hv hnk

/-- **The snapshot STMs are valid**: strictly serializable, MV-permissive, reads return written
and kept versions, and garbage collection is final; both for the eager (`lazy = false`) and the
lazy (`lazy = true`) snapshot. -/
theorem snapSTM_valid :
    (snapSTM (Tx := Tx) (O := O) (P := P) lazy).Valid (snapKeptC lazy) :=
  ⟨snapSTM_correct lazy, snapSTM_mvPermissive lazy, snapSTM_readsWritten lazy,
    snapSTM_keepsReads lazy, snapSTM_gcFinal lazy⟩

end STMLevel

end Podc.MultiVersionSTM
