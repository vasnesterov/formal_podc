import Papers.PODC2010.MultiVersionSTM.Snapshot

/-!
# Lemmas about the snapshot STMs

Computation rules and index-level characterizations used in `SnapshotProofs.lean`:

* list helpers relating decompositions `h = h₁ ++ e :: h₂` and indices (`h[k]?`, `h.take k`);
* `latest`: `latest_nil`, `latest_snoc`, `latest_cases` (the last `CommitWrites` event),
  `latest_eq_latest_take` (no overwrite in between ⇒ same latest version);
* `frz`: `frz_eq_some_iff`, `frz_eq_none_iff`, stability under extension;
* `firstIdx` and `snap` basics;
* `Gen lazy h`: `h` is generated by the strategy `snapResp lazy`;
* index-level facts about well-formed histories, and `cidx h T`, the index of the commit of `T`.
-/

namespace Podc.MultiVersionSTM

open scoped Classical

variable {Tx O P : Type}

/-! ### List helpers -/

section ListHelpers

variable {α : Type} {l l₁ l₂ : List α} {a x : α} {k : ℕ}

lemma eq_take_append_cons (hk : l[k]? = some a) : l = l.take k ++ a :: l.drop (k + 1) := by
  obtain ⟨hlt, rfl⟩ := List.getElem?_eq_some_iff.1 hk
  conv_lhs => rw [← List.take_append_drop k l]
  rw [List.drop_eq_getElem_cons hlt]

lemma getElem?_of_decomp (h : l = l₁ ++ a :: l₂) : l[l₁.length]? = some a := by
  subst h; simp

lemma take_of_decomp (h : l = l₁ ++ a :: l₂) : l.take l₁.length = l₁ := by
  subst h; simp

lemma lt_length_of_getElem? (hk : l[k]? = some a) : k < l.length :=
  (List.getElem?_eq_some_iff.1 hk).1

lemma getElem?_snoc_cases (hk : (l ++ [x])[k]? = some a) :
    (k < l.length ∧ l[k]? = some a) ∨ (k = l.length ∧ a = x) := by
  rcases lt_trichotomy k l.length with hlt | rfl | hgt
  · left; exact ⟨hlt, by rwa [List.getElem?_append_left hlt] at hk⟩
  · right; simp at hk; exact ⟨rfl, hk.symm⟩
  · exfalso
    rw [List.getElem?_eq_none (by simp; omega)] at hk
    simp at hk

lemma take_snoc_length : (l ++ [x]).take l.length = l := by simp

lemma getElem?_take_eq_some (hk : (l.take k)[k']? = some a) : k' < k ∧ l[k']? = some a := by
  rw [List.getElem?_take] at hk
  split_ifs at hk with h
  · exact ⟨h, hk⟩

lemma take_succ_of_getElem? (hk : l[k]? = some a) : l.take (k + 1) = l.take k ++ [a] := by
  simp [List.take_add_one, hk]

lemma mem_take_iff_getElem? : a ∈ l.take k ↔ ∃ k' < k, l[k']? = some a := by
  rw [List.mem_iff_getElem?]
  constructor
  · rintro ⟨i, hi⟩; exact ⟨i, (getElem?_take_eq_some hi).1, (getElem?_take_eq_some hi).2⟩
  · rintro ⟨i, hi, he⟩; exact ⟨i, by rw [List.getElem?_take_of_lt hi]; exact he⟩

lemma mem_take_of_getElem? {k' : ℕ} (hk : l[k']? = some a) (hlt : k' < k) : a ∈ l.take k :=
  mem_take_iff_getElem?.2 ⟨k', hlt, hk⟩

lemma mem_of_mem_take (ha : a ∈ l.take k) : a ∈ l := List.mem_of_mem_take ha

end ListHelpers

/-! ### History predicates on prefixes -/

section Prefix

variable {h : Hist Tx O} {T : Tx} {o : O} {k : ℕ}

lemma Began.of_take (hb : Began (h.take k) T) : Began h T := by
  obtain ⟨e, he, h1⟩ := hb; exact ⟨e, mem_of_mem_take he, h1⟩

lemma Committed.of_take (hb : Committed (h.take k) T) : Committed h T := by
  obtain ⟨r, hr⟩ := hb; exact ⟨r, mem_of_mem_take hr⟩

lemma Writes.of_take (hb : Writes (h.take k) T o) : Writes h T o := by
  obtain ⟨r, hr⟩ := hb; exact ⟨r, mem_of_mem_take hr⟩

lemma ReadsObj.of_take (hb : ReadsObj (h.take k) T o) : ReadsObj h T o := by
  obtain ⟨r, hr⟩ := hb; exact ⟨r, mem_of_mem_take hr⟩

lemma began_iff_getElem? : Began h T ↔ ∃ k : ℕ, ∃ e : Event Tx O, h[k]? = some e ∧ e.inv.tx = T := by
  simp only [Began, List.mem_iff_getElem?]
  constructor
  · rintro ⟨e, ⟨i, hi⟩, he⟩; exact ⟨i, e, hi, he⟩
  · rintro ⟨i, e, hi, he⟩; exact ⟨e, ⟨i, hi⟩, he⟩

end Prefix

/-! ### `latest` -/

section Latest

variable {h : Hist Tx O} {o : O}

private lemma latest_fold_fst (h : Hist Tx O) (o : O) :
    (h.foldl (fun acc e => (acc.1 ++ [e], if CommitWrites acc.1 e o then some e.inv.tx else acc.2))
      (([] : Hist Tx O), (none : Option Tx))).1 = h := by
  induction h using List.reverseRecOn with
  | nil => rfl
  | append_singleton h e ih =>
    rw [List.foldl_append]
    simp only [List.foldl_cons, List.foldl_nil]
    rw [ih]

@[simp] lemma latest_nil (o : O) : latest ([] : Hist Tx O) o = none := rfl

lemma latest_snoc (h : Hist Tx O) (e : Event Tx O) (o : O) :
    latest (h ++ [e]) o = if CommitWrites h e o then some e.inv.tx else latest h o := by
  unfold latest
  rw [List.foldl_append]
  simp only [List.foldl_cons, List.foldl_nil]
  rw [latest_fold_fst]

lemma CommitWrites.inv_eq {h : Hist Tx O} {e : Event Tx O} (hc : CommitWrites h e o) :
    e.inv = .commit e.inv.tx := by
  obtain ⟨_, W, hW, _⟩ := hc; rw [hW]; rfl

lemma CommitWrites.writes {h : Hist Tx O} {e : Event Tx O} (hc : CommitWrites h e o) :
    Writes h e.inv.tx o := by
  obtain ⟨_, W, hW, hw⟩ := hc; rw [hW]; exact hw

lemma CommitWrites.eq {h : Hist Tx O} {e : Event Tx O} (hc : CommitWrites h e o) :
    ∃ r, e = ⟨.commit e.inv.tx, some r⟩ := by
  obtain ⟨⟨r, hr⟩, W, hW, _⟩ := hc
  refine ⟨r, ?_⟩
  cases e; simp_all

lemma not_commitWrites_of_inv {h : Hist Tx O} {e : Event Tx O}
    (he : ∀ T, e.inv ≠ .commit T) : ¬ CommitWrites h e o := by
  rintro ⟨_, W, hW, _⟩; exact he W hW

/-- `latest h o` is the transaction of the last event of `h` that is a successful commit of a
writer of `o` (or `none` if there is no such event). -/
lemma latest_cases (h : Hist Tx O) (o : O) :
    (latest h o = none ∧ ∀ k e, h[k]? = some e → ¬ CommitWrites (h.take k) e o) ∨
    ∃ k e, h[k]? = some e ∧ CommitWrites (h.take k) e o ∧ latest h o = some e.inv.tx ∧
      ∀ k' e', k < k' → h[k']? = some e' → ¬ CommitWrites (h.take k') e' o := by
  induction h using List.reverseRecOn with
  | nil => left; simp
  | append_singleton h x ih =>
    rw [latest_snoc]
    by_cases hc : CommitWrites h x o
    · right
      refine ⟨h.length, x, by simp, by rwa [take_snoc_length], by simp [hc], ?_⟩
      intro k' e' hk' he'
      have := lt_length_of_getElem? he'
      simp at this; omega
    · simp only [hc, ↓reduceIte]
      rcases ih with ⟨h0, hn⟩ | ⟨k, e, hk, hce, hl, hmax⟩
      · left
        refine ⟨h0, fun k e hke => ?_⟩
        rcases getElem?_snoc_cases hke with ⟨hlt, hke'⟩ | ⟨rfl, rfl⟩
        · rw [List.take_append_of_le_length hlt.le]; exact hn k e hke'
        · rwa [take_snoc_length]
      · right
        have hlt := lt_length_of_getElem? hk
        refine ⟨k, e, by rwa [List.getElem?_append_left hlt],
          by rwa [List.take_append_of_le_length hlt.le], hl, ?_⟩
        intro k' e' hk' he'
        rcases getElem?_snoc_cases he' with ⟨hlt', he''⟩ | ⟨rfl, rfl⟩
        · rw [List.take_append_of_le_length hlt'.le]; exact hmax k' e' hk' he''
        · rwa [take_snoc_length]

lemma latest_eq_none_iff : latest h o = none ↔ ∀ k e, h[k]? = some e → ¬ CommitWrites (h.take k) e o := by
  rcases latest_cases h o with ⟨h0, hn⟩ | ⟨k, e, hk, hce, hl, _⟩
  · exact ⟨fun _ => hn, fun _ => h0⟩
  · rw [hl]; simp only [reduceCtorEq, false_iff, not_forall, not_not]
    exact ⟨k, e, hk, hce⟩

lemma latest_eq_some {W : Tx} (hl : latest h o = some W) :
    ∃ k e, h[k]? = some e ∧ CommitWrites (h.take k) e o ∧ e.inv.tx = W ∧
      ∀ k' e', k < k' → h[k']? = some e' → ¬ CommitWrites (h.take k') e' o := by
  rcases latest_cases h o with ⟨h0, _⟩ | ⟨k, e, hk, hce, hl', hmax⟩
  · rw [h0] at hl; exact absurd hl (by simp)
  · rw [hl] at hl'
    exact ⟨k, e, hk, hce, (Option.some.inj hl').symm, hmax⟩

/-- The latest version of `o` was written by a transaction that wrote `o`. -/
lemma writes_of_latest {W : Tx} (hl : latest h o = some W) : Writes h W o := by
  obtain ⟨k, e, _, hce, rfl, _⟩ := latest_eq_some hl
  exact hce.writes.of_take

/-- If no event of `h` from index `j` on is a commit writing `o`, then the latest version of `o`
is the one after the prefix of length `j`. -/
lemma latest_eq_latest_take {j : ℕ}
    (hno : ∀ k e, j ≤ k → h[k]? = some e → ¬ CommitWrites (h.take k) e o) :
    latest h o = latest (h.take j) o := by
  induction h using List.reverseRecOn with
  | nil => simp
  | append_singleton h x ih =>
    by_cases hj : j ≤ h.length
    · rw [latest_snoc, List.take_append_of_le_length hj]
      have hx : ¬ CommitWrites h x o := by
        have := hno h.length x hj (by simp)
        rwa [take_snoc_length] at this
      simp only [hx, ↓reduceIte]
      apply ih
      intro k e hk he
      have hlt := lt_length_of_getElem? he
      have := hno k e hk (by rwa [List.getElem?_append_left hlt])
      rwa [List.take_append_of_le_length hlt.le] at this
    · rw [List.take_of_length_le (by simp; omega)]

lemma latest_take_succ {e : Event Tx O} {k : ℕ} (hk : h[k]? = some e) :
    latest (h.take (k + 1)) o =
      if CommitWrites (h.take k) e o then some e.inv.tx else latest (h.take k) o := by
  rw [take_succ_of_getElem? hk, latest_snoc]

end Latest

/-! ### `frz`, `firstIdx`, `snap` -/

section Snap

variable {h : Hist Tx O} {T : Tx} {k m : ℕ}

lemma frz_eq_some_iff : frz h T = some k ↔ k < h.length ∧ Freezes h T k ∧ ∀ j < k, ¬ Freezes h T j := by
  unfold frz
  rw [List.find?_range_eq_some]
  simp only [decide_eq_true_eq, List.mem_range, Bool.not_eq_eq_eq_not, Bool.not_true,
    decide_eq_false_iff_not]
  tauto

lemma frz_eq_none_iff : frz h T = none ↔ ∀ k < h.length, ¬ Freezes h T k := by
  unfold frz
  rw [List.find?_eq_none]
  simp

lemma Freezes.lt_length (hf : Freezes h T k) : k < h.length := by
  obtain ⟨e, he, _⟩ := hf; exact lt_length_of_getElem? he

lemma freezes_take_iff (hk : k < m) : Freezes (h.take m) T k ↔ Freezes h T k := by
  unfold Freezes
  rw [List.getElem?_take_of_lt hk, List.take_take, min_eq_left hk.le]

lemma frz_lt_length {k : ℕ} (hf : frz h T = some k) : k < h.length := (frz_eq_some_iff.1 hf).1

/-- A frozen snapshot index stays frozen when the history is extended. -/
lemma frz_of_frz_take (hf : frz (h.take m) T = some k) : frz h T = some k := by
  obtain ⟨hk, hfk, hmin⟩ := frz_eq_some_iff.1 hf
  have hkm : k < m := lt_of_lt_of_le hk (by simp)
  have hkh : k < h.length := lt_of_lt_of_le hk (by simp)
  refine frz_eq_some_iff.2 ⟨hkh, (freezes_take_iff hkm).1 hfk, fun j hj => ?_⟩
  rw [← freezes_take_iff (hj.trans hkm)]
  exact hmin j hj

lemma le_of_frz_take_none (hf : frz (h.take m) T = none) (hf' : frz h T = some k) : m ≤ k := by
  by_contra! hlt
  obtain ⟨hk, hfk, -⟩ := frz_eq_some_iff.1 hf'
  exact (frz_eq_none_iff.1 hf) k (by simp; omega) ((freezes_take_iff hlt).2 hfk)

lemma frz_take_some_of_freezes {j : ℕ} (hj : j < m) (hfj : Freezes h T j) :
    ∃ k, frz (h.take m) T = some k ∧ k ≤ j := by
  have hfj' : Freezes (h.take m) T j := (freezes_take_iff hj).2 hfj
  cases hf : frz (h.take m) T with
  | none => exact absurd hfj' ((frz_eq_none_iff.1 hf) j hfj'.lt_length)
  | some k =>
    refine ⟨k, rfl, ?_⟩
    by_contra! hlt
    exact (frz_eq_some_iff.1 hf).2.2 j hlt hfj'

lemma firstIdx_le_length : firstIdx h T ≤ h.length := List.findIdx_le_length

lemma firstIdx_take : firstIdx (h.take m) T = min m (firstIdx h T) := List.findIdx_take

lemma firstIdx_le {e : Event Tx O} (hk : h[k]? = some e) (he : e.inv.tx = T) : firstIdx h T ≤ k := by
  by_contra! hlt
  have := List.not_of_lt_findIdx hlt
  obtain ⟨hk', rfl⟩ := List.getElem?_eq_some_iff.1 hk
  simp [he] at this

lemma firstIdx_lt_length_iff : firstIdx h T < h.length ↔ Began h T := by
  unfold firstIdx; rw [List.findIdx_lt_length]; simp [Began]

lemma firstIdx_getElem? (hb : Began h T) : ∃ e, h[firstIdx h T]? = some e ∧ e.inv.tx = T := by
  have hlt := firstIdx_lt_length_iff.2 hb
  refine ⟨h[firstIdx h T], List.getElem?_eq_getElem hlt, ?_⟩
  have := List.findIdx_getElem (w := hlt)
  simp only [firstIdx]; exact of_decide_eq_true (by convert this)

/-- `firstIdx` is injective on the transactions that have begun. -/
lemma firstIdx_inj {A B : Tx} (hA : Began h A) (hB : Began h B)
    (heq : firstIdx h A = firstIdx h B) : A = B := by
  obtain ⟨e, he, heA⟩ := firstIdx_getElem? hA
  obtain ⟨e', he', heB⟩ := firstIdx_getElem? hB
  rw [heq, he'] at he
  obtain rfl := Option.some.inj he
  rw [← heA, ← heB]

lemma firstIdx_eq_length (hb : ¬ Began h T) : firstIdx h T = h.length := by
  refine le_antisymm firstIdx_le_length ?_
  by_contra! hlt
  exact hb (firstIdx_lt_length_iff.1 hlt)

lemma snap_le_length (lazy : Bool) : snap lazy h T ≤ h.length := by
  unfold snap
  split_ifs
  · cases hf : frz h T with
    | none => simp
    | some k => simpa using (frz_lt_length hf).le
  · exact firstIdx_le_length

/-- One step changes the snapshot of `T` only from the current length to the new length. -/
lemma snap_snoc (lazy : Bool) (e : Event Tx O) :
    snap lazy (h ++ [e]) T = snap lazy h T ∨ snap lazy (h ++ [e]) T = h.length + 1 := by
  unfold snap
  split_ifs
  · cases hf : frz h T with
    | some k =>
      left
      have : frz ((h ++ [e]).take h.length) T = some k := by rwa [take_snoc_length]
      rw [frz_of_frz_take this]; rfl
    | none =>
      cases hf' : frz (h ++ [e]) T with
      | none => right; simp
      | some k =>
        left
        have h1 := le_of_frz_take_none (h := h ++ [e]) (by rwa [take_snoc_length]) hf'
        have h2 := frz_lt_length hf'
        simp at h2 ⊢; omega
  · have := firstIdx_take (h := h ++ [e]) (T := T) (m := h.length)
    rw [take_snoc_length] at this
    have h3 := firstIdx_le_length (h := h ++ [e]) (T := T)
    simp at h3
    omega

end Snap

/-! ### Histories generated by the snapshot strategy -/

section Gen

variable [TxSys Tx P]

/-- `h` is generated by the strategy `snapResp lazy`: every response is computed from the
history before it. -/
def Gen (lazy : Bool) (h : Hist Tx O) : Prop :=
  ∀ h₁ e h₂, h = h₁ ++ e :: h₂ → e.resp = snapResp lazy h₁ e.inv

variable {lazy : Bool} {h : Hist Tx O}

lemma Gen.nil : Gen lazy ([] : Hist Tx O) := by
  intro h₁ e h₂ he; simp at he

lemma Gen.snoc (hg : Gen lazy h) (i : Inv Tx O) : Gen lazy (h ++ [⟨i, snapResp lazy h i⟩]) := by
  intro a e' b hab
  rcases List.eq_nil_or_concat b with rfl | ⟨b', x, rfl⟩
  · obtain ⟨rfl, rfl⟩ : h = a ∧ (⟨i, snapResp lazy h i⟩ : Event Tx O) = e' := by simpa using hab
    rfl
  · have : h = a ++ e' :: b' := by
      have := hab; simp only [List.concat_eq_append] at this
      rw [show a ++ e' :: (b' ++ [x]) = (a ++ e' :: b') ++ [x] by simp] at this
      exact (List.append_inj' this rfl).1
    exact hg a e' b' this

lemma Gen.at (hg : Gen lazy h) {k : ℕ} {e : Event Tx O} (hk : h[k]? = some e) :
    e.resp = snapResp lazy (h.take k) e.inv :=
  hg _ e _ (eq_take_append_cons hk)

lemma Gen.of_append {h' : Hist Tx O} (hg : Gen lazy (h ++ h')) : Gen lazy h := by
  intro a e b hab
  exact hg a e (b ++ h') (by simp [hab])

/-- The histories of the snapshot STM are generated by its strategy. -/
lemma gen_hist (lazy : Bool) (σ : List (Inv Tx O)) :
    Gen lazy ((snapSTM (Tx := Tx) (O := O) (P := P) lazy).hist σ) := by
  induction σ using List.reverseRecOn with
  | nil => exact Gen.nil
  | append_singleton σ i ih =>
    rw [snapSTM, ofStrategy.hist_snoc]
    exact Gen.snoc ih i

end Gen

/-! ### Well-formed histories, by index; the commit index `cidx` -/

section WFIdx

variable {h : Hist Tx O} {T W : Tx} {o : O} {k : ℕ} {e : Event Tx O}

lemma committed_iff_getElem? :
    Committed h T ↔ ∃ (k : ℕ) (r : Option Tx), h[k]? = some ⟨.commit T, some r⟩ := by
  simp only [Committed, List.mem_iff_getElem?]
  constructor
  · rintro ⟨r, i, hi⟩; exact ⟨i, r, hi⟩
  · rintro ⟨i, r, hi⟩; exact ⟨r, i, hi⟩

/-- The index of the first successful commit of `T` in `h` (`h.length` if there is none). -/
noncomputable def cidx (h : Hist Tx O) (T : Tx) : ℕ :=
  h.findIdx (fun e => decide (∃ r, e = ⟨.commit T, some r⟩))

lemma cidx_le_length : cidx h T ≤ h.length := List.findIdx_le_length

lemma cidx_le_of {r : Option Tx} (hk : h[k]? = some ⟨.commit T, some r⟩) : cidx h T ≤ k := by
  by_contra! hlt
  have := List.not_of_lt_findIdx hlt
  obtain ⟨hk', he⟩ := List.getElem?_eq_some_iff.1 hk
  simp only [decide_eq_false_iff_not, not_exists] at this
  exact this r he

lemma cidx_lt (hc : Committed h T) : cidx h T < h.length := by
  obtain ⟨k, r, hk⟩ := committed_iff_getElem?.1 hc
  exact lt_of_le_of_lt (cidx_le_of hk) (lt_length_of_getElem? hk)

lemma cidx_spec (hc : Committed h T) : ∃ r, h[cidx h T]? = some ⟨.commit T, some r⟩ := by
  have hlt := cidx_lt hc
  have := List.findIdx_getElem (w := hlt)
  have h2 : ∃ r, h[cidx h T] = ⟨.commit T, some r⟩ := by
    simp only [cidx]; exact of_decide_eq_true (by convert this)
  obtain ⟨r, hr⟩ := h2
  exact ⟨r, by rw [List.getElem?_eq_getElem hlt, hr]⟩

lemma committed_of_cidx_lt (hlt : cidx h T < h.length) : Committed h T := by
  have := List.findIdx_getElem (w := hlt)
  have h2 : ∃ r, h[cidx h T] = ⟨.commit T, some r⟩ := by
    simp only [cidx]; exact of_decide_eq_true (by convert this)
  obtain ⟨r, hr⟩ := h2
  exact committed_iff_getElem?.2 ⟨cidx h T, r, by rw [List.getElem?_eq_getElem hlt, hr]⟩

lemma cidx_eq_length (hc : ¬ Committed h T) : cidx h T = h.length := by
  refine le_antisymm cidx_le_length ?_
  by_contra! hlt
  exact hc (committed_of_cidx_lt hlt)

/-- The first event of `T` is not after its commit (`cidx h T = h.length` if `T` did not
commit). -/
lemma firstIdx_le_cidx : firstIdx h T ≤ cidx h T := by
  by_cases hc : Committed h T
  · obtain ⟨r, hr⟩ := cidx_spec hc
    exact firstIdx_le hr rfl
  · rw [cidx_eq_length hc]; exact firstIdx_le_length

lemma cidx_inj {A B : Tx} (hA : Committed h A) (hB : Committed h B) (heq : cidx h A = cidx h B) :
    A = B := by
  obtain ⟨r, hr⟩ := cidx_spec hA
  obtain ⟨r', hr'⟩ := cidx_spec hB
  rw [heq, hr'] at hr
  simp only [Option.some.injEq, Event.mk.injEq, Inv.commit.injEq] at hr
  exact hr.1.symm

variable [TxSys Tx P]

lemma WF.ok_at (hw : WF h) (hk : h[k]? = some e) : OKNext (h.take k) e.inv :=
  hw _ e _ (eq_take_append_cons hk)

lemma WF.not_terminated_at (hw : WF h) (hk : h[k]? = some e) :
    ¬ Terminated (h.take k) e.inv.tx :=
  (hw.ok_at hk).1

lemma WF.ro_of_writes (hw : WF h) (hwr : Writes h T o) : ro T = false := by
  obtain ⟨r, hr⟩ := hwr
  obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hr
  exact (hw.ok_at hk).2.1 T o rfl

/-- No event of `T` follows a successful commit of `T`. -/
lemma WF.le_of_commit_at (hw : WF h) {c : ℕ} {r : Option Tx}
    (hc : h[c]? = some ⟨.commit T, some r⟩) (hk : h[k]? = some e) (he : e.inv.tx = T) :
    k ≤ c := by
  by_contra! hlt
  apply hw.not_terminated_at hk
  rw [he]
  exact Or.inl ⟨r, mem_take_of_getElem? hc hlt⟩

lemma WF.cidx_eq (hw : WF h) {r : Option Tx} (hk : h[k]? = some ⟨.commit T, some r⟩) :
    cidx h T = k := by
  have hc : Committed h T := committed_iff_getElem?.2 ⟨k, r, hk⟩
  obtain ⟨r', hr'⟩ := cidx_spec hc
  exact le_antisymm (cidx_le_of hk) (hw.le_of_commit_at hr' hk rfl)

lemma WF.le_cidx (hw : WF h) (hc : Committed h T) (hk : h[k]? = some e) (he : e.inv.tx = T) :
    k ≤ cidx h T := by
  obtain ⟨r, hr⟩ := cidx_spec hc
  exact hw.le_of_commit_at hr hk he

lemma WF.lt_cidx (hw : WF h) (hc : Committed h T) (hk : h[k]? = some e) (he : e.inv.tx = T)
    (hne : ∀ T', e.inv ≠ .commit T') : k < cidx h T := by
  rcases (hw.le_cidx hc hk he).lt_or_eq with hlt | heq
  · exact hlt
  · obtain ⟨r, hr⟩ := cidx_spec hc
    rw [heq, hr] at hk
    simp only [Option.some.injEq] at hk
    exact absurd (by rw [← hk]) (hne T)

lemma WF.writes_take_cidx (hw : WF h) (hc : Committed h T) (hwr : Writes h T o) :
    Writes (h.take (cidx h T)) T o := by
  obtain ⟨r, hr⟩ := hwr
  obtain ⟨k, hk⟩ := List.mem_iff_getElem?.1 hr
  exact ⟨r, mem_take_of_getElem? hk (hw.lt_cidx hc hk rfl (fun _ => by simp))⟩

lemma WF.cw_of_cwriter (hw : WF h) (hcw : CWriter h o W) :
    ∃ e, h[cidx h W]? = some e ∧ CommitWrites (h.take (cidx h W)) e o ∧ e.inv.tx = W := by
  obtain ⟨r, hr⟩ := cidx_spec hcw.1
  exact ⟨_, hr, ⟨⟨r, rfl⟩, W, rfl, hw.writes_take_cidx hcw.1 hcw.2⟩, rfl⟩

lemma WF.cwriter_of_cw (hw : WF h) (hk : h[k]? = some e) (hce : CommitWrites (h.take k) e o) :
    CWriter h o e.inv.tx ∧ cidx h e.inv.tx = k := by
  obtain ⟨r, hr⟩ := hce.eq
  rw [hr] at hk
  exact ⟨⟨committed_iff_getElem?.2 ⟨k, r, hk⟩, hce.writes.of_take⟩, hw.cidx_eq hk⟩

lemma WF.ro_of_cwriter (hw : WF h) (hcw : CWriter h o W) : ro W = false :=
  hw.ro_of_writes hcw.2

/-- No version of `o` is installed before index `s`: all committed writers of `o` commit at or
after `s`. -/
lemma WF.le_cidx_of_latest_none (hw : WF h) {s : ℕ} (hl : latest (h.take s) o = none)
    (hcw : CWriter h o W) : s ≤ cidx h W := by
  by_contra! hlt
  obtain ⟨e, he, hce, -⟩ := hw.cw_of_cwriter hcw
  refine latest_eq_none_iff.1 hl (cidx h W) e ?_ ?_
  · rwa [List.getElem?_take_of_lt hlt]
  · rwa [List.take_take, min_eq_left hlt.le]

/-- The latest version of `o` before index `s` is that of the committed writer of `o` with the
largest commit index below `s`. -/
lemma WF.of_latest_some (hw : WF h) {s : ℕ} (hl : latest (h.take s) o = some W) :
    CWriter h o W ∧ cidx h W < s ∧
      ∀ W', CWriter h o W' → cidx h W' < s → cidx h W' ≤ cidx h W := by
  obtain ⟨k, e, hk, hce, rfl, hmax⟩ := latest_eq_some hl
  obtain ⟨hks, hk'⟩ := getElem?_take_eq_some hk
  rw [List.take_take, min_eq_left hks.le] at hce
  obtain ⟨hcw, hck⟩ := hw.cwriter_of_cw hk' hce
  refine ⟨hcw, hck ▸ hks, fun W' hcw' hlt => ?_⟩
  rw [hck]
  by_contra! hgt
  obtain ⟨e', he', hce', -⟩ := hw.cw_of_cwriter hcw'
  refine hmax (cidx h W') e' hgt ?_ ?_
  · rwa [List.getElem?_take_of_lt hlt]
  · rwa [List.take_take, min_eq_left hlt.le]

end WFIdx

end Podc.MultiVersionSTM
