import Papers.PODC2020.RoundBasedKSetTopology.Basic

/-!
# One-round upper bounds (Section 3)

* Theorem 3.2: `γ(G)`-set agreement in one round on `↑G` (`theorem_3_2`).
* Theorem 3.4 / Corollary 3.5: `γ^eq(S)`-set agreement in one round on `↑S` and on `↑Sym(S)`.
* Theorem 3.7 / Corollary 3.8: `(i + (n - cov_i(S)))`-set agreement in one round.

All algorithms are oblivious: decide the minimum received value (from a fixed dominating set for
Theorem 3.2). The bounds of Theorem 3.7 / Corollary 3.8 hold for every `i ≤ n`, not only for
`i ∈ [1, γ^eq(S)[`.

We also check the examples after Corollary 3.8: the covering numbers of a star are `cov_i = i`
(the paper says `1`, `star_cov_eq`), and for the second graph of Figure 1, `cov_2 = 3` and
`γ^eq = 4` (`figure1_cov_two`, `figure1_eqDomNum`).
-/

namespace Podc.RoundBasedKSetTopology

open Cslib.HeardOf Finset

variable {α V : Type*} [Fintype α]

omit [Fintype α] in
/-- `k`-set agreement is monotone in `k`. -/
theorem OneRoundSolvable.mono {k k' : ℕ} {M : Set (Graph α)} (h : OneRoundSolvable V k M)
    (hk : k ≤ k') : OneRoundSolvable V k' M := by
  obtain ⟨δ, hδ⟩ := h
  exact ⟨δ, fun G hG x => ⟨(hδ G hG x).1, (hδ G hG x).2.trans hk⟩⟩

omit [Fintype α] in
/-- Solvability is antitone in the model. -/
theorem OneRoundSolvable.anti {k : ℕ} {M M' : Set (Graph α)} (h : OneRoundSolvable V k M)
    (hM : M' ⊆ M) : OneRoundSolvable V k M' := by
  obtain ⟨δ, hδ⟩ := h
  exact ⟨δ, fun G hG x => hδ G (hM hG) x⟩

variable [LinearOrder V] [Nonempty V]

/-- **Theorem 3.2.** `γ(G)`-set agreement is solvable in one round on the simple closed-above
model generated by `G`: decide the minimum value received from a fixed minimum dominating set. -/
theorem theorem_3_2 (G : Graph α) : OneRoundSolvable V (domNum G) (closedAbove {G}) := by
  classical
  obtain ⟨D, hD, hcard⟩ := exists_dominating_card_domNum G
  refine ⟨minFrom D, ?_⟩
  rintro H ⟨G', hG', hGH⟩ x
  rw [Set.mem_singleton_iff] at hG'
  rw [hG'] at hGH
  have hspec := fun p => minFrom_spec (D := D) (G := H) (x := x) (p := p) ((hD.mono_graph hGH) p)
  refine ⟨fun p => ?_, ?_⟩
  · obtain ⟨⟨q, -, -, h⟩, -⟩ := hspec p
    exact ⟨q, h⟩
  · have hsub : Set.range (fun p => minFrom D p (msgs H x p)) ⊆ ↑(D.image x) := by
      rintro _ ⟨p, rfl⟩
      obtain ⟨⟨q, hq, -, h⟩, -⟩ := hspec p
      show minFrom D p (msgs H x p) ∈ _
      rw [h]; exact mem_coe.2 (mem_image_of_mem x hq)
    calc _ ≤ (↑(D.image x) : Set V).ncard := Set.ncard_le_ncard hsub (Finset.finite_toSet _)
      _ = (D.image x).card := Set.ncard_coe_finset _
      _ ≤ D.card := card_image_le
      _ = domNum G := hcard

/-- The common engine of Theorems 3.4 and 3.7: if every set of `i` processes is heard by at
least `c` processes in every graph of the model, deciding the minimum received value solves
`(i + (n - c))`-set agreement in one round. -/
theorem solvable_of_card_out {M : Set (Graph α)} {i c : ℕ} (hi : i ≤ Fintype.card α)
    (hc : ∀ H ∈ M, ∀ P : Finset α, P.card = i → c ≤ (out H P).card) :
    OneRoundSolvable V (i + (Fintype.card α - c)) M := by
  refine ⟨minFrom univ, fun H hH x => ⟨minFrom_univ_valid H x, ?_⟩⟩
  obtain ⟨P, hP, hlow⟩ := exists_lowerSet x hi
  refine (ncard_range_minFrom_le H x hlow).trans ?_
  have := hc H hH P hP
  omega

/-- Lower bound on `|Out_H(P)|` for `H` above a generator. -/
theorem le_card_out_of_le {G H : Graph α} (hGH : G ≤ H) {c : ℕ} {P : Finset α}
    (h : c ≤ (out G P).card) : c ≤ (out H P).card :=
  h.trans (card_le_card (out_mono_graph hGH P))

/-- **Theorem 3.4.** `γ^eq(S)`-set agreement is solvable (in one round) on the closed-above model
generated by `S`. -/
theorem theorem_3_4 (S : Set (Graph α)) : OneRoundSolvable V (eqDomNumSet S) (closedAbove S) := by
  have h := solvable_of_card_out (V := V) (M := closedAbove S) (eqDomNumSet_le_card S)
    (c := Fintype.card α) (by
      rintro H ⟨G, hG, hGH⟩ P hP
      have hd := dominates_iff_out.1 ((dominates_of_eqDomNumSet_le hG hP.ge).mono_graph hGH)
      rw [hd, card_univ])
  simpa using h

/-- **Theorem 3.7.** For `i ∈ [1, γ^eq(S)[`, `(i + (n - cov_i(S)))`-set agreement is solvable
(in one round) on the closed-above model generated by `S`. -/
theorem theorem_3_7 (S : Set (Graph α)) {i : ℕ} (hi : i ∈ Set.Ico 1 (eqDomNumSet S)) :
    OneRoundSolvable V (i + (Fintype.card α - covSet i S)) (closedAbove S) :=
  solvable_of_card_out (hi.2.le.trans (eqDomNumSet_le_card S)) (by
    rintro H ⟨G, hG, hGH⟩ P hP
    exact le_card_out_of_le hGH ((covSet_le_cov hG).trans (cov_le_card_out G hP)))

/-- Theorem 3.7 holds for every `i ≤ n`. -/
theorem theorem_3_7_general (S : Set (Graph α)) {i : ℕ} (hi : i ≤ Fintype.card α) :
    OneRoundSolvable V (i + (Fintype.card α - covSet i S)) (closedAbove S) :=
  solvable_of_card_out hi (by
    rintro H ⟨G, hG, hGH⟩ P hP
    exact le_card_out_of_le hGH ((covSet_le_cov hG).trans (cov_le_card_out G hP)))

/-! ### Symmetric models -/

omit [LinearOrder V] [Nonempty V] in
/-- `γ^eq` is invariant under relabeling. -/
theorem eqDomNum_relabel (π : Equiv.Perm α) (G : Graph α) : eqDomNum (relabel π G) = eqDomNum G := by
  unfold eqDomNum
  congr 1
  ext i
  simp only [Set.mem_ofPred_eq]
  refine and_congr_right fun _ => and_congr_right fun _ => ⟨fun h P hP => ?_, fun h P hP => ?_⟩
  · have := (dominates_relabel_iff π G (P.map π.toEmbedding)).1 (h _ (by rw [card_map, hP]))
    simpa [map_map] using this
  · exact (dominates_relabel_iff π G P).2 (h _ (by rw [card_map, hP]))

omit [LinearOrder V] [Nonempty V] in
/-- `cov_i` is invariant under relabeling. -/
theorem cov_relabel (i : ℕ) (π : Equiv.Perm α) (G : Graph α) : cov i (relabel π G) = cov i G := by
  unfold cov
  congr 1
  ext c
  simp only [Set.mem_ofPred_eq]
  constructor
  · rintro ⟨P, hP, rfl⟩
    exact ⟨P.map π.symm.toEmbedding, by rw [card_map, hP], (card_out_relabel π G P).symm⟩
  · rintro ⟨P, hP, rfl⟩
    refine ⟨P.map π.toEmbedding, by rw [card_map, hP], ?_⟩
    rw [card_out_relabel, map_map]; simp

omit [LinearOrder V] [Nonempty V] in
theorem eqDomNumSet_sym (S : Set (Graph α)) : eqDomNumSet (Sym S) = eqDomNumSet S := by
  unfold eqDomNumSet
  congr 1
  ext m
  constructor
  · rintro ⟨_, ⟨G, hG, π, rfl⟩, rfl⟩
    exact ⟨G, hG, (eqDomNum_relabel π G).symm⟩
  · rintro ⟨G, hG, rfl⟩
    exact ⟨G, ⟨G, hG, 1, rfl⟩, rfl⟩

omit [LinearOrder V] [Nonempty V] in
theorem covSet_sym (i : ℕ) (S : Set (Graph α)) : covSet i (Sym S) = covSet i S := by
  unfold covSet
  congr 1
  ext m
  constructor
  · rintro ⟨_, ⟨G, hG, π, rfl⟩, rfl⟩
    exact ⟨G, hG, (cov_relabel i π G).symm⟩
  · rintro ⟨G, hG, rfl⟩
    exact ⟨G, ⟨G, hG, 1, rfl⟩, rfl⟩

/-- **Corollary 3.5.** `γ^eq(S)`-set agreement is solvable on the closed-above model generated by
`Sym(S)`. -/
theorem corollary_3_5 (S : Set (Graph α)) :
    OneRoundSolvable V (eqDomNumSet S) (closedAbove (Sym S)) :=
  eqDomNumSet_sym S ▸ theorem_3_4 (Sym S)

/-- **Corollary 3.8.** For `i ∈ [1, γ^eq(S)[`, `(i + (n - cov_i(S)))`-set agreement is solvable on
the closed-above model generated by `Sym(S)`. -/
theorem corollary_3_8 (S : Set (Graph α)) {i : ℕ} (hi : i ∈ Set.Ico 1 (eqDomNumSet S)) :
    OneRoundSolvable V (i + (Fintype.card α - covSet i S)) (closedAbove (Sym S)) := by
  rw [← covSet_sym]
  exact theorem_3_7 (Sym S) (by rwa [eqDomNumSet_sym])

/-! ### The examples of Section 3.2 -/

omit [Fintype α] [LinearOrder V] [Nonempty V] in
theorem hears_starGraph {C : Set α} {q p : α} : Hears (starGraph C) q p ↔ p = q ∨ p ∈ C := Iff.rfl

omit [Fintype α] [LinearOrder V] [Nonempty V] in
/-- If a process `d` hears only itself, every dominating set contains `d`. -/
theorem mem_of_dominates_of_deaf {G : Graph α} {d : α} (hd : Deaf G d) {P : Finset α}
    (hP : Dominates G P) : d ∈ P := by
  obtain ⟨p, hp, h⟩ := hP d
  rwa [hd.eq h] at hp

omit [LinearOrder V] [Nonempty V] in
/-- If some process hears only itself, `γ^eq(G) = n`. -/
theorem eqDomNum_eq_card_of_deaf {G : Graph α} {d : α} (hd : Deaf G d) :
    eqDomNum G = Fintype.card α := by
  classical
  apply le_antisymm (eqDomNum_le_card G)
  have hne : Set.Nonempty
      {i | 1 ≤ i ∧ i ≤ Fintype.card α ∧ ∀ P : Finset α, P.card = i → Dominates G P} :=
    ⟨Fintype.card α, Fintype.card_pos_iff.2 ⟨d⟩, le_rfl, fun P hP =>
      (eq_univ_of_card P hP) ▸ dominates_univ G⟩
  obtain ⟨h1, -, hall⟩ := Nat.sInf_mem hne
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨P, hPs, hP⟩ := exists_subset_card_eq (s := univ.erase d) (n := eqDomNum G)
    (by rw [card_erase_of_mem (mem_univ d), card_univ]; omega)
  exact (notMem_erase d univ) (hPs (mem_of_dominates_of_deaf hd (hall P hP)))

omit [Fintype α] [LinearOrder V] [Nonempty V] in
theorem deaf_starGraph (c : α) : Deaf (starGraph {c}) c := fun _ h => h

omit [LinearOrder V] [Nonempty V] in
/-- The covering numbers of a star are `cov_i(star) = i` for `i < n` (Section 3.2 claims they
are all equal to `1`, which is false for `i ≥ 2`). -/
theorem star_cov_eq (c : α) {i : ℕ} (hi : i < Fintype.card α) : cov i (starGraph {c}) = i := by
  classical
  apply le_antisymm
  · obtain ⟨P, hPs, hP⟩ := exists_subset_card_eq (s := univ.erase c) (n := i)
      (by rw [card_erase_of_mem (mem_univ c), card_univ]; omega)
    have : out (starGraph {c}) P = P := by
      apply Subset.antisymm _ (subset_out _ _)
      intro q hq
      obtain ⟨p, hp, h⟩ := mem_out.1 hq
      rcases h with rfl | h
      · exact hp
      · exact absurd (hPs hp) (by rw [Set.mem_singleton_iff.1 h]; exact notMem_erase c univ)
    exact (cov_le_card_out _ hP).trans (by rw [this, hP])
  · obtain ⟨P, hP, hcov⟩ := exists_card_out_eq_cov (starGraph {c}) hi.le
    rw [← hcov, ← hP]
    exact card_le_card (subset_out _ _)

omit [LinearOrder V] [Nonempty V] in
/-- For the symmetric model generated by a star (`n ≥ 2`), `γ^eq = n` and
`n - cov_i = n - i ≥ γ^eq - i`: the covering bound never beats the `γ^eq` bound (the conclusion of
Section 3.2 holds even though its computation `cov_i = 1` is wrong). -/
theorem star_example (c : α) :
    eqDomNumSet (Sym {starGraph {c}}) = Fintype.card α ∧
      ∀ i, 1 ≤ i → i < Fintype.card α →
        covSet i (Sym {starGraph {c}}) = i ∧
        eqDomNumSet (Sym {starGraph {c}}) - i ≤ Fintype.card α - covSet i (Sym {starGraph {c}}) := by
  have h1 : eqDomNumSet (Sym {starGraph {c}}) = Fintype.card α := by
    rw [eqDomNumSet_sym]; simp [eqDomNumSet, eqDomNum_eq_card_of_deaf (deaf_starGraph c)]
  refine ⟨h1, fun i _ hi => ?_⟩
  have h2 : covSet i (Sym {starGraph {c}}) = i := by
    rw [covSet_sym]; simp [covSet, star_cov_eq c hi]
  exact ⟨h2, by rw [h1, h2]⟩

end Podc.RoundBasedKSetTopology
