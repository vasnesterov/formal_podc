import Papers.PODC2020.RoundBasedKSetTopology.LowerBoundSimple

/-!
# Theorem 5.4 is false

Theorem 5.4 (lower bound for general closed-above models): with
`l = min(γ^dist(S) - 2, min{t + M_t(S) - 2 | t ∈ [1, γ^dist(S) - 1]})`, `(l+1)`-set agreement is
not solvable on the closed-above model generated by `S` in one round.

**Counterexample.** `S = {G}` with `G` the star with center `c` (`c` sends to everybody),
`n ≥ 2`. For a single graph, `γ^dist({G}) = γ^eq(G) = n` (a set of processes dominates the star
iff it contains `c`), and every non-dominating set `P` of size `t` has `Out_G(P) = P`, so
`max-cov_t = t`, `M_t = n - t` and `l = n - 2` (`thm54L_star`). Theorem 5.4 then claims that
`(n-1)`-set agreement is impossible, but consensus is solvable: everybody hears `c` and decides
its input (Theorem 3.2 with `γ(G) = 1`). The failing step of the proof (Appendix B of the full
version) treats an intersection `⋂ α(φᵢ)` that is *empty* (the inputs differ at a process
heard by everybody) as if it were highly connected.

The counterexample works for every graph `G` with the star's hearing relation
(`IsStarAt G c`), which we reuse for Theorem 6.11 (products of stars are stars).

We also refute the computation `γ^dist(S) = n - s + 1` claimed for the symmetric model of all
(unions of `s`) stars, for `s = 1`, `n ≥ 3`: `γ^dist(S) ≤ n - 1` (`distDomNum_stars_le`),
because `n - 1` distinct stars cannot all have their center outside a set of `n - 1` processes.
-/

namespace Podc.RoundBasedKSetTopology

open Cslib.HeardOf Finset

variable {α V : Type*} [Fintype α]

/-- The statement of Theorem 5.4 for the generators `S` (inputs in `V`). -/
def Theorem54Statement (V : Type*) (S : Set (Graph α)) : Prop :=
  ∀ k : ℕ, (k : ℤ) = thm54L S + 1 → ¬ OneRoundSolvable V k (closedAbove S)

/-- `G` has the hearing relation of the star with center `c`. -/
def IsStarAt (G : Graph α) (c : α) : Prop := ∀ q p, Hears G q p ↔ p = q ∨ p = c

omit [Fintype α] in
theorem isStarAt_starGraph (c : α) : IsStarAt (starGraph {c}) c := fun _ _ => Iff.rfl

section Star

variable {G : Graph α} {c : α}

theorem outSet_singleton (G : Graph α) (P : Finset α) : outSet {G} P = out G P := by
  classical
  ext q; rw [mem_out]; unfold outSet; simp

theorem IsStarAt.out_of_mem (hG : IsStarAt G c) {P : Finset α} (hc : c ∈ P) : out G P = univ :=
  eq_univ_of_forall fun q => mem_out.2 ⟨c, hc, (hG q c).2 (Or.inr rfl)⟩

theorem IsStarAt.out_of_notMem (hG : IsStarAt G c) {P : Finset α} (hc : c ∉ P) : out G P = P := by
  apply Subset.antisymm _ (subset_out G P)
  intro q hq
  obtain ⟨p, hp, h⟩ := mem_out.1 hq
  rcases (hG q p).1 h with rfl | rfl
  · exact hp
  · exact absurd hp hc

omit [Fintype α] in
theorem singleton_of_subset_ncard {G : Graph α} {T : Set (Graph α)} (hT : T ⊆ {G}) {i : ℕ}
    (hi : 0 < i) (hn : T.ncard = min i ({G} : Set (Graph α)).ncard) : T = {G} := by
  rw [Set.ncard_singleton, min_eq_right (by omega)] at hn
  obtain ⟨H, rfl⟩ := Set.ncard_eq_one.1 hn
  rw [Set.singleton_subset_iff, Set.mem_singleton_iff] at hT
  rw [hT]

/-- A set of `t < n` processes avoiding `c`. -/
theorem exists_avoiding (c : α) {t : ℕ} (ht : t < Fintype.card α) :
    ∃ P : Finset α, c ∉ P ∧ P.card = t := by
  classical
  obtain ⟨P, hPs, hP⟩ := exists_subset_card_eq (s := univ.erase c) (n := t)
    (by rw [card_erase_of_mem (mem_univ c), card_univ]; omega)
  exact ⟨P, fun h => notMem_erase c univ (hPs h), hP⟩

theorem IsStarAt.distDomNum (hG : IsStarAt G c) : distDomNum {G} = Fintype.card α := by
  have hcard : 0 < Fintype.card α := Fintype.card_pos_iff.2 ⟨c⟩
  have hmem : Fintype.card α ∈ {i | 0 < i ∧ ∀ P : Finset α, ∀ T ⊆ ({G} : Set (Graph α)),
      P.card = i → T.ncard = min i ({G} : Set (Graph α)).ncard → outSet T P = univ} := by
    refine ⟨hcard, fun P T hT hP hTn => ?_⟩
    rw [singleton_of_subset_ncard hT hcard hTn, outSet_singleton,
      eq_univ_of_card P hP]
    exact hG.out_of_mem (mem_univ c)
  apply le_antisymm (Nat.sInf_le hmem)
  apply le_csInf ⟨_, hmem⟩
  rintro i ⟨hi, hall⟩
  by_contra hlt
  obtain ⟨P, hcP, hP⟩ := exists_avoiding c (not_le.1 hlt)
  have := hall P {G} subset_rfl hP (by rw [Set.ncard_singleton, min_eq_right (by omega)])
  rw [outSet_singleton, hG.out_of_notMem hcP] at this
  exact hcP (this ▸ mem_univ c)

theorem IsStarAt.maxCov (hG : IsStarAt G c) {t : ℕ} (ht0 : 0 < t) (ht : t < Fintype.card α) :
    maxCov t {G} = t := by
  have hset : {x | ∃ P : Finset α, ∃ T ⊆ ({G} : Set (Graph α)), P.card = t ∧
      T.ncard = min t ({G} : Set (Graph α)).ncard ∧ outSet T P ≠ univ ∧ (outSet T P).card = x} =
      {t} := by
    ext x
    simp only [Set.mem_singleton_iff]
    constructor
    · rintro ⟨P, T, hT, hP, hTn, hne, rfl⟩
      rw [singleton_of_subset_ncard hT ht0 hTn, outSet_singleton] at hne ⊢
      by_cases hc : c ∈ P
      · exact absurd (hG.out_of_mem hc) hne
      · rw [hG.out_of_notMem hc, hP]
    · rintro rfl
      obtain ⟨P, hcP, hP⟩ := exists_avoiding c ht
      refine ⟨P, {G}, subset_rfl, hP, by rw [Set.ncard_singleton, min_eq_right (by omega)], ?_, ?_⟩
      · rw [outSet_singleton, hG.out_of_notMem hcP]
        exact fun h => hcP (h ▸ mem_univ c)
      · rw [outSet_singleton, hG.out_of_notMem hcP, hP]
  unfold RoundBasedKSetTopology.maxCov
  rw [hset, csSup_singleton]

/-- For (a graph with the hearing relation of) a star, `l = n - 2`. -/
theorem IsStarAt.thm54L (hG : IsStarAt G c) : thm54L {G} = (Fintype.card α : ℤ) - 2 := by
  unfold RoundBasedKSetTopology.thm54L
  have hd := hG.distDomNum
  have hall : ∀ y ∈ insert ((Fintype.card α : ℤ) - 2) ((Icc 1 (Fintype.card α - 1)).image
      (fun t : ℕ => (t : ℤ) + (maxCovCoeff t {G} : ℤ) - 2)), y = (Fintype.card α : ℤ) - 2 := by
    intro y hy
    rcases mem_insert.1 hy with rfl | hy
    · rfl
    · obtain ⟨t, ht, rfl⟩ := mem_image.1 hy
      rw [mem_Icc] at ht
      have hlt : t < Fintype.card α := by omega
      have hM : maxCovCoeff t {G} = Fintype.card α - t := by
        unfold maxCovCoeff; rw [hG.maxCov (by omega) hlt]; simp
      rw [hM]; push_cast [hlt.le]; ring
  apply le_antisymm ((min'_le _ _ (mem_insert_self _ _)).trans (by rw [hd]))
  exact le_min' _ _ _ fun y hy => (hall y (by rw [← hd]; exact hy)).ge

/-- In a star (`n ≥ 1`), `{c}` is a dominating set, so `γ ≤ 1`. -/
theorem IsStarAt.domNum_le (hG : IsStarAt G c) : domNum G ≤ 1 := by
  have : Nonempty α := ⟨c⟩
  exact (domNum_le_card (P := {c}) fun q => ⟨c, mem_singleton_self c, (hG q c).2 (Or.inr rfl)⟩).trans
    (by simp)

/-- **Theorem 5.4 is false.** For the star `G` with center `c` and `n ≥ 2` processes,
`l = n - 2`, so Theorem 5.4 claims that `(n - 1)`-set agreement is not solvable in one round on
`↑G`; but consensus (hence `(n-1)`-set agreement) is solvable: decide the input of `c`. -/
theorem theorem_5_4_false [LinearOrder V] [Nonempty V] (c : α) (hn : 2 ≤ Fintype.card α) :
    thm54L {starGraph {c}} = (Fintype.card α : ℤ) - 2 ∧
      OneRoundSolvable V 1 (closedAbove {starGraph {c}}) ∧
      ¬ Theorem54Statement V {starGraph {c}} := by
  have hG := isStarAt_starGraph c
  have h1 : OneRoundSolvable V 1 (closedAbove {starGraph {c}}) :=
    (theorem_3_2 (starGraph {c})).mono hG.domNum_le
  refine ⟨hG.thm54L, h1, fun h => h (Fintype.card α - 1) ?_ (h1.mono (by omega))⟩
  rw [hG.thm54L]; push_cast [show 1 ≤ Fintype.card α by omega]; ring

/-- The smallest instance: three processes, `S = {star centered at 0}`; Theorem 5.4 claims that
`2`-set agreement is impossible, yet consensus is solvable. -/
example : thm54L {starGraph ({0} : Set (Fin 3))} = 1 ∧
    OneRoundSolvable ℕ 1 (closedAbove {starGraph ({0} : Set (Fin 3))}) ∧
    ¬ Theorem54Statement ℕ {starGraph ({0} : Set (Fin 3))} := by
  obtain ⟨h1, h2, h3⟩ := theorem_5_4_false (V := ℕ) (0 : Fin 3) (by simp)
  exact ⟨by rw [h1]; simp, h2, h3⟩

end Star

/-! ### `γ^dist` of the symmetric model of all stars -/

omit [Fintype α] in
theorem starGraph_injective : Function.Injective fun c : α => starGraph ({c} : Set α) := by
  intro c d h
  have := congrFun (congrFun h c) c
  simpa [starGraph] using this

/-- The symmetric model of single stars (`s = 1`): all stars. -/
def allStars (α : Type*) : Set (Graph α) := Set.range fun c : α => starGraph ({c} : Set α)

omit [Fintype α] in
theorem allStars_eq_sym (c : α) : allStars α = Sym {starGraph {c}} := by
  classical
  ext H
  constructor
  · rintro ⟨d, rfl⟩
    refine ⟨_, rfl, Equiv.swap c d, ?_⟩
    funext j i
    simp only [relabel, starGraph, Set.mem_singleton_iff, Equiv.symm_apply_eq,
      Equiv.swap_apply_left]
  · rintro ⟨_, rfl, π, rfl⟩
    refine ⟨π c, ?_⟩
    funext j i
    simp only [relabel, starGraph, Set.mem_singleton_iff, Equiv.symm_apply_eq]

/-- The paper (Section 5, after Theorem 5.4, and Appendix G) claims `γ^dist(S) = n - s + 1` for
the symmetric model of unions of `s` stars. For `s = 1` and `n ≥ 3` this is false:
`γ^dist(S) ≤ n - 1`. -/
theorem distDomNum_stars_le (hn : 3 ≤ Fintype.card α) :
    distDomNum (allStars α) ≤ Fintype.card α - 1 := by
  classical
  apply Nat.sInf_le
  refine ⟨by omega, fun P T hT hP hTn => ?_⟩
  have hS : (allStars α).ncard = Fintype.card α := by
    rw [allStars, Set.ncard_range_of_injective starGraph_injective, Nat.card_eq_fintype_card]
  rw [hS, min_eq_left (by omega)] at hTn
  obtain ⟨G₁, G₂, hG₁, hG₂, hne⟩ := (Set.one_lt_ncard_iff (Set.toFinite T)).1 (by omega : 1 < T.ncard)
  obtain ⟨c₁, rfl⟩ := hT hG₁
  obtain ⟨c₂, rfl⟩ := hT hG₂
  have hc : c₁ ≠ c₂ := fun h => hne (by rw [h])
  -- one of the two centers is in `P`
  have : c₁ ∈ P ∨ c₂ ∈ P := by
    by_contra h
    push Not at h
    have hsub : ({c₁, c₂} : Finset α) ⊆ univ \ P := by
      intro x hx
      rcases mem_insert.1 hx with rfl | hx
      · exact mem_sdiff.2 ⟨mem_univ _, h.1⟩
      · rw [mem_singleton.1 hx]; exact mem_sdiff.2 ⟨mem_univ _, h.2⟩
    have := card_le_card hsub
    rw [card_pair hc, card_sdiff_of_subset (subset_univ _), card_univ] at this
    omega
  apply eq_univ_of_forall
  intro q
  unfold outSet
  simp only [mem_filter, mem_univ, true_and]
  rcases this with h | h
  · exact ⟨_, hG₁, c₁, h, Or.inr rfl⟩
  · exact ⟨_, hG₂, c₂, h, Or.inr rfl⟩

/-- Hence the claimed value `n - s + 1 = n` is wrong for `s = 1`, `n ≥ 3`. -/
theorem distDomNum_stars_ne (hn : 3 ≤ Fintype.card α) :
    distDomNum (allStars α) ≠ Fintype.card α - 1 + 1 := by
  have := distDomNum_stars_le hn
  omega

end Podc.RoundBasedKSetTopology
