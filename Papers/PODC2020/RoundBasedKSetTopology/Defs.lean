import Mathlib
import Cslib.Computability.Distributed.DynamicNetworks.HeardOf

/-!
# Closed-above round-based models and one-round `k`-set agreement

Shimi, Castañeda, *K-set agreement bounds in round-based models through combinatorial topology*,
PODC 2020 (full version arXiv:2003.02869), Sections 2, 3, 5 and 6.

## Model

* `n = |α|` processes; a *communication graph* is a `Cslib.HeardOf.Graph α` (`G j i`: `i` receives
  the message of `j`); self-loops are implicit (`Cslib.HeardOf.Hears`), as the paper assumes.
* `Out_G(P)` (`out G P`): the processes hearing some member of `P` in `G`.
* A *closed-above model* generated by `S` is `(⋃_{G ∈ S} ↑G)^ω`; since it is oblivious, the
  adversary picks any graph of `closedAbove S` in every round independently.
* A one-round full-information algorithm is a decision map `δ p view` applied to the vector
  of received inputs (`Cslib.HeardOf.msgs`, `none` = not heard).
* `k`-set agreement (`KSetAgreement`): every decision is the input of some process (validity) and
  at most `k` values are decided (agreement).
* `r`-round *oblivious* algorithms (Definition 2.5): every process floods all `(process, input)`
  pairs it knows; after `r` rounds it applies a decision map to the set of known pairs
  (`known Gs x p`).

## Combinatorial numbers

`domNum` (γ, Definition 3.1), `eqDomNum`/`eqDomNumSet` (γ^eq, Definition 3.3), `cov`/`covSet`
(Definition 3.6), `distDomNum` (γ^dist, Definition 5.2), `maxCov` and `maxCovCoeff` (max-cov and
`M`, Definition 5.3), `thm54L` (the `l` of Theorem 5.4), the graph path product `gprod`
(Definition 6.1) and the covering-number sequences `covSeq` (Definitions 6.6/6.8).
-/

namespace Podc.RoundBasedKSetTopology

open Cslib.HeardOf Finset

variable {α V : Type*}

/-! ### Graphs, closed-above and symmetric models -/

-- CSLib candidate: closed-above oblivious models and domination numbers of digraphs
/-- `Out_G(P) = ⋃_{p ∈ P} Out_G(p)`: the processes hearing some member of `P` in `G`
(self-loops implicit, so `P ⊆ Out_G(P)`). -/
noncomputable def out [Fintype α] (G : Graph α) (P : Finset α) : Finset α := by
  classical exact univ.filter (fun q => ∃ p ∈ P, Hears G q p)

/-- `P` is a dominating set of `G`: `Out_G(P) = Π`. -/
def Dominates (G : Graph α) (P : Finset α) : Prop := ∀ q, ∃ p ∈ P, Hears G q p

/-- The closed-above model generated by a set of graphs `S` (Definition 2.3):
the graphs containing (the edges of) some generator. -/
def closedAbove (S : Set (Graph α)) : Set (Graph α) := {H | ∃ G ∈ S, G ≤ H}

/-- The graph `π(G)`: process `π p` plays the role of `p`. -/
def relabel (π : Equiv.Perm α) (G : Graph α) : Graph α := fun j i => G (π.symm j) (π.symm i)

/-- `Sym(S)` (Definition 2.4): all relabelings of graphs of `S`. -/
def Sym (S : Set (Graph α)) : Set (Graph α) := {H | ∃ G ∈ S, ∃ π : Equiv.Perm α, H = relabel π G}

/-- A star graph (Definition 6.12): the processes of `C` (the centers) send to everybody;
`starGraph {c}` is the star with center `c`. -/
def starGraph (C : Set α) : Graph α := fun j _ => j ∈ C

/-! ### Combinatorial numbers -/

section Numbers

variable [Fintype α]

/-- Domination number `γ(G)` (Definition 3.1). -/
noncomputable def domNum (G : Graph α) : ℕ :=
  sInf {i | 1 ≤ i ∧ i ≤ Fintype.card α ∧ ∃ P : Finset α, P.card = i ∧ Dominates G P}

/-- Equal-domination number `γ^eq(G)` of a graph (Definition 3.3): the least `i` such that
*every* set of `i` processes dominates `G`. -/
noncomputable def eqDomNum (G : Graph α) : ℕ :=
  sInf {i | 1 ≤ i ∧ i ≤ Fintype.card α ∧ ∀ P : Finset α, P.card = i → Dominates G P}

/-- Equal-domination number of a set of graphs: `γ^eq(S) = max_{G ∈ S} γ^eq(G)`. -/
noncomputable def eqDomNumSet (S : Set (Graph α)) : ℕ := sSup (eqDomNum '' S)

/-- `i`-th covering number of a graph: `cov_i(G) = min_{|P| = i} |Out_G(P)|` (Definition 3.6). -/
noncomputable def cov (i : ℕ) (G : Graph α) : ℕ :=
  sInf {c | ∃ P : Finset α, P.card = i ∧ (out G P).card = c}

/-- `i`-th covering number of a set of graphs: `cov_i(S) = min_{G ∈ S} cov_i(G)`. -/
noncomputable def covSet (i : ℕ) (S : Set (Graph α)) : ℕ := sInf (cov i '' S)

/-- `⋃_{G ∈ T} Out_G(P)`. -/
noncomputable def outSet (T : Set (Graph α)) (P : Finset α) : Finset α := by
  classical exact univ.filter (fun q => ∃ G ∈ T, ∃ p ∈ P, Hears G q p)

/-- Distributed domination number `γ^dist(S)` (Definition 5.2): the least `i > 0` such that for
every set `P` of `i` processes and every set `T ⊆ S` of `min(i, |S|)` graphs,
`⋃_{G ∈ T} Out_G(P) = Π`. -/
noncomputable def distDomNum (S : Set (Graph α)) : ℕ :=
  sInf {i | 0 < i ∧ ∀ P : Finset α, ∀ T ⊆ S, P.card = i → T.ncard = min i S.ncard →
    outSet T P = univ}

/-- `i`-th max-covering number (Definition 5.3): the largest `|⋃_{G ∈ T} Out_G(P)| ≠ n` over
`|P| = i` and `T ⊆ S` with `|T| = min(i, |S|)`. -/
noncomputable def maxCov (i : ℕ) (S : Set (Graph α)) : ℕ :=
  sSup {c | ∃ P : Finset α, ∃ T ⊆ S, P.card = i ∧ T.ncard = min i S.ncard ∧
    outSet T P ≠ univ ∧ (outSet T P).card = c}

/-- `i`-th max-covering coefficient `M_i(S)` (Definition 5.3). -/
noncomputable def maxCovCoeff (i : ℕ) (S : Set (Graph α)) : ℕ :=
  if i < maxCov i S then (Fintype.card α - i - 1) / (maxCov i S - i) else Fintype.card α - i

/-- The integer `l = min(γ^dist(S) - 2, min{t + M_t(S) - 2 | t ∈ [1, γ^dist(S) - 1]})` of
Theorem 5.4. -/
noncomputable def thm54L (S : Set (Graph α)) : ℤ :=
  (insert ((distDomNum S : ℤ) - 2)
    ((Icc 1 (distDomNum S - 1)).image (fun t : ℕ => (t : ℤ) + (maxCovCoeff t S : ℤ) - 2))).min'
    (insert_nonempty _ _)

end Numbers

/-! ### One-round algorithms and `k`-set agreement -/

/-- A one-round full-information algorithm: process `p` decides `δ p v` on the vector `v` of
received inputs (`none` = not heard). The same type serves as the decision map of an oblivious
algorithm applied to the known `(process, input)` pairs. -/
abbrev Decision (α V : Type*) := α → (α → Option V) → V

/-- `k`-set agreement for inputs `x` and decisions `d`: validity and `k`-agreement. -/
def KSetAgreement (k : ℕ) (x : α → V) (d : α → V) : Prop :=
  (∀ p, ∃ q, d p = x q) ∧ (Set.range d).ncard ≤ k

/-- `δ` solves `k`-set agreement in one round on the oblivious model with graph set `M`. -/
def SolvesOneRound (k : ℕ) (M : Set (Graph α)) (δ : Decision α V) : Prop :=
  ∀ G ∈ M, ∀ x : α → V, KSetAgreement k x (fun p => δ p (msgs G x p))

/-- `k`-set agreement (inputs in `V`) is solvable in one round on the model with graph set `M`. -/
def OneRoundSolvable (V : Type*) (k : ℕ) (M : Set (Graph α)) : Prop :=
  ∃ δ : Decision α V, SolvesOneRound k M δ

/-! ### Multiple rounds: products and oblivious algorithms -/

/-- `Reach Gs q p`: after the rounds `Gs` (in order), `p` has (transitively) heard of `q`. -/
def Reach : List (Graph α) → α → α → Prop
  | [], q, p => q = p
  | G :: Gs, q, p => ∃ w, Hears G w q ∧ Reach Gs w p

/-- The `(process, input)` pairs known by `p` after the rounds `Gs` when flooding all known
pairs: the flattened full-information view of Definition 2.5. -/
noncomputable def known (Gs : List (Graph α)) (x : α → V) (p : α) : α → Option V := by
  classical exact fun q => if Reach Gs q p then some (x q) else none

/-- An oblivious algorithm with decision map `δ` solves `k`-set agreement in `r` rounds on the
oblivious model with graph set `M`. -/
def SolvesRounds (r k : ℕ) (M : Set (Graph α)) (δ : Decision α V) : Prop :=
  ∀ Gs : List (Graph α), Gs.length = r → (∀ G ∈ Gs, G ∈ M) → ∀ x : α → V,
    KSetAgreement k x (fun p => δ p (known Gs x p))

/-- `k`-set agreement is solvable in `r` rounds by an oblivious algorithm on the model `M`. -/
def ObliviousSolvable (V : Type*) (r k : ℕ) (M : Set (Graph α)) : Prop :=
  ∃ δ : Decision α V, SolvesRounds r k M δ

/-- The graph path product `G ⊗ H` (Definition 6.1): `u → v` iff `u → w` in `G` and `w → v` in
`H` for some `w` (self-loops implicit). -/
def gprod (G H : Graph α) : Graph α := fun u v => ∃ w, Hears G w u ∧ Hears H v w

/-- The product `G₁ ⊗ ⋯ ⊗ G_r` of a list of graphs (the empty product has only self-loops). -/
def gprodList : List (Graph α) → Graph α
  | [] => fun _ _ => False
  | G :: Gs => gprod G (gprodList Gs)

/-- `G^r`. -/
def gpow (G : Graph α) (r : ℕ) : Graph α := gprodList (List.replicate r G)

/-- `S^r = {G₁ ⊗ ⋯ ⊗ G_r | Gᵢ ∈ S}`. -/
def powSet (S : Set (Graph α)) (r : ℕ) : Set (Graph α) :=
  {H | ∃ Gs : List (Graph α), Gs.length = r ∧ (∀ G ∈ Gs, G ∈ S) ∧ H = gprodList Gs}

/-- The `i`-th covering-number sequence of a set of graphs (Definition 6.8; Definition 6.6 for
`S = {G}`), indexed from `0`: `covSeq i S 0 = s₁ = cov_i(S)` and
`s_{k+1} = n` if `s_k ≥ γ^eq(S)`, else `cov_{s_k}(S)`. -/
noncomputable def covSeq [Fintype α] (i : ℕ) (S : Set (Graph α)) : ℕ → ℕ
  | 0 => covSet i S
  | k + 1 => if eqDomNumSet S ≤ covSeq i S k then Fintype.card α else covSet (covSeq i S k) S

end Podc.RoundBasedKSetTopology
