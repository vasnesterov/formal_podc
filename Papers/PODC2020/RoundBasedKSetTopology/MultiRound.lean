import Papers.PODC2020.RoundBasedKSetTopology.Theorem54

/-!
# Multiple rounds (Section 6)

An oblivious algorithm floods all known `(process, input)` pairs and decides on them after `r`
rounds; the known pairs after rounds `G₁, …, G_r` are exactly the inputs of the in-neighbours of
the product graph `G₁ ⊗ ⋯ ⊗ G_r` (`known_eq_msgs`). Hence `r` rounds on `↑S` reduce to one round
on the closed-above model generated by `S^r` (Lemma 6.2, `solvesRounds_of_solvesOneRound`).

* Lemma 6.2 (`lemma_6_2`), Theorems 6.3, 6.4, 6.5 (upper bounds).
* Theorems 6.7 / 6.9 (covering-number sequences, `theorem_6_9`, `theorem_6_7`).
* Theorem 6.10 as stated (`(γ(G) - 1)`-set agreement impossible in `r` rounds) is false
  (`theorem_6_10_false`: directed 3-cycle, `r = 2`); the intended `γ(G^r)` version holds and
  is tight (`theorem_6_10`, `obliviousSolvable_up_iff`).
* Theorem 6.11 is false for the same star counterexample as Theorem 5.4 (`theorem_6_11_false`).
-/

namespace Podc.RoundBasedKSetTopology

open Cslib.HeardOf Finset

variable {α V : Type*}

/-! ### Products and known pairs -/

theorem hears_gprod {G H : Graph α} {q p : α} :
    Hears (gprod G H) q p ↔ ∃ w, Hears G w p ∧ Hears H q w := by
  constructor
  · rintro (rfl | h)
    · exact ⟨p, hears_self G p, hears_self H p⟩
    · exact h
  · exact Or.inr

theorem hears_gprodList_nil {q p : α} : Hears (gprodList ([] : List (Graph α))) q p ↔ p = q := by
  simp [Hears, gprodList]

-- CSLib candidate: Cslib/Computability/Distributed/DynamicNetworks (flooding = one round on the product graph)
theorem reach_iff_hears (Gs : List (Graph α)) (q p : α) : Reach Gs q p ↔ Hears (gprodList Gs) p q := by
  induction Gs generalizing q with
  | nil => rw [hears_gprodList_nil]; rfl
  | cons G Gs ih =>
    show (∃ w, Hears G w q ∧ Reach Gs w p) ↔ Hears (gprod G (gprodList Gs)) p q
    rw [hears_gprod]
    simp only [ih]

/-- The known pairs after rounds `Gs` are the one-round view in the product graph. -/
theorem known_eq_msgs (Gs : List (Graph α)) (x : α → V) (p : α) :
    known Gs x p = msgs (gprodList Gs) x p := by
  classical
  funext q
  unfold known msgs
  simp only [reach_iff_hears]

theorem gprod_mono {G G' H H' : Graph α} (hG : G ≤ G') (hH : H ≤ H') : gprod G H ≤ gprod G' H' :=
  fun _ _ ⟨w, h₁, h₂⟩ => ⟨w, hears_mono hG h₁, hears_mono hH h₂⟩

/-- **Lemma 6.2.** `↑G ⊗ ↑H ⊆ ↑(G ⊗ H)`. -/
theorem lemma_6_2 (G H : Graph α) :
    {K | ∃ G' H', G ≤ G' ∧ H ≤ H' ∧ K = gprod G' H'} ⊆ closedAbove {gprod G H} := by
  rintro _ ⟨G', H', hG, hH, rfl⟩
  exact ⟨gprod G H, rfl, gprod_mono hG hH⟩

theorem gprodList_mono {Gs Hs : List (Graph α)} (h : List.Forall₂ (· ≤ ·) Gs Hs) :
    gprodList Gs ≤ gprodList Hs := by
  induction h with
  | nil => exact le_rfl
  | cons hab _ ih => exact gprod_mono hab ih

/-- Every list of graphs of `↑S` lies above a list of generators. -/
theorem exists_generators {S : Set (Graph α)} (Gs : List (Graph α))
    (hGs : ∀ G ∈ Gs, G ∈ closedAbove S) :
    ∃ Hs : List (Graph α), (∀ H ∈ Hs, H ∈ S) ∧ List.Forall₂ (· ≤ ·) Hs Gs := by
  induction Gs with
  | nil => exact ⟨[], by simp, List.Forall₂.nil⟩
  | cons G Gs ih =>
    obtain ⟨H, hH, hHG⟩ := hGs G List.mem_cons_self
    obtain ⟨Hs, hHs, h⟩ := ih fun G' hG' => hGs G' (List.mem_cons_of_mem _ hG')
    exact ⟨H :: Hs, by simpa [hH] using hHs, List.Forall₂.cons hHG h⟩

/-- An algorithm solving `k`-set agreement in one round on `↑(S^r)` solves it in `r` rounds on
`↑S` when run obliviously (consequence of Lemma 6.2). -/
theorem solvesRounds_of_solvesOneRound {S : Set (Graph α)} {r k : ℕ} {δ : Decision α V}
    (h : SolvesOneRound k (closedAbove (powSet S r)) δ) : SolvesRounds r k (closedAbove S) δ := by
  intro Gs hlen hGs x
  obtain ⟨Hs, hHs, hle⟩ := exists_generators Gs hGs
  have hmem : gprodList Gs ∈ closedAbove (powSet S r) :=
    ⟨gprodList Hs, ⟨Hs, hle.length_eq.trans hlen, hHs, rfl⟩, gprodList_mono hle⟩
  simpa only [known_eq_msgs] using h _ hmem x

theorem ObliviousSolvable.of_oneRound {S : Set (Graph α)} {r k : ℕ}
    (h : OneRoundSolvable V k (closedAbove (powSet S r))) :
    ObliviousSolvable V r k (closedAbove S) :=
  let ⟨δ, hδ⟩ := h
  ⟨δ, solvesRounds_of_solvesOneRound hδ⟩

theorem powSet_singleton (G : Graph α) (r : ℕ) : powSet {G} r = {gpow G r} := by
  ext H
  constructor
  · rintro ⟨Gs, hlen, hGs, rfl⟩
    rw [Set.mem_singleton_iff, gpow, List.eq_replicate_iff.2 ⟨hlen, fun G hG => hGs G hG⟩]
  · rintro rfl
    exact ⟨List.replicate r G, List.length_replicate, fun H hH => List.eq_of_mem_replicate hH, rfl⟩

/-! ### Upper bounds -/

section Upper

variable [Fintype α] [LinearOrder V] [Nonempty V]

/-- **Theorem 6.3.** `γ(G^r)`-set agreement is solvable in `r` rounds on `↑G`. -/
theorem theorem_6_3 (G : Graph α) (r : ℕ) :
    ObliviousSolvable V r (domNum (gpow G r)) (closedAbove {G}) :=
  ObliviousSolvable.of_oneRound (by rw [powSet_singleton]; exact theorem_3_2 _)

/-- **Theorem 6.4.** `γ^eq(S^r)`-set agreement is solvable in `r` rounds on `↑S`. -/
theorem theorem_6_4 (S : Set (Graph α)) (r : ℕ) :
    ObliviousSolvable V r (eqDomNumSet (powSet S r)) (closedAbove S) :=
  ObliviousSolvable.of_oneRound (theorem_3_4 _)

/-- **Theorem 6.5.** For `i ∈ [1, γ^eq(S^r)[`, `(i + (n - cov_i(S^r)))`-set agreement is solvable
in `r` rounds on `↑S` by an oblivious algorithm. -/
theorem theorem_6_5 (S : Set (Graph α)) (r : ℕ) {i : ℕ}
    (hi : i ∈ Set.Ico 1 (eqDomNumSet (powSet S r))) :
    ObliviousSolvable V r (i + (Fintype.card α - covSet i (powSet S r))) (closedAbove S) :=
  ObliviousSolvable.of_oneRound (theorem_3_7 _ hi)

end Upper

/-! ### Covering-number sequences (Theorems 6.7 and 6.9) -/

section CovSeq

variable [Fintype α]

theorem out_gprod (G H : Graph α) (P : Finset α) : out (gprod G H) P = out H (out G P) := by
  ext q
  simp only [mem_out, hears_gprod]
  constructor
  · rintro ⟨p, hp, w, h₁, h₂⟩; exact ⟨w, ⟨p, hp, h₁⟩, h₂⟩
  · rintro ⟨w, ⟨p, hp, h₁⟩, h₂⟩
    exact ⟨p, hp, w, h₁, h₂⟩

theorem out_gprodList_nil (P : Finset α) : out (gprodList ([] : List (Graph α))) P = P := by
  ext q; simp [mem_out, hears_gprodList_nil]

theorem covSeq_le_card (i : ℕ) (S : Set (Graph α)) (k : ℕ) : covSeq i S k ≤ Fintype.card α := by
  cases k with
  | zero => exact covSet_le_card i S
  | succ k => simp only [covSeq]; split_ifs; exacts [le_rfl, covSet_le_card _ S]

/-- One step of the covering-number sequence: if at least `s ≤ n` processes know a value, then
after one more round of `↑S` at least `s'` processes know it, where `s' = n` if `s ≥ γ^eq(S)`
and `s' = cov_s(S)` otherwise. -/
theorem covSeq_step {S : Set (Graph α)} {H : Graph α} (hH : H ∈ closedAbove S) {s : ℕ}
    {P : Finset α} (hP : s ≤ P.card) :
    (if eqDomNumSet S ≤ s then Fintype.card α else covSet s S) ≤ (out H P).card := by
  obtain ⟨G, hG, hGH⟩ := hH
  split_ifs with h
  · rw [dominates_iff_out.1 ((dominates_of_eqDomNumSet_le hG (h.trans hP)).mono_graph hGH),
      card_univ]
  · exact (covSet_le_cov hG).trans ((cov_mono G hP (card_le_univ P)).trans
      (le_card_out_of_le hGH (cov_le_card_out G rfl)))

theorem covSeq_spread {S : Set (Graph α)} (i : ℕ) (Gs : List (Graph α))
    (hGs : ∀ G ∈ Gs, G ∈ closedAbove S) {j : ℕ} {K : Finset α} (hK : covSeq i S j ≤ K.card) :
    covSeq i S (j + Gs.length) ≤ (out (gprodList Gs) K).card := by
  induction Gs generalizing j K with
  | nil => simpa [out_gprodList_nil] using hK
  | cons G Gs ih =>
    rw [gprodList, out_gprod, List.length_cons, show j + (Gs.length + 1) = (j + 1) + Gs.length by omega]
    apply ih (fun G' hG' => hGs G' (List.mem_cons_of_mem _ hG'))
    exact covSeq_step (hGs G List.mem_cons_self) hK

variable [LinearOrder V] [Nonempty V]

/-- **Theorem 6.9.** If the `i`-th covering-number sequence of `S` reaches `n` (at index `k`,
i.e. at `s_{k+1}`), then `i`-set agreement is solvable on `↑S` (in `k + 1` rounds, by flooding
and deciding the minimum known value). -/
theorem theorem_6_9 (S : Set (Graph α)) {i : ℕ} (hi : i ≤ Fintype.card α) {k : ℕ}
    (hk : covSeq i S k = Fintype.card α) : ObliviousSolvable V (k + 1) i (closedAbove S) := by
  refine ⟨minFrom univ, fun Gs hlen hGs x => ?_⟩
  simp only [known_eq_msgs]
  refine ⟨minFrom_univ_valid _ x, ?_⟩
  obtain ⟨P, hP, hlow⟩ := exists_lowerSet x hi
  refine (ncard_range_minFrom_le _ x hlow).trans ?_
  obtain ⟨G, Gs', rfl⟩ : ∃ G Gs', Gs = G :: Gs' := by
    cases Gs with
    | nil => simp at hlen
    | cons G Gs' => exact ⟨G, Gs', rfl⟩
  have h1 : covSeq i S 0 ≤ (out G P).card := by
    obtain ⟨G₀, hG₀, hle⟩ := hGs G List.mem_cons_self
    exact (covSet_le_cov hG₀).trans (le_card_out_of_le hle (cov_le_card_out G₀ hP))
  have h2 := covSeq_spread i Gs' (fun G' hG' => hGs G' (List.mem_cons_of_mem _ hG')) h1
  rw [List.length_cons] at hlen
  rw [zero_add, show Gs'.length = k by omega, hk, ← out_gprod] at h2
  have := card_le_univ (out (gprod G (gprodList Gs')) P)
  simp only [gprodList]
  omega

/-- **Theorem 6.7** (simple closed-above models): if the `i`-th covering sequence of `G` reaches
`n`, `i`-set agreement is solvable on `↑G`. -/
theorem theorem_6_7 (G : Graph α) {i : ℕ} (hi : i ≤ Fintype.card α) {k : ℕ}
    (hk : covSeq i {G} k = Fintype.card α) : ObliviousSolvable V (k + 1) i (closedAbove {G}) :=
  theorem_6_9 {G} hi hk

end CovSeq

/-! ### Lower bounds -/

section Lower

variable [Fintype α]

omit [Fintype α] in
/-- An oblivious `r`-round algorithm on `↑G`, run on `G` in every round, is a one-round algorithm
on `G^r`. -/
theorem solvesOneRound_gpow {G : Graph α} {r k : ℕ} {δ : Decision α V}
    (h : SolvesRounds r k (closedAbove {G}) δ) : SolvesOneRound k {gpow G r} δ := by
  rintro H rfl x
  have := h (List.replicate r G) List.length_replicate
    (fun G' hG' => ⟨G, rfl, (List.eq_of_mem_replicate hG').ge⟩) x
  simpa only [known_eq_msgs, gpow] using this

/-- **Theorem 6.10 (corrected: `k < γ(G^r)`).** With at least `n` input values, `k`-set agreement
is not solvable in `r` rounds on `↑G` by an oblivious algorithm when `k < γ(G^r)`. -/
theorem theorem_6_10 (e : α ↪ V) (G : Graph α) (r : ℕ) {k : ℕ} (hk : k < domNum (gpow G r)) :
    ¬ ObliviousSolvable V r k (closedAbove {G}) := by
  rintro ⟨δ, hδ⟩
  have := domNum_le_of_solvesOneRound e (solvesOneRound_gpow hδ) (G := gpow G r) rfl
  omega

/-- Theorems 6.3 and 6.10 together: `k`-set agreement is solvable in `r` rounds on `↑G` by an
oblivious algorithm iff `γ(G^r) ≤ k`. -/
theorem obliviousSolvable_up_iff [LinearOrder V] [Nonempty V] (e : α ↪ V) (G : Graph α)
    (r k : ℕ) : ObliviousSolvable V r k (closedAbove {G}) ↔ domNum (gpow G r) ≤ k := by
  constructor
  · intro h; by_contra hk; exact theorem_6_10 e G r (not_le.1 hk) h
  · intro h
    obtain ⟨δ, hδ⟩ := theorem_6_3 (V := V) G r
    exact ⟨δ, fun Gs hl hGs x => ⟨(hδ Gs hl hGs x).1, (hδ Gs hl hGs x).2.trans h⟩⟩

/-- The directed 3-cycle `0 → 1 → 2 → 0`. -/
def cycle3 : Graph (Fin 3) := fun j i => i = j + 1

theorem domNum_cycle3 : domNum cycle3 = 2 := by
  apply le_antisymm
  · exact (domNum_le_card (P := {0, 1}) (by
      intro q; fin_cases q
      · exact ⟨0, by simp, Or.inl rfl⟩
      · exact ⟨1, by simp, Or.inl rfl⟩
      · exact ⟨1, by simp, Or.inr rfl⟩)).trans (by decide)
  · obtain ⟨P, hP, hcard⟩ := exists_dominating_card_domNum cycle3
    rw [← hcard]
    by_contra hlt
    rw [not_le, Nat.lt_succ_iff, Finset.card_le_one_iff_subset_singleton] at hlt
    obtain ⟨a, ha⟩ := hlt
    -- a single process reaches only itself and its successor
    have hb : ∀ q, Hears cycle3 q a → q = a ∨ q = a + 1 := by
      rintro q (h | h)
      · exact Or.inl h.symm
      · exact Or.inr h
    obtain ⟨p, hp, h⟩ := hP (a + 2)
    rw [mem_singleton.1 (ha hp)] at h
    rcases hb _ h with h' | h' <;> fin_cases a <;> simp_all

/-- After two rounds of `↑cycle3`, everybody has heard of everybody. -/
theorem domNum_gpow_cycle3 : domNum (gpow cycle3 2) = 1 := by
  apply le_antisymm
  · refine (domNum_le_card (P := {0}) fun q => ⟨0, mem_singleton_self 0, ?_⟩).trans (by simp)
    show Hears (gprod cycle3 (gprod cycle3 (gprodList []))) q 0
    rw [hears_gprod]
    simp only [hears_gprod, hears_gprodList_nil]
    fin_cases q
    · exact ⟨0, Or.inl rfl, 0, Or.inl rfl, rfl⟩
    · exact ⟨1, Or.inr rfl, 1, Or.inl rfl, rfl⟩
    · exact ⟨1, Or.inr rfl, 2, Or.inr rfl, rfl⟩
  · obtain ⟨P, hP, hcard⟩ := exists_dominating_card_domNum (gpow cycle3 2)
    rw [← hcard, Nat.one_le_iff_ne_zero, Ne, card_eq_zero]
    rintro rfl
    obtain ⟨p, hp, -⟩ := hP 0
    simp at hp

/-- **Theorem 6.10 as stated is false.** For the directed 3-cycle, `γ(G) = 2`, so Theorem 6.10
claims that consensus (`(γ(G) - 1)`-set agreement) is not solvable on `↑G` in `r` rounds by an
oblivious algorithm, for every `r > 0`; but after `r = 2` rounds everybody knows every input, and
consensus is solvable. -/
theorem theorem_6_10_false [LinearOrder V] [Nonempty V] :
    domNum cycle3 - 1 = 1 ∧ ObliviousSolvable V 2 (domNum cycle3 - 1) (closedAbove {cycle3}) ∧
      ¬ ∀ r > 0, ¬ ObliviousSolvable V r (domNum cycle3 - 1) (closedAbove {cycle3}) := by
  have h : ObliviousSolvable V 2 (domNum cycle3 - 1) (closedAbove {cycle3}) := by
    rw [domNum_cycle3, show 2 - 1 = domNum (gpow cycle3 2) from domNum_gpow_cycle3.symm]
    exact theorem_6_3 cycle3 2
  exact ⟨by rw [domNum_cycle3], h, fun hall => hall 2 (by norm_num) h⟩

/-- The statement of Theorem 6.11 for generators `S` and `r` rounds. -/
def Theorem611Statement (V : Type*) (S : Set (Graph α)) (r : ℕ) : Prop :=
  ∀ k : ℕ, (k : ℤ) = thm54L (powSet S r) + 1 → ¬ ObliviousSolvable V r k (closedAbove S)

omit [Fintype α] in
/-- Powers of a star are stars. -/
theorem isStarAt_gpow {G : Graph α} {c : α} (hG : IsStarAt G c) {r : ℕ} (hr : 0 < r) :
    IsStarAt (gpow G r) c := by
  have hG' : ∀ a b, Hears G a b ↔ b = a ∨ b = c := hG
  obtain ⟨r, rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
  induction r with
  | zero =>
    intro q p
    show Hears (gprod G (gprodList [])) q p ↔ _
    rw [hears_gprod]
    simp only [hears_gprodList_nil, hG']
    constructor
    · rintro ⟨w, h, rfl⟩; exact h
    · intro h; exact ⟨q, h, rfl⟩
  | succ r ih =>
    intro q p
    have ih' : ∀ a b, Hears (gpow G (r + 1)) a b ↔ b = a ∨ b = c := ih (by omega)
    show Hears (gprod G (gpow G (r + 1))) q p ↔ _
    rw [hears_gprod]
    simp only [hG', ih']
    constructor
    · rintro ⟨w, h₁ | h₁, h₂ | h₂⟩ <;> subst_vars <;> simp
    · rintro (rfl | rfl)
      · exact ⟨p, Or.inl rfl, Or.inl rfl⟩
      · exact ⟨q, Or.inr rfl, Or.inl rfl⟩

/-- **Theorem 6.11 is false.** For the star `G` with center `c`, `n ≥ 2` and every `r > 0`,
`S^r = {G^r}` with `G^r` a star, so `l = n - 2` and Theorem 6.11 claims that `(n-1)`-set agreement
is not solvable in `r` rounds; but consensus is solvable in `r` rounds. -/
theorem theorem_6_11_false [LinearOrder V] [Nonempty V] (c : α) (hn : 2 ≤ Fintype.card α)
    {r : ℕ} (hr : 0 < r) :
    thm54L (powSet {starGraph {c}} r) = (Fintype.card α : ℤ) - 2 ∧
      ObliviousSolvable V r 1 (closedAbove {starGraph {c}}) ∧
      ¬ Theorem611Statement V {starGraph {c}} r := by
  have hG := isStarAt_gpow (isStarAt_starGraph c) hr
  have hL : thm54L (powSet {starGraph {c}} r) = (Fintype.card α : ℤ) - 2 := by
    rw [powSet_singleton]; exact hG.thm54L
  obtain ⟨δ, hδ⟩ := theorem_6_3 (V := V) (starGraph {c}) r
  have h1 : ObliviousSolvable V r 1 (closedAbove {starGraph {c}}) :=
    ⟨δ, fun Gs hl hGs x => ⟨(hδ Gs hl hGs x).1, (hδ Gs hl hGs x).2.trans hG.domNum_le⟩⟩
  refine ⟨hL, h1, fun h => h (Fintype.card α - 1) ?_ ?_⟩
  · rw [hL]; push_cast [show 1 ≤ Fintype.card α by omega]; ring
  · obtain ⟨δ', hδ'⟩ := h1
    exact ⟨δ', fun Gs hl hGs x => ⟨(hδ' Gs hl hGs x).1, (hδ' Gs hl hGs x).2.trans (by omega)⟩⟩

end Lower

end Podc.RoundBasedKSetTopology
