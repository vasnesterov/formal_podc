import Mathlib

/-!
# Labels, configurations and condensed configurations

Brandt–Olivetti, *Truly Tight-in-Δ Bounds for Bipartite Maximal Matching and Variants*, PODC 2020,
§2.2.

* A *configuration* of a node of degree `Δ` is the multiset of the `Δ` labels on its incident
  edges. A node holding the port-indexed tuple `f : Fin Δ → L` has configuration `mset f`.
* A *condensed configuration* `[S₁]^{n₁} ⋯ [S_r]^{n_r}` (a "regular expression" in the paper) is a
  list of blocks `(S_i, n_i)`; it generates the multisets `m₁ + ⋯ + m_r` with `|m_i| = n_i` and all
  elements of `m_i` in `S_i` (`Cond.Gen`). A constraint is a finite union of these (`Cond.Gens`).

Generic tools:
* `rel_mset_iff`: choices of one element per set ↔ `Multiset.Rel`;
* `Cond.gen_lift`: existential lifting of a condensed configuration along a relation (the
  computation behind Observation 2.2);
* `exists_perm_lt_card`: sort ports by a key (used to build configurations with exact label counts);
* label counting for the five labels of the paper.
-/

-- CSLib candidate (bipartite round elimination infrastructure)
namespace TightBipartiteMatching

open Finset

/-- The output labels of §4: `M` (matched), `Z`, `P` (pointer), `O`, `X` (wildcard). -/
inductive Lab
  | M | Z | P | O | X
  deriving DecidableEq, Repr, Inhabited

instance : Fintype Lab := ⟨{.M, .Z, .P, .O, .X}, fun x => by cases x <;> simp⟩

/-- The configuration (multiset of labels) of a port-indexed tuple. -/
def mset {L : Type*} {n : ℕ} (f : Fin n → L) : Multiset L := Finset.univ.val.map f

@[simp] theorem card_mset {L : Type*} {n : ℕ} (f : Fin n → L) : Multiset.card (mset f) = n := by
  simp [mset]

theorem mem_mset {L : Type*} {n : ℕ} {f : Fin n → L} {x : L} : x ∈ mset f ↔ ∃ k, f k = x := by
  simp [mset]

theorem mset_succ {L : Type*} {n : ℕ} (f : Fin (n + 1) → L) :
    mset f = f 0 ::ₘ mset (fun i => f i.succ) := by
  simp only [mset, Fin.univ_val_map, List.ofFn_succ, Multiset.cons_coe]

/-- Reindexing a tuple by a permutation does not change its configuration. -/
theorem mset_comp_equiv {L : Type*} {n : ℕ} (f : Fin n → L) (σ : Fin n ≃ Fin n) :
    mset (f ∘ σ) = mset f := by
  simp only [mset, ← Multiset.map_map, Multiset.map_univ_val_equiv]

theorem mset_eq_map_range {L : Type*} {n : ℕ} (τ : ℕ → L) :
    mset (fun p : Fin n => τ p.val) = (Multiset.range n).map τ := by
  rw [mset, Fin.univ_val_map, ← Multiset.coe_range, Multiset.map_coe]
  congr 1
  exact List.ext_getElem (by simp) (by simp)

theorem count_mset {L : Type*} [DecidableEq L] {n : ℕ} (f : Fin n → L) (ℓ : L) :
    (mset f).count ℓ = #{k | f k = ℓ} := by
  simp only [mset, Multiset.count_map, Finset.card_def, Finset.filter_val]
  congr 1
  exact Multiset.filter_congr fun _ _ => eq_comm

theorem countP_mset {L : Type*} {n : ℕ} (f : Fin n → L) (p : L → Prop) [DecidablePred p] :
    (mset f).countP p = #{k | p (f k)} := by
  simp only [mset, Multiset.countP_map, Finset.card_def, Finset.filter_val]

/-! ### Choices of one element per set -/

/-- A multiset `m'` is a choice from the configuration `mset g` (one element `r`-related to each
entry) iff it is the configuration of a port-wise choice. -/
theorem rel_mset_iff {α β : Type*} {r : α → β → Prop} {n : ℕ} {g : Fin n → β} {m' : Multiset α} :
    Multiset.Rel r m' (mset g) ↔ ∃ f : Fin n → α, (∀ k, r (f k) (g k)) ∧ m' = mset f := by
  constructor
  · induction n generalizing m' with
    | zero =>
      intro h
      simp only [mset, Finset.univ_eq_empty, Finset.empty_val, Multiset.map_zero,
        Multiset.rel_zero_right] at h
      exact ⟨Fin.elim0, fun k => k.elim0, by simp [h, mset]⟩
    | succ n ih =>
      intro h
      rw [mset_succ, Multiset.rel_cons_right] at h
      obtain ⟨a, as', ha, has, rfl⟩ := h
      obtain ⟨f', hf', rfl⟩ := ih has
      refine ⟨Fin.cons a f', fun k => Fin.cases ha (fun i => hf' i) k, ?_⟩
      rw [mset_succ]; simp
  · rintro ⟨f, hf, rfl⟩
    rw [mset, mset, Multiset.rel_map]
    exact Multiset.rel_refl_of_refl_on fun k _ => hf k

theorem rel_mset_of {α β : Type*} {r : α → β → Prop} {n : ℕ} {g : Fin n → β} {f : Fin n → α}
    (h : ∀ k, r (f k) (g k)) : Multiset.Rel r (mset f) (mset g) :=
  rel_mset_iff.2 ⟨f, h, rfl⟩

/-! ### Condensed configurations -/

/-- A condensed configuration `[S₁]^{n₁} ⋯ [S_r]^{n_r}`: a list of blocks `(S_i, n_i)`. -/
abbrev Cond (L : Type*) := List (Set L × ℕ)

namespace Cond

variable {L L' : Type*}

/-- The single configurations generated by a condensed configuration: sums `m₁ + ⋯ + m_r` with
`|m_i| = n_i` and every element of `m_i` in `S_i`. -/
def Gen (c : Cond L) : Set (Multiset L) :=
  {m | ∃ ms : List (Multiset L),
    List.Forall₂ (fun mi b => Multiset.card mi = b.2 ∧ ∀ x ∈ mi, x ∈ b.1) ms c ∧ m = ms.sum}

/-- The constraint given by a list of condensed configurations. -/
def Gens (cs : List (Cond L)) : Set (Multiset L) := {m | ∃ c ∈ cs, m ∈ Gen c}

@[simp] theorem gen_nil {m : Multiset L} : m ∈ Gen ([] : Cond L) ↔ m = 0 := by
  simp [Gen]

theorem gen_cons {S : Set L} {n : ℕ} {c : Cond L} {m : Multiset L} :
    m ∈ Gen ((S, n) :: c) ↔
      ∃ m₁ m₂, m = m₁ + m₂ ∧ Multiset.card m₁ = n ∧ (∀ x ∈ m₁, x ∈ S) ∧ m₂ ∈ Gen c := by
  constructor
  · rintro ⟨_ | ⟨m₁, ms⟩, h, rfl⟩
    · cases h
    · rcases List.forall₂_cons.1 h with ⟨⟨h1, h2⟩, h3⟩
      exact ⟨m₁, ms.sum, by simp, h1, h2, ms, h3, rfl⟩
  · rintro ⟨m₁, m₂, rfl, h1, h2, ms, h3, rfl⟩
    exact ⟨m₁ :: ms, List.Forall₂.cons ⟨h1, h2⟩ h3, by simp⟩

@[simp] theorem mem_gens {cs : List (Cond L)} {m : Multiset L} :
    m ∈ Gens cs ↔ ∃ c ∈ cs, m ∈ Gen c := Iff.rfl

theorem gen_card {c : Cond L} {m : Multiset L} (h : m ∈ Gen c) :
    Multiset.card m = (c.map Prod.snd).sum := by
  induction c generalizing m with
  | nil => simp_all
  | cons b c ih =>
    obtain ⟨S, n⟩ := b
    obtain ⟨m₁, m₂, rfl, h1, -, h3⟩ := gen_cons.1 h
    simp [h1, ih h3]

/-- Enlarging the blocks keeps generated configurations. -/
theorem gen_mono {c c' : Cond L}
    (h : List.Forall₂ (fun b b' : Set L × ℕ => b.1 ⊆ b'.1 ∧ b.2 = b'.2) c c')
    {m : Multiset L} (hm : m ∈ Gen c) : m ∈ Gen c' := by
  induction h generalizing m with
  | nil => exact hm
  | @cons b b' c c' hb _ ih =>
    obtain ⟨S, n⟩ := b; obtain ⟨S', n'⟩ := b'
    obtain ⟨hS, rfl⟩ := hb
    obtain ⟨m₁, m₂, rfl, h1, h2, h3⟩ := gen_cons.1 hm
    exact gen_cons.2 ⟨m₁, m₂, rfl, h1, fun x hx => hS (h2 x hx), ih h3⟩

/-- The existential lift of a condensed configuration along a relation `R`: block `[S]` becomes
`[{y | ∃ x ∈ S, R x y}]`. -/
def lift (R : L → L' → Prop) (c : Cond L) : Cond L' :=
  c.map fun b => ({y | ∃ x ∈ b.1, R x y}, b.2)

/-- **Existential lifting** (the computation behind Observation 2.2): if `m ∈ Gen c` and `m'` is
related to `m` elementwise by `R`, then `m'` is generated by the lifted configuration. -/
theorem gen_lift {R : L → L' → Prop} {c : Cond L} {m : Multiset L} {m' : Multiset L'}
    (hm : m ∈ Gen c) (hR : Multiset.Rel R m m') : m' ∈ Gen (lift R c) := by
  induction c generalizing m m' with
  | nil =>
    rw [gen_nil] at hm; subst hm
    rw [Multiset.rel_zero_left] at hR; subst hR
    simp [lift]
  | cons b c ih =>
    obtain ⟨S, n⟩ := b
    obtain ⟨m₁, m₂, rfl, h1, h2, h3⟩ := gen_cons.1 hm
    obtain ⟨m₁', m₂', hr1, hr2, rfl⟩ := Multiset.rel_add_left.1 hR
    refine gen_cons.2 ⟨m₁', m₂', rfl, ?_, ?_, ih h3 hr2⟩
    · rw [← Multiset.card_eq_card_of_rel hr1, h1]
    · intro y hy
      obtain ⟨x, hx, hxy⟩ := Multiset.exists_mem_of_rel_of_mem (Multiset.rel_flip.2 hr1) hy
      exact ⟨x, h2 x hx, hxy⟩

/-- Lifting a constraint (a union of condensed configurations). -/
theorem gens_lift {R : L → L' → Prop} {cs : List (Cond L)} {m : Multiset L} {m' : Multiset L'}
    (hm : m ∈ Gens cs) (hR : Multiset.Rel R m m') : m' ∈ Gens (cs.map (lift R)) := by
  obtain ⟨c, hc, hmc⟩ := hm
  exact ⟨lift R c, List.mem_map_of_mem hc, gen_lift hmc hR⟩

/-- A configuration consisting of exact multiplicities of single labels. -/
theorem replicate_mem_gen (c : List (L × ℕ)) :
    (c.map fun b => Multiset.replicate b.2 b.1).sum ∈ Gen (c.map fun b => ({b.1}, b.2)) := by
  induction c with
  | nil => simp
  | cons b c ih =>
    simp only [List.map_cons, List.sum_cons]
    exact gen_cons.2 ⟨_, _, rfl, by simp, fun x hx => by simp [Multiset.eq_of_mem_replicate hx], ih⟩

end Cond

/-! ### Sorting ports by a key -/

/-- Ports can be sorted by a key `κ`, with larger keys first: there is a bijection `σ` (port ↦
position) such that the position of `k` is less than the number of ports whose key is `≥ κ k`. -/
theorem exists_perm_lt_card {n : ℕ} (κ : Fin n → ℕ) :
    ∃ σ : Fin n ≃ Fin n, ∀ k, (σ k : ℕ) < #{k' | κ k ≤ κ k'} := by
  classical
  set f : Fin n → ℕᵒᵈ := fun k => OrderDual.toDual (κ k)
  set π := Tuple.sort f
  have hmono := Tuple.monotone_sort f
  refine ⟨π.symm, fun k => ?_⟩
  set p := π.symm k
  have hk : π p = k := by simp [p]
  have hsub : (Finset.Iic p).map π.toEmbedding ⊆ Finset.univ.filter (fun k' => κ k ≤ κ k') := by
    intro k' hk'
    simp only [Finset.mem_map, Finset.mem_Iic, Equiv.toEmbedding_apply] at hk'
    obtain ⟨q, hq, rfl⟩ := hk'
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [← hk]
    exact hmono hq
  have := Finset.card_le_card hsub
  rw [Finset.card_map, Fin.card_Iic] at this
  omega

/-- A tuple whose entries, read in the order given by a permutation, follow a threshold pattern
has the threshold pattern's configuration. -/
theorem mset_threshold {L : Type*} {n : ℕ} (τ : ℕ → L) (σ : Fin n ≃ Fin n) :
    mset (fun k => τ (σ k)) = (Multiset.range n).map τ := by
  rw [show (fun k => τ (σ k).val) = (fun p : Fin n => τ p.val) ∘ σ from rfl, mset_comp_equiv,
    mset_eq_map_range]

/-- `map τ (range n)` for a three-step threshold function. -/
theorem map_range_threshold3 {L : Type*} (a b c : ℕ) (ℓ₁ ℓ₂ ℓ₃ : L) :
    (Multiset.range (a + b + c)).map
        (fun p => if p < a then ℓ₁ else if p < a + b then ℓ₂ else ℓ₃) =
      Multiset.replicate a ℓ₁ + Multiset.replicate b ℓ₂ + Multiset.replicate c ℓ₃ := by
  rw [Multiset.range_add, Multiset.range_add, Multiset.map_add, Multiset.map_add,
    Multiset.map_map, Multiset.map_map]
  congr 1; congr 1
  · refine Multiset.eq_replicate.2 ⟨by simp, fun x hx => ?_⟩
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.1 hx
    simp [Multiset.mem_range.1 hp]
  · refine Multiset.eq_replicate.2 ⟨by simp, fun x hx => ?_⟩
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.1 hx
    have := Multiset.mem_range.1 hp
    simp only [Function.comp]
    split_ifs <;> first | rfl | omega
  · refine Multiset.eq_replicate.2 ⟨by simp, fun x hx => ?_⟩
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.1 hx
    simp only [Function.comp]
    split_ifs <;> first | rfl | omega

/-! ### Counting the five labels -/

theorem card_eq_counts (m : Multiset Lab) :
    Multiset.card m = m.count .M + m.count .Z + m.count .P + m.count .O + m.count .X := by
  induction m using Multiset.induction with
  | empty => simp
  | cons a m ih => cases a <;> simp [ih] <;> omega

/-- Label counts of one block of a condensed configuration. -/
theorem block_counts {S : Set Lab} {n : ℕ} {m : Multiset Lab}
    (h1 : Multiset.card m = n) (h2 : ∀ x ∈ m, x ∈ S) :
    m.count .M + m.count .Z + m.count .P + m.count .O + m.count .X = n ∧
      (Lab.M ∉ S → m.count .M = 0) ∧ (Lab.Z ∉ S → m.count .Z = 0) ∧
      (Lab.P ∉ S → m.count .P = 0) ∧ (Lab.O ∉ S → m.count .O = 0) ∧
      (Lab.X ∉ S → m.count .X = 0) := by
  refine ⟨(card_eq_counts m).symm.trans h1, ?_, ?_, ?_, ?_, ?_⟩ <;>
    exact fun hS => Multiset.count_eq_zero.2 fun hm => hS (h2 _ hm)

/-- Label counts of a configuration generated by a two-block condensed configuration. -/
theorem gen2_counts {S₁ S₂ : Set Lab} {n₁ n₂ : ℕ} {m : Multiset Lab}
    (h : m ∈ Cond.Gen [(S₁, n₁), (S₂, n₂)]) :
    ∃ m₁ m₂ : Multiset Lab, m = m₁ + m₂ ∧
      (m₁.count .M + m₁.count .Z + m₁.count .P + m₁.count .O + m₁.count .X = n₁ ∧
        (Lab.M ∉ S₁ → m₁.count .M = 0) ∧ (Lab.Z ∉ S₁ → m₁.count .Z = 0) ∧
        (Lab.P ∉ S₁ → m₁.count .P = 0) ∧ (Lab.O ∉ S₁ → m₁.count .O = 0) ∧
        (Lab.X ∉ S₁ → m₁.count .X = 0)) ∧
      (m₂.count .M + m₂.count .Z + m₂.count .P + m₂.count .O + m₂.count .X = n₂ ∧
        (Lab.M ∉ S₂ → m₂.count .M = 0) ∧ (Lab.Z ∉ S₂ → m₂.count .Z = 0) ∧
        (Lab.P ∉ S₂ → m₂.count .P = 0) ∧ (Lab.O ∉ S₂ → m₂.count .O = 0) ∧
        (Lab.X ∉ S₂ → m₂.count .X = 0)) := by
  obtain ⟨m₁, r, rfl, h1, h2, hr⟩ := Cond.gen_cons.1 h
  obtain ⟨m₂, r', rfl, h1', h2', hr'⟩ := Cond.gen_cons.1 hr
  rw [Cond.gen_nil] at hr'; subst hr'
  exact ⟨m₁, m₂, by simp, block_counts h1 h2, block_counts h1' h2'⟩

/-- Label counts of a configuration generated by a three-block condensed configuration. -/
theorem gen3_counts {S₁ S₂ S₃ : Set Lab} {n₁ n₂ n₃ : ℕ} {m : Multiset Lab}
    (h : m ∈ Cond.Gen [(S₁, n₁), (S₂, n₂), (S₃, n₃)]) :
    ∃ m₁ m₂ m₃ : Multiset Lab, m = m₁ + m₂ + m₃ ∧
      (m₁.count .M + m₁.count .Z + m₁.count .P + m₁.count .O + m₁.count .X = n₁ ∧
        (Lab.M ∉ S₁ → m₁.count .M = 0) ∧ (Lab.Z ∉ S₁ → m₁.count .Z = 0) ∧
        (Lab.P ∉ S₁ → m₁.count .P = 0) ∧ (Lab.O ∉ S₁ → m₁.count .O = 0) ∧
        (Lab.X ∉ S₁ → m₁.count .X = 0)) ∧
      (m₂.count .M + m₂.count .Z + m₂.count .P + m₂.count .O + m₂.count .X = n₂ ∧
        (Lab.M ∉ S₂ → m₂.count .M = 0) ∧ (Lab.Z ∉ S₂ → m₂.count .Z = 0) ∧
        (Lab.P ∉ S₂ → m₂.count .P = 0) ∧ (Lab.O ∉ S₂ → m₂.count .O = 0) ∧
        (Lab.X ∉ S₂ → m₂.count .X = 0)) ∧
      (m₃.count .M + m₃.count .Z + m₃.count .P + m₃.count .O + m₃.count .X = n₃ ∧
        (Lab.M ∉ S₃ → m₃.count .M = 0) ∧ (Lab.Z ∉ S₃ → m₃.count .Z = 0) ∧
        (Lab.P ∉ S₃ → m₃.count .P = 0) ∧ (Lab.O ∉ S₃ → m₃.count .O = 0) ∧
        (Lab.X ∉ S₃ → m₃.count .X = 0)) := by
  obtain ⟨m₁, r, rfl, h1, h2, hr⟩ := Cond.gen_cons.1 h
  obtain ⟨m₂, m₃, rfl, h1', h2', hr'⟩ := Cond.gen_cons.1 hr
  obtain ⟨m₃', r'', rfl, h1'', h2'', hr''⟩ := Cond.gen_cons.1 hr'
  rw [Cond.gen_nil] at hr''; subst hr''
  exact ⟨m₁, m₂, m₃', by simp [add_assoc], block_counts h1 h2, block_counts h1' h2',
    block_counts h1'' h2''⟩

end TightBipartiteMatching
