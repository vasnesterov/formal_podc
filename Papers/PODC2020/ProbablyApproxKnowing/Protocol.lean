import Papers.PODC2020.ProbablyApproxKnowing.Basic
import Cslib.Probability.Finite.Product

/-!
# Systems generated by joint probabilistic protocols (§2.2) and Lemma 4.3(b)

A joint protocol (§2.2 of [Moses–Zamir]) consists of a distribution over finitely many initial global
states, local-state functions, a probabilistic protocol `prot p` for every participant `p` (the agents
and the environment), mapping the local state (including the current time) to a distribution over
`p`'s actions, and a transition function mapping a global state and a joint action to the successor
state. At every step all participants choose their actions independently. We run the protocol for a
fixed number `N` of rounds; the runs are the action sequences of positive probability, so that two
runs with the same initial state and the same actions up to time `t` pass through the same node of
the tree at time `t` (this is the paper's assumption that the environment records the history of
actions, §2.2).

* `JointProtocol.toPPS`: the pps generated by a joint protocol;
* `JointProtocol.lsi_of_indepOwnAction`: if a fact `φ` at time `t` depends only on the history up to
  time `t` and on the actions of the *other* participants at time `t`, then `φ` is local-state
  independent of every action of `i`;
* `JointProtocol.lemma_4_3b`: **Lemma 4.3(b)**: past-based facts are local-state independent of every
  proper action.
-/

noncomputable section

set_option linter.unusedSectionVars false

open Classical Finset

namespace Podc.ProbablyApproxKnowing

-- CSLib candidate (run distributions of synchronous probabilistic protocols)
/-- A joint probabilistic protocol: participants `P` (agents and environment), actions `Act p`,
global states `G` and local states `L`. The local state of `p` at time `t` in global state `g` is
`(t, loc p g)`; its protocol `prot p t (loc p g)` is a distribution over `Act p`. -/
structure JointProtocol (P : Type*) (Act : P → Type*) [∀ p, Fintype (Act p)] (G L : Type*)
    [Fintype G] where
  /-- The distribution over initial global states. -/
  init : G → ℝ
  init_nonneg : ∀ g, 0 ≤ init g
  sum_init : ∑ g, init g = 1
  /-- Local states. -/
  loc : P → G → L
  /-- The probabilistic protocol of each participant (as a function of its local state, including
  the current time). -/
  prot : (p : P) → ℕ → L → Act p → ℝ
  prot_nonneg : ∀ p t ℓ a, 0 ≤ prot p t ℓ a
  sum_prot : ∀ p t ℓ, ∑ a, prot p t ℓ a = 1
  /-- The transition function (time-dependent for convenience). -/
  τ : ℕ → G → ((p : P) → Act p) → G

namespace JointProtocol

variable {P : Type*} [Fintype P] {Act : P → Type*} [∀ p, Fintype (Act p)] {G L : Type*}
  [Fintype G] (pr : JointProtocol P Act G L)

/-- Joint actions. -/
abbrev JAct (Act : P → Type*) := (p : P) → Act p

/-- The probability of the joint action `a` at time `t` in state `g` (independent choices). -/
def jp (t : ℕ) (g : G) (a : JAct Act) : ℝ := ∏ p, pr.prot p t (pr.loc p g) (a p)

/-- The state after `k` steps of an `n`-step action sequence started in `g` at time `t₀`. -/
def stateAux : (n : ℕ) → ℕ → G → (Fin n → JAct Act) → ℕ → G
  | 0, _, g, _, _ => g
  | _ + 1, _, g, _, 0 => g
  | n + 1, t₀, g, as, k + 1 => stateAux n (t₀ + 1) (pr.τ t₀ g (as 0)) (Fin.tail as) k

/-- The probability of an `n`-step action sequence started in `g` at time `t₀`. -/
def weightAux : (n : ℕ) → ℕ → G → (Fin n → JAct Act) → ℝ
  | 0, _, _, _ => 1
  | n + 1, t₀, g, as => pr.jp t₀ g (as 0) * weightAux n (t₀ + 1) (pr.τ t₀ g (as 0)) (Fin.tail as)

theorem sum_cons {n : ℕ} (f : (Fin (n + 1) → JAct Act) → ℝ) :
    ∑ as, f as = ∑ a, ∑ as' : Fin n → JAct Act, f (Fin.cons a as') := by
  rw [← (Fin.consEquiv (fun _ => JAct Act)).sum_comp, Fintype.sum_prod_type]
  rfl

theorem weightAux_cons (n t₀ : ℕ) (g : G) (a : JAct Act) (as : Fin n → JAct Act) :
    pr.weightAux (n + 1) t₀ g (Fin.cons a as) =
      pr.jp t₀ g a * pr.weightAux n (t₀ + 1) (pr.τ t₀ g a) as := by
  simp [weightAux]

theorem stateAux_cons_succ (n t₀ : ℕ) (g : G) (a : JAct Act) (as : Fin n → JAct Act) (k : ℕ) :
    pr.stateAux (n + 1) t₀ g (Fin.cons a as) (k + 1) =
      pr.stateAux n (t₀ + 1) (pr.τ t₀ g a) as k := by
  simp [stateAux]

theorem stateAux_zero (n t₀ : ℕ) (g : G) (as : Fin n → JAct Act) : pr.stateAux n t₀ g as 0 = g := by
  cases n <;> rfl

theorem jp_nonneg (t : ℕ) (g : G) (a : JAct Act) : 0 ≤ pr.jp t g a :=
  prod_nonneg fun _ _ => pr.prot_nonneg _ _ _ _

theorem sum_jp (t : ℕ) (g : G) : ∑ a : JAct Act, pr.jp t g a = 1 := by
  unfold jp
  rw [← Fintype.prod_sum (fun p a => pr.prot p t (pr.loc p g) a)]
  exact prod_eq_one fun p _ => pr.sum_prot p t _

theorem weightAux_nonneg : ∀ (n t₀ : ℕ) (g : G) (as : Fin n → JAct Act),
    0 ≤ pr.weightAux n t₀ g as
  | 0, _, _, _ => zero_le_one
  | n + 1, _, _, _ => mul_nonneg (pr.jp_nonneg _ _ _) (weightAux_nonneg n _ _ _)

theorem sum_weightAux : ∀ (n t₀ : ℕ) (g : G), ∑ as : Fin n → JAct Act, pr.weightAux n t₀ g as = 1
  | 0, _, _ => by simp [weightAux]
  | n + 1, t₀, g => by
    rw [sum_cons]
    simp_rw [weightAux_cons, ← mul_sum, sum_weightAux n, mul_one, sum_jp]

/-- The state at step `k` depends only on the actions before step `k`. -/
theorem stateAux_congr : ∀ (n t₀ : ℕ) (g : G) (as as' : Fin n → JAct Act) (k : ℕ),
    (∀ m : Fin n, m.val < k → as m = as' m) → pr.stateAux n t₀ g as k = pr.stateAux n t₀ g as' k
  | 0, _, _, _, _, _, _ => rfl
  | _ + 1, _, _, _, _, 0, _ => rfl
  | n + 1, t₀, g, as, as', k + 1, h => by
    have h0 : as 0 = as' 0 := h 0 (Nat.succ_pos _)
    simp only [stateAux, h0]
    exact stateAux_congr n _ _ _ _ k fun m hm => h m.succ (by simpa using hm)

/-- One step: the action of `i` is chosen independently of everything else. -/
theorem sum_jp_mul_ind (t : ℕ) (g : G) (i : P) (α : Act i) (H : JAct Act → ℝ)
    (hH : ∀ a b, H (Function.update a i b) = H a) :
    ∑ a, pr.jp t g a * ((if a i = α then 1 else 0) * H a) =
      pr.prot i t (pr.loc i g) α * ∑ a, pr.jp t g a * H a := by
  set μ : ∀ p, Act p → ℝ := fun p => pr.prot p t (pr.loc p g)
  have hjp : ∀ a, pr.jp t g a = Cslib.Probability.piWeight μ a := fun _ => rfl
  simp only [hjp]
  change Cslib.Probability.piExpect μ _ = μ i α * Cslib.Probability.piExpect μ H
  rw [← Cslib.Probability.sum_mul_piExpect_update_single μ i]
  have hcond : ∀ b, Cslib.Probability.piExpect (Function.update μ i (Pi.single b 1))
      (fun a => (if a i = α then 1 else 0) * H a) =
      (if b = α then 1 else 0) * Cslib.Probability.piExpect μ H := by
    intro b
    rw [← Cslib.Probability.piExpect_update_single_of_forall_update i (pr.sum_prot i t _) hH b,
      ← Cslib.Probability.piExpect_mul_left]
    refine Cslib.Probability.piExpect_congr fun a ha => ?_
    rw [Cslib.Probability.piWeight_update] at ha
    have : a i = b := by
      by_contra hne
      exact ha (by simp [hne])
    simp [this]
  simp only [hcond]
  rw [Finset.sum_eq_single α]
  · simp
  · intro b _ hb; simp [hb]
  · simp

-- CSLib candidate
/-- **Markov property.** If `F` depends only on the actions before step `k` and on the actions of
the participants other than `i` at step `k`, and `F ≠ 0` only where `i`'s local state at step `k`
is `ℓ`, then conditioning on `i`'s action at step `k` being `α` multiplies by `prot i (t₀+k) ℓ α`. -/
theorem sum_weightAux_mul_ind (i : P) (α : Act i) (ℓ : L) : ∀ (n t₀ : ℕ) (g : G) (k : ℕ)
    (hk : k < n) (F : (Fin n → JAct Act) → ℝ),
    (∀ as as', (∀ m : Fin n, m.val < k → as m = as' m) →
      (∀ q, q ≠ i → as ⟨k, hk⟩ q = as' ⟨k, hk⟩ q) → F as = F as') →
    (∀ as, F as ≠ 0 → pr.loc i (pr.stateAux n t₀ g as k) = ℓ) →
    ∑ as, pr.weightAux n t₀ g as * (F as * if as ⟨k, hk⟩ i = α then 1 else 0) =
      pr.prot i (t₀ + k) ℓ α * ∑ as, pr.weightAux n t₀ g as * F as
  | 0, _, _, _, hk, _, _, _ => absurd hk (Nat.not_lt_zero _)
  | n + 1, t₀, g, 0, hk, F, hF, hsupp => by
    -- `F (cons a as')` only depends on `a`
    set F0 : JAct Act → ℝ := fun a => F (Fin.cons a (fun _ => a))
    have hF0 : ∀ a (as' : Fin n → JAct Act), F (Fin.cons a as') = F0 a := fun a as' =>
      hF _ _ (fun m hm => absurd hm (Nat.not_lt_zero _)) (fun _ _ => rfl)
    have hH : ∀ a b, F0 (Function.update a i b) = F0 a := fun a b =>
      hF _ _ (fun m hm => absurd hm (Nat.not_lt_zero _))
        (fun q hq => by simp [Function.update_of_ne hq])
    have h0 : (⟨0, hk⟩ : Fin (n + 1)) = 0 := rfl
    rw [sum_cons, sum_cons]
    simp_rw [weightAux_cons, hF0, h0, Fin.cons_zero, mul_assoc, ← mul_sum]
    have hs : ∀ a, ∑ as' : Fin n → JAct Act, pr.weightAux n (t₀ + 1) (pr.τ t₀ g a) as' *
        (F0 a * if a i = α then 1 else 0) = (if a i = α then 1 else 0) * F0 a := fun a => by
      rw [← sum_mul, sum_weightAux, one_mul, mul_comm]
    have hs' : ∀ a, ∑ as' : Fin n → JAct Act, pr.weightAux n (t₀ + 1) (pr.τ t₀ g a) as' * F0 a =
        F0 a := fun a => by rw [← sum_mul, sum_weightAux, one_mul]
    simp_rw [hs, hs']
    rw [sum_jp_mul_ind pr t₀ g i α F0 hH, add_zero]
    by_cases hex : ∃ a, F0 a ≠ 0
    · obtain ⟨a, ha⟩ := hex
      have := hsupp (Fin.cons a (fun _ => a)) ha
      rw [stateAux_zero] at this
      rw [this]
    · push Not at hex
      simp [hex]
  | n + 1, t₀, g, k + 1, hk, F, hF, hsupp => by
    have hkk : (⟨k + 1, hk⟩ : Fin (n + 1)) = Fin.succ ⟨k, by omega⟩ := rfl
    have IH := fun a => sum_weightAux_mul_ind i α ℓ n (t₀ + 1) (pr.τ t₀ g a) k (by omega)
      (fun as' => F (Fin.cons a as'))
      (fun as as' h1 h2 => hF _ _ (fun m hm => by
          cases m using Fin.cases with
          | zero => rfl
          | succ m => simpa using h1 m (by simpa using hm))
        (fun q hq => by rw [hkk, Fin.cons_succ, Fin.cons_succ]; exact h2 q hq))
      (fun as' h => by rw [← stateAux_cons_succ]; exact hsupp _ h)
    rw [sum_cons, sum_cons, mul_sum]
    refine sum_congr rfl fun a _ => ?_
    simp_rw [weightAux_cons, hkk, Fin.cons_succ, mul_assoc, ← mul_sum]
    rw [IH a, show t₀ + 1 + k = t₀ + (k + 1) by omega]
    ring

/-! ### The pps generated by a joint protocol -/

/-- The probability of the run with initial state `ω.1` and joint actions `ω.2` (rounds `0, …, N-1`). -/
def weight (N : ℕ) (ω : G × (Fin N → JAct Act)) : ℝ := pr.init ω.1 * pr.weightAux N 0 ω.1 ω.2

/-- The global state at time `t` of the run `ω`. -/
def state (N : ℕ) (ω : G × (Fin N → JAct Act)) (t : ℕ) : G := pr.stateAux N 0 ω.1 ω.2 t

/-- The runs (of positive probability) of the protocol over `N` rounds. -/
abbrev Runs (N : ℕ) := {ω : G × (Fin N → JAct Act) // 0 < pr.weight N ω}

theorem weight_nonneg (N : ℕ) (ω : G × (Fin N → JAct Act)) : 0 ≤ pr.weight N ω :=
  mul_nonneg (pr.init_nonneg _) (pr.weightAux_nonneg _ _ _ _)

theorem sum_runs (N : ℕ) (f : G × (Fin N → JAct Act) → ℝ)
    (hf : ∀ ω, pr.weight N ω = 0 → f ω = 0) : ∑ r : pr.Runs N, f r.1 = ∑ ω, f ω := by
  rw [← Finset.sum_subtype (univ.filter fun ω => 0 < pr.weight N ω) (by simp) f]
  refine Finset.sum_filter_of_ne fun ω _ h => ?_
  rcases (pr.weight_nonneg N ω).eq_or_lt with h0 | h0
  · exact absurd (hf ω h0.symm) h
  · exact h0

/-- The pps generated by the joint protocol `pr` run for `N` rounds. The local state of `p` at time
`t` is `(t, loc p (state at time t))`. -/
def toPPS (N : ℕ) : PPS (pr.Runs N) P (ℕ × L) where
  μ r := pr.weight N r.1
  μ_pos r := r.2
  sum_μ := by
    rw [pr.sum_runs N (pr.weight N) fun _ h => h, Fintype.sum_prod_type]
    simp only [weight, ← mul_sum, pr.sum_weightAux, mul_one, pr.sum_init]
  len _ := N
  loc p r t := (t, pr.loc p (pr.state N r.1 t))
  sync _ _ _ _ _ _ _ h := congrArg Prod.fst h

theorem prob_eq (N : ℕ) (Q : pr.Runs N → Prop) (Q' : G × (Fin N → JAct Act) → Prop)
    [DecidablePred Q'] (h : ∀ r, Q r ↔ Q' r.1) : (pr.toPPS N).prob Q =
      ∑ g, pr.init g * ∑ as, pr.weightAux N 0 g as * (if Q' (g, as) then 1 else 0) := by
  rw [PPS.prob]
  calc ∑ r : pr.Runs N, (if Q r then (pr.toPPS N).μ r else 0)
      = ∑ r : pr.Runs N, (fun ω => if Q' ω then pr.weight N ω else 0) r.1 :=
        sum_congr rfl fun r _ => by
          by_cases hq : Q r
          · simp only [ite_eq_left hq, ite_eq_left ((h r).1 hq)]; rfl
          · simp only [ite_eq_right hq, ite_eq_right (mt (h r).2 hq)]
    _ = ∑ ω, (fun ω => if Q' ω then pr.weight N ω else 0) ω :=
        pr.sum_runs N (fun ω => if Q' ω then pr.weight N ω else 0) fun ω h0 => by simp [h0]
    _ = _ := by
        rw [Fintype.sum_prod_type]
        refine sum_congr rfl fun g _ => ?_
        rw [mul_sum]
        refine sum_congr rfl fun as _ => ?_
        simp only [weight]
        split_ifs <;> ring

/-- The fact `does_i(α)`: `i` performs `α` at time `t` (only at times `t < N`). -/
def does (N : ℕ) (i : P) (α : Act i) : Fact (pr.Runs N) :=
  fun r t => ∃ h : t < N, r.1.2 ⟨t, h⟩ i = α

/-- Two runs agree up to time `t` (they pass through the same node of the tree at time `t`). -/
def Agree (N t : ℕ) (ω ω' : G × (Fin N → JAct Act)) : Prop :=
  ω.1 = ω'.1 ∧ ∀ m : Fin N, m.val < t → ω.2 m = ω'.2 m

/-- Two runs agree up to time `t` and on the actions of all participants other than `i` at time
`t`. -/
def AgreeOff (N : ℕ) (i : P) (t : ℕ) (ω ω' : G × (Fin N → JAct Act)) : Prop :=
  Agree N t ω ω' ∧ ∀ h : t < N, ∀ q, q ≠ i → ω.2 ⟨t, h⟩ q = ω'.2 ⟨t, h⟩ q

theorem AgreeOff.refl {N : ℕ} {i : P} {t : ℕ} (ω : G × (Fin N → JAct Act)) : AgreeOff N i t ω ω :=
  ⟨⟨rfl, fun _ _ => rfl⟩, fun _ _ _ => rfl⟩

theorem AgreeOff.symm {N : ℕ} {i : P} {t : ℕ} {ω ω' : G × (Fin N → JAct Act)}
    (h : AgreeOff N i t ω ω') : AgreeOff N i t ω' ω :=
  ⟨⟨h.1.1.symm, fun m hm => (h.1.2 m hm).symm⟩, fun ht q hq => (h.2 ht q hq).symm⟩

theorem AgreeOff.trans {N : ℕ} {i : P} {t : ℕ} {ω ω' ω'' : G × (Fin N → JAct Act)}
    (h : AgreeOff N i t ω ω') (h' : AgreeOff N i t ω' ω'') : AgreeOff N i t ω ω'' :=
  ⟨⟨h.1.1.trans h'.1.1, fun m hm => (h.1.2 m hm).trans (h'.1.2 m hm)⟩,
    fun ht q hq => (h.2 ht q hq).trans (h'.2 ht q hq)⟩

/-- §4: a fact is *past-based* if its truth at time `t` depends only on the run up to time `t`. -/
def PastBased (N : ℕ) (φ : Fact (pr.Runs N)) : Prop :=
  ∀ (r r' : pr.Runs N) t, Agree N t r.1 r'.1 → (φ r t ↔ φ r' t)

/-- A fact whose truth at time `t` depends only on the run up to time `t` and on the actions of
the participants other than `i` at time `t` (e.g. "`j` is firing" for `j ≠ i`). -/
def IndepOwnAction (N : ℕ) (i : P) (φ : Fact (pr.Runs N)) : Prop :=
  ∀ (r r' : pr.Runs N) t, AgreeOff N i t r.1 r'.1 → (φ r t ↔ φ r' t)

theorem PastBased.indepOwnAction {N : ℕ} {φ : Fact (pr.Runs N)} (h : pr.PastBased N φ) (i : P) :
    pr.IndepOwnAction N i φ := fun r r' t hr => h r r' t hr.1

theorem indepOwnAction_does {N : ℕ} {i q : P} (hq : q ≠ i) (β : Act q) :
    pr.IndepOwnAction N i (pr.does N q β) := by
  rintro r r' t ⟨-, h⟩
  simp only [does]
  constructor
  · rintro ⟨ht, hb⟩; exact ⟨ht, (h ht q hq).symm.trans hb⟩
  · rintro ⟨ht, hb⟩; exact ⟨ht, (h ht q hq).trans hb⟩

theorem indepOwnAction_true (N : ℕ) (i : P) : pr.IndepOwnAction N i (fun _ _ => True) :=
  fun _ _ _ _ => Iff.rfl

theorem IndepOwnAction.and {N : ℕ} {i : P} {φ ψ : Fact (pr.Runs N)} (hφ : pr.IndepOwnAction N i φ)
    (hψ : pr.IndepOwnAction N i ψ) : pr.IndepOwnAction N i (fun r t => φ r t ∧ ψ r t) :=
  fun r r' t h => and_congr (hφ r r' t h) (hψ r r' t h)

theorem IndepOwnAction.not {N : ℕ} {i : P} {φ : Fact (pr.Runs N)} (hφ : pr.IndepOwnAction N i φ) :
    pr.IndepOwnAction N i (fun r t => ¬ φ r t) :=
  fun r r' t h => not_congr (hφ r r' t h)

theorem occurs_iff (N : ℕ) (i : P) (t₀ : ℕ) (ℓ : L) (r : pr.Runs N) :
    (pr.toPPS N).Occurs i (t₀, ℓ) r ↔ t₀ ≤ N ∧ pr.loc i (pr.state N r.1 t₀) = ℓ := by
  simp only [PPS.Occurs, toPPS, Prod.mk.injEq]
  constructor
  · rintro ⟨t, ht, rfl, hl⟩; exact ⟨ht, hl⟩
  · rintro ⟨ht, hl⟩; exact ⟨t₀, ht, rfl, hl⟩

theorem at_iff (N : ℕ) (φ : Fact (pr.Runs N)) (i : P) (t₀ : ℕ) (ℓ : L) (r : pr.Runs N) :
    (pr.toPPS N).At φ i (t₀, ℓ) r ↔ t₀ ≤ N ∧ pr.loc i (pr.state N r.1 t₀) = ℓ ∧ φ r t₀ := by
  simp only [PPS.At, toPPS, Prod.mk.injEq]
  constructor
  · rintro ⟨t, ht, ⟨rfl, hl⟩, hφ⟩; exact ⟨ht, hl, hφ⟩
  · rintro ⟨ht, hl, hφ⟩; exact ⟨t₀, ht, ⟨rfl, hl⟩, hφ⟩

/-- The core computation: for a fact `φ` independent of `i`'s own action at time `t₀ < N`,
`μ([φ ∧ does_i(α)]@ℓ) = prot_i(ℓ)(α) · μ(φ@ℓ)` for the local state `ℓ = (t₀, ℓ')`. -/
theorem prob_at_and_does {N : ℕ} {i : P} {φ : Fact (pr.Runs N)} (hφ : pr.IndepOwnAction N i φ)
    (α : Act i) {t₀ : ℕ} (ht : t₀ < N) (ℓ : L) :
    (pr.toPPS N).prob ((pr.toPPS N).At (fun r t => φ r t ∧ pr.does N i α r t) i (t₀, ℓ)) =
      pr.prot i t₀ ℓ α * (pr.toPPS N).prob ((pr.toPPS N).At φ i (t₀, ℓ)) := by
  -- extend `φ` (at time `t₀`) from the runs of positive probability to all action sequences
  set φ' : G × (Fin N → JAct Act) → Prop := fun ω => ∃ r : pr.Runs N, AgreeOff N i t₀ r.1 ω ∧ φ r t₀
  have hφ' : ∀ r : pr.Runs N, φ' r.1 ↔ φ r t₀ := fun r =>
    ⟨fun ⟨r', h, h'⟩ => (hφ r' r t₀ h).1 h', fun h => ⟨r, AgreeOff.refl _, h⟩⟩
  have hcongr : ∀ ω ω', AgreeOff N i t₀ ω ω' → (φ' ω ↔ φ' ω') := fun ω ω' h =>
    ⟨fun ⟨r, h1, h2⟩ => ⟨r, h1.trans h, h2⟩, fun ⟨r, h1, h2⟩ => ⟨r, h1.trans h.symm, h2⟩⟩
  rw [pr.prob_eq N _ (fun ω => pr.loc i (pr.state N ω t₀) = ℓ ∧ φ' ω ∧ ω.2 ⟨t₀, ht⟩ i = α)
    (fun r => by rw [at_iff, hφ']; simp [does, ht, ht.le]),
    pr.prob_eq N _ (fun ω => pr.loc i (pr.state N ω t₀) = ℓ ∧ φ' ω)
    (fun r => by rw [at_iff, hφ']; simp [ht.le]), mul_sum]
  refine sum_congr rfl fun g _ => ?_
  have hM := pr.sum_weightAux_mul_ind i α ℓ N 0 g t₀ ht
    (fun as => if pr.loc i (pr.state N (g, as) t₀) = ℓ ∧ φ' (g, as) then 1 else 0)
    (fun as as' h1 h2 => by
      have hs : pr.state N (g, as) t₀ = pr.state N (g, as') t₀ :=
        pr.stateAux_congr N 0 g as as' t₀ h1
      have hag : AgreeOff N i t₀ (g, as) (g, as') := ⟨⟨rfl, h1⟩, fun _ q hq => h2 q hq⟩
      simp only [hs, hcongr _ _ hag])
    (fun as h => by
      by_contra hne
      exact h (ite_eq_right fun hc => hne hc.1))
  rw [zero_add] at hM
  rw [mul_left_comm, ← hM]
  congr 1
  refine sum_congr rfl fun as _ => ?_
  congr 1
  by_cases h1 : pr.loc i (pr.state N (g, as) t₀) = ℓ ∧ φ' (g, as) <;>
    by_cases h2 : as ⟨t₀, ht⟩ i = α
  · rw [ite_eq_left ⟨h1.1, h1.2, h2⟩, ite_eq_left h1, ite_eq_left h2, mul_one]
  · rw [ite_eq_right fun h => h2 h.2.2, ite_eq_right h2, mul_zero]
  · rw [ite_eq_right fun h => h1 ⟨h.1, h.2.1⟩, ite_eq_right h1, zero_mul]
  · rw [ite_eq_right fun h => h1 ⟨h.1, h.2.1⟩, ite_eq_right h1, zero_mul]

/-- If the fact `φ` at time `t` depends only on the history up to time `t` and on the actions of
the other participants at time `t`, then `φ` is local-state independent of every action of `i`
(a slight generalization of Lemma 4.3(b)). -/
theorem lsi_of_indepOwnAction {N : ℕ} {i : P} {φ : Fact (pr.Runs N)}
    (hφ : pr.IndepOwnAction N i φ) (α : Act i) :
    (pr.toPPS N).LocalStateIndependent i φ (pr.does N i α) := by
  rintro ⟨t₀, ℓ⟩
  rw [PPS.cprob_at, PPS.cprob_at, PPS.cprob_at]
  by_cases ht : t₀ < N
  · have h1 := pr.prob_at_and_does hφ α ht ℓ
    have h2 := pr.prob_at_and_does (pr.indepOwnAction_true N i) α ht ℓ
    rw [PPS.prob_congr (Q := (pr.toPPS N).At (fun r t => True ∧ pr.does N i α r t) i (t₀, ℓ))
      (Q' := (pr.toPPS N).At (pr.does N i α) i (t₀, ℓ))
      (fun r => by simp only [at_iff, true_and]),
      PPS.prob_congr (Q := (pr.toPPS N).At (fun _ _ => True) i (t₀, ℓ))
      (Q' := (pr.toPPS N).Occurs i (t₀, ℓ)) (fun r => by
        simp only [at_iff, and_true, occurs_iff])] at h2
    rw [h1, h2]
    by_cases hO : (pr.toPPS N).prob ((pr.toPPS N).Occurs i (t₀, ℓ)) = 0
    · simp [hO]
    · field_simp
  · have hA : ∀ ψ : Fact (pr.Runs N), (pr.toPPS N).prob
        ((pr.toPPS N).At (fun r t => ψ r t ∧ pr.does N i α r t) i (t₀, ℓ)) = 0 := fun ψ => by
      rw [PPS.prob_congr (Q' := fun _ => False) fun r => by
        simp only [at_iff, does, iff_false]; rintro ⟨-, -, -, h, -⟩; exact ht h]
      simp [PPS.prob]
    have h0 := hA (fun _ _ => True)
    rw [PPS.prob_congr (Q := (pr.toPPS N).At (fun r t => True ∧ pr.does N i α r t) i (t₀, ℓ))
      (Q' := (pr.toPPS N).At (pr.does N i α) i (t₀, ℓ))
      (fun r => by simp only [at_iff, true_and])] at h0
    rw [h0, hA]
    simp

/-- **Lemma 4.3(b)** of [Moses–Zamir]. In the pps generated by a joint protocol, every past-based
fact `φ` is local-state independent of every action `α` of `i`. -/
theorem lemma_4_3b {N : ℕ} {i : P} (α : Act i) {φ : Fact (pr.Runs N)} (hφ : pr.PastBased N φ) :
    (pr.toPPS N).LocalStateIndependent i φ (pr.does N i α) :=
  pr.lsi_of_indepOwnAction (PastBased.indepOwnAction pr hφ i) α

/-! ### Beliefs about one's own mixed action, and the corrected claim of §7 -/

/-- In a protocol-generated pps, at a point `(r, t)` with `t < N`, agent `i`'s belief in any fact
of the form `φ ∧ does_i(α)` is at most the probability `prot_i(t, ℓ)(α)` with which its protocol
chooses `α` there: an agent performing a mixed action cannot strongly believe that it performs it. -/
theorem belief_and_does_le {N : ℕ} {i : P} (α : Act i) (φ : Fact (pr.Runs N)) (r : pr.Runs N)
    {t : ℕ} (ht : t < N) :
    (pr.toPPS N).belief i (fun r t => φ r t ∧ pr.does N i α r t) r t ≤
      pr.prot i t (pr.loc i (pr.state N r.1 t)) α := by
  rw [PPS.belief, PPS.cprob_at]
  change (pr.toPPS N).prob ((pr.toPPS N).At _ i (t, pr.loc i (pr.state N r.1 t))) /
    (pr.toPPS N).prob ((pr.toPPS N).Occurs i (t, pr.loc i (pr.state N r.1 t))) ≤ _
  have h2 := pr.prob_at_and_does (pr.indepOwnAction_true N i) α ht (pr.loc i (pr.state N r.1 t))
  rw [PPS.prob_congr (Q := (pr.toPPS N).At (fun _ _ => True) i (t, _))
    (Q' := (pr.toPPS N).Occurs i (t, pr.loc i (pr.state N r.1 t)))
    (fun r => by simp only [at_iff, and_true, occurs_iff])] at h2
  have hO : 0 < (pr.toPPS N).prob ((pr.toPPS N).Occurs i (t, pr.loc i (pr.state N r.1 t))) :=
    PPS.prob_pos ((pr.occurs_iff N i t _ r).2 ⟨ht.le, rfl⟩)
  rw [div_le_iff₀ hO, ← h2]
  exact PPS.prob_mono fun r' ⟨t', ht', hl, hφ, hd⟩ => ⟨t', ht', hl, trivial, hd⟩

/-- Consequently, if `i` chooses `α` with probability at most `q` at each of its local states, then
for `p > q` the belief `β_i(φ ∧ does_i(α))@α` never reaches `p`. -/
theorem cprob_belief_and_does_eq_zero {N : ℕ} {i : P} (α : Act i) (φ : Fact (pr.Runs N))
    {p q : ℝ} (hq : ∀ t ℓ, pr.prot i t ℓ α ≤ q) (hpq : q < p) :
    (pr.toPPS N).cprob (fun r => p ≤ (pr.toPPS N).beliefAt i (fun r t => φ r t ∧ pr.does N i α r t)
      (pr.does N i α) r) ((pr.toPPS N).Performs (pr.does N i α)) = 0 := by
  rw [PPS.cprob, PPS.prob_congr (Q' := fun _ => False)]
  · simp [PPS.prob]
  · intro r
    simp only [iff_false, not_and]
    intro h hp
    rw [PPS.beliefAt, ite_eq_left hp] at h
    obtain ⟨hle, hA⟩ := PPS.actTime_spec hp
    obtain ⟨ht, -⟩ := hA
    have := pr.belief_and_does_le α φ r ht
    linarith [hq ((pr.toPPS N).actTime (pr.does N i α) r)
      (pr.loc i (pr.state N r.1 ((pr.toPPS N).actTime (pr.does N i α) r)))]

/-- **The claim of §7, corrected.** In every protocol-generated pps (synchronous, independent
choices), for agents `i ≠ j` and a proper action `α` of `i`: if the constraint
`μ([does_j(β) ∧ does_i(α)]@α | α) ≥ 1 - ε²` holds ("both fire", Example 1 with `ε = 0.1`), then `i`
believes that *`j` is performing `β`* with degree `≥ 1 - ε` with probability `≥ 1 - ε` when it
performs `α`. (For the fact `φ_both = does_j(β) ∧ does_i(α)` itself the conclusion can fail, see
`Example1.Mixed.section7_claim_false` and `cprob_belief_and_does_eq_zero`.) -/
theorem section7_claim_fireB {N : ℕ} {i j : P} (hij : j ≠ i) (α : Act i) (β : Act j)
    (hA : (pr.toPPS N).Proper (pr.does N i α)) {ε : ℝ} (hε : 0 ≤ ε)
    (h : 1 - ε ^ 2 ≤ (pr.toPPS N).cprob
      ((pr.toPPS N).AtAct (fun r t => pr.does N j β r t ∧ pr.does N i α r t) (pr.does N i α))
      ((pr.toPPS N).Performs (pr.does N i α))) :
    1 - ε ≤ (pr.toPPS N).cprob
      (fun r => 1 - ε ≤ (pr.toPPS N).beliefAt i (pr.does N j β) (pr.does N i α) r)
      ((pr.toPPS N).Performs (pr.does N i α)) := by
  refine PPS.corollary_7_2 hA (pr.lsi_of_indepOwnAction (pr.indepOwnAction_does hij β) α) hε ?_
  refine h.trans_eq ?_
  unfold PPS.cprob
  congr 1
  exact PPS.prob_congr fun r => and_congr_left fun _ =>
    ⟨fun ⟨t, ht, ha, hb, _⟩ => ⟨t, ht, ha, hb⟩, fun ⟨t, ht, ha, hb⟩ => ⟨t, ht, ha, hb, ha⟩⟩

end JointProtocol

