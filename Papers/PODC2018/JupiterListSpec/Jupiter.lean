import Papers.PODC2018.JupiterListSpec.System

/-!
# The Jupiter protocol (Section 4.1, Appendix C)

The multi-client Jupiter protocol of Xu, Sun and Li as reviewed in Appendix C.

* An operation (`JOp`, Definition 27) is a list operation with its identifier and its context.
* A 2D state space (`DSS`, Definition 29) is represented by its set of edges and its current
  vertex. Every edge is labelled by an operation whose context is the source vertex, so an edge is
  just a `JOp` (from `op.ctx` to `op.ctx ∪ {op.oid}`). In the state space of client `c` (and in the
  server's state space for `c`) an edge is in the LOCAL dimension iff its operation was generated
  by `c`, and in the GLOBAL dimension otherwise. `edgeFrom` returns the (latest added) edge from
  a vertex in a given dimension.
* `xLoop` / `xForm` are `xForm(op, d)` of Algorithm C.4: starting from the vertex matching
  `op.ctx`, transform `op` along dimension `d` until the current vertex is reached, adding the two
  transformed edges of every square (Figure 3).
* Client (Algorithm C.5): local processing adds a LOCAL edge from the current vertex; remote
  processing calls `xForm(op, LOCAL)`. Server (Algorithm C.6): `xForm(op, GLOBAL)` in the state
  space of the sender, appends the transformed operation along the GLOBAL dimension of the state
  spaces of all other clients, and forwards the transformed operation.
-/

namespace Podc.JupiterListSpec

variable {n : ℕ}

/-- An operation of Jupiter (Definition 27). -/
structure JOp (n : ℕ) where
  o : LOp (Oid n)
  oid : Oid n
  ctx : Finset (Oid n)
  deriving DecidableEq

/-- `op⟨op'⟩` (Definition 27). -/
def JOp.xf (op op' : JOp n) : JOp n := ⟨JupiterListSpec.xf op.o op'.o, op.oid, insert op'.oid op.ctx⟩

/-- A 2D state space: its edges and its current vertex. -/
structure DSS (n : ℕ) where
  edges : List (JOp n)
  cur : Finset (Oid n)

/-- The edge from vertex `u` along dimension `d` (`true` = LOCAL, i.e. generated by the owner
`c`), in the state space owned by `c`. -/
def edgeFrom (c : Fin n) (E : List (JOp n)) (u : Finset (Oid n)) (d : Bool) : Option (JOp n) :=
  E.find? fun e => decide (e.ctx = u) && (decide (e.oid.1 = c) == d)

/-- The loop of `xForm(op, d)` (Algorithm C.4, lines 5–19); `op.ctx` is the vertex `u`. -/
def xLoop (c : Fin n) (d : Bool) (cur : Finset (Oid n)) :
    ℕ → List (JOp n) → JOp n → Option (List (JOp n) × JOp n)
  | 0, E, op => if op.ctx = cur then some (E, op) else none
  | f + 1, E, op =>
    if op.ctx = cur then some (E, op) else
    match edgeFrom c E op.ctx d with
    | none => none
    | some e => xLoop c d cur f (op.xf e :: e.xf op :: E) (op.xf e)

/-- `xForm(op, d)` (Algorithm C.4) in the state space `S` owned by `c`: returns the new state space
and the transformed operation. -/
def xForm (c : Fin n) (d : Bool) (S : DSS n) (op : JOp n) : Option (DSS n × JOp n) :=
  match xLoop c d S.cur S.cur.card (op :: S.edges) op with
  | none => none
  | some (E, op') => some (⟨E, insert op.oid S.cur⟩, op')

/-- Jupiter client state. -/
structure JClient (n : ℕ) where
  list : List (Oid n)
  dss : DSS n

/-- Jupiter server state: one 2D state space per client. -/
structure JServer (n : ℕ) where
  list : List (Oid n)
  dss : Fin n → DSS n

theorem xLoop_oid {c : Fin n} {d : Bool} {cur : Finset (Oid n)} :
    ∀ {f : ℕ} {E : List (JOp n)} {op : JOp n} {E' : List (JOp n)} {op' : JOp n},
      xLoop c d cur f E op = some (E', op') → op'.oid = op.oid
  | 0, E, op, E', op', h => by
    unfold xLoop at h; split_ifs at h; cases h; rfl
  | f + 1, E, op, E', op', h => by
    unfold xLoop at h
    split_ifs at h
    · cases h; rfl
    · split at h
      · cases h
      · exact (xLoop_oid h).trans rfl

theorem xForm_oid {c : Fin n} {d : Bool} {S S' : DSS n} {op op' : JOp n}
    (h : xForm c d S op = some (S', op')) : op'.oid = op.oid := by
  unfold xForm at h
  split at h
  · cases h
  · cases h; exact xLoop_oid (by assumption)

/-- The Jupiter protocol. -/
@[reducible] def jupiter (n : ℕ) : Proto n where
  CS := JClient n
  SS := JServer n
  Msg := JOp n
  cinit := ⟨[], ⟨[], ∅⟩⟩
  sinit := ⟨[], fun _ => ⟨[], ∅⟩⟩
  list s := s.list
  slist s := s.list
  oidOf m := m.oid
  cdo _ x o s :=
    let op : JOp n := ⟨o, x, s.dss.cur⟩
    (⟨o.apply s.list, ⟨op :: s.dss.edges, insert x s.dss.cur⟩⟩, op)
  crecv c m s :=
    match xForm c true s.dss m with
    | none => none
    | some (S', op') => some ⟨op'.o.apply s.list, S'⟩
  srecv c m s :=
    match xForm c false (s.dss c) m with
    | none => none
    | some (S', op') =>
      some (⟨op'.o.apply s.list, fun j => if j = c then S' else
        ⟨op' :: (s.dss j).edges, insert op'.oid (s.dss j).cur⟩⟩, op')
  oidOf_cdo _ _ _ _ := rfl
  oidOf_srecv c m s s' m' h := by
    split at h
    · cases h
    · cases h; exact xForm_oid (by assumption)

end Podc.JupiterListSpec
