import Papers.PODC2017.SeeingIsBelieving.Serializability

/-!
# Theorem 2: snapshot isolation

`∃ e : ∀ T ∈ 𝒯 : CT_SI(T, e) ≡ ¬G1 ∧ ¬G-SI` (Adya's PL-SI), where the right-hand side is read
as "for some version order and some start/commit timestamps".

* `theorem2_of_adya`: from a version order and timestamps (in any linear order) satisfying PL-SI
  to an execution passing `CT_SI` (the paper's construction: apply the transactions in commit
  order, read from the state generated by the last transaction committed before `T` starts).
* `theorem2_to_adya`: from an execution passing `CT_SI` to the version order of the execution and
  timestamps in `ℕ` (commit points in execution order, start point right after the commit point
  of the transaction generating the chosen snapshot).
-/

namespace Podc.SeeingIsBelieving

open Relation

variable {K ι : Type*} [DecidableEq K] [DecidableEq ι] {H : TxnSet K ι}

/-! ### From Adya to the state-based definition -/

section ToState

variable {τ : Type*} [LinearOrder τ] (vo : VersionOrder H) (ts : Timestamps H τ)

lemma VersionOrder.commit_lt_start_of_transGen (hSIa : ¬ vo.GSIa ts) {X Y : ι}
    (h : TransGen vo.WW X Y) : ts.commit X < ts.start Y := by
  have hsd : ∀ a b, vo.WW a b → ts.commit a < ts.start b := fun a b hab => by
    by_contra hc; exact hSIa ⟨a, b, Or.inl hab, fun h => hc h.2.2⟩
  induction h with
  | single h => exact hsd _ _ h
  | tail hXb hbc ih =>
    obtain ⟨hb, -⟩ := vo.ww_committed hbc
    exact ih.trans ((ts.start_lt_commit _ hb).trans (hsd _ _ hbc))

/-- The paper's "if" direction of Theorem 2, for timestamps in any linear order. -/
theorem theorem2_of_adya (hwf : H.WellFormed) (hG1 : ¬ vo.G1) (hSIa : ¬ vo.GSIa ts)
    (hSIb : ¬ vo.GSIb ts) : H.Satisfies Execution.CTSI := by
  classical
  -- apply the committed transactions in commit order
  have hacyc : ∀ a, ¬ TransGen (H.committed.restrictRel (fun X Y => ts.commit X < ts.commit Y))
      a a := fun a ha => lt_irrefl _ (lt_of_transGen ts.commit (fun _ _ h => h.2.2) ha)
  obtain ⟨e, he⟩ := Execution.exists_of_acyclic _ hacyc
  have hidx : ∀ X ∈ H.committed, ∀ Y ∈ H.committed,
      e.idx X < e.idx Y ↔ ts.commit X < ts.commit Y := by
    intro X hX Y hY
    refine ⟨fun h => ?_, he X Y hX hY⟩
    rcases lt_trichotomy (ts.commit X) (ts.commit Y) with h' | h' | h'
    · exact h'
    · rw [ts.commit_inj X hX Y hY h'] at h; exact absurd h (lt_irrefl _)
    · have := he Y X hY hX h'; omega
  have hidx_le : ∀ X ∈ H.committed, ∀ Y ∈ H.committed,
      e.idx X ≤ e.idx Y → ts.commit X ≤ ts.commit Y := by
    intro X hX Y hY h
    rcases h.lt_or_eq with h | h
    · exact ((hidx X hX Y hY).1 h).le
    · rw [e.idx_inj hX hY h]
  -- the snapshot of `T`: the state generated by the last transaction committed before `T` starts
  let snap : ι → ℕ := fun T =>
    (H.committed.filter (fun X => ts.commit X < ts.start T)).sup (fun X => e.idx X + 1)
  have hsnap : ∀ T, ∀ X ∈ H.committed, e.idx X < snap T ↔ ts.commit X < ts.start T := by
    intro T X hX
    constructor
    · intro h
      obtain ⟨Y, hY, hXY⟩ := (Finset.lt_sup_iff).1 h
      rw [Finset.mem_filter] at hY
      exact (hidx_le X hX Y hY.1 (by omega)).trans_lt hY.2
    · intro h
      have : e.idx X + 1 ≤ snap T :=
        Finset.le_sup (f := fun X => e.idx X + 1) (Finset.mem_filter.2 ⟨hX, h⟩)
      omega
  have hsnap_le : ∀ T ∈ H.committed, snap T ≤ e.idx T := by
    intro T hT
    refine Finset.sup_le fun X hX => ?_
    rw [Finset.mem_filter] at hX
    exact (hidx X hX.1 T hT).2 (hX.2.trans (ts.start_lt_commit T hT))
  have hdep : ∀ X Y, vo.Dep X Y → ts.commit X < ts.start Y := fun X Y h => by
    by_contra hc; exact hSIa ⟨X, Y, h, fun h' => hc h'.2.2⟩
  have hlt : ∀ k Z V, vo.lt k Z V → ts.commit Z < ts.start V := fun k Z V h =>
    vo.commit_lt_start_of_transGen ts hSIa (vo.transGen_ww_of_lt h)
  have hvo : ∀ k Z V, vo.lt k Z V → e.idx Z < e.idx V := fun k Z V h => by
    obtain ⟨hZ, hV, -⟩ := vo.dom h
    exact (hidx Z hZ V hV).2 ((hlt k Z V h).trans (ts.start_lt_commit V hV))
  refine ⟨e, fun T hT => ⟨snap T, (hsnap_le T hT).trans (e.idx_lt_length hT).le, ?_, ?_⟩⟩
  · -- `s_snap` is complete for `T`
    intro m hm
    have hm' : (H.ops T)[m]? = some (H.ops T)[m] := List.getElem?_eq_getElem hm
    have hmem : (H.ops T)[m] ∈ H.ops T := List.getElem_mem hm
    generalize (H.ops T)[m] = o at hm' hmem
    cases o with
    | write k => exact (e.readState_write hm').2 (hsnap_le T hT)
    | read k v =>
      refine (e.readState_read hm').2 ⟨hsnap_le T hT, ?_⟩
      by_cases hint : v = some T ∧ Op.write k ∈ (H.ops T).take m
      · exact Or.inr hint
      left
      refine e.state_eq_of_no_next vo (hvo k) ?_ ?_
      · rintro V rfl
        by_cases hVT : V = T
        · subst hVT; exact absurd ⟨rfl, hwf.read_own V hT m k hm'⟩ hint
        have hwV := hwf.read_other T hT k V hmem hVT
        have hVc : V ∈ H.committed := by
          by_contra hc; exact hG1 (Or.inl ⟨T, hT, k, V, hmem, hc⟩)
        exact ⟨hVc, hwV, (hsnap T V hVc).2 (hdep V T (Or.inr ⟨hVc, hT, hVT, k, hwV, hmem⟩))⟩
      · intro N Z hN hNZ hZ hwZ hZT
        have hZT' := (hsnap T Z hZ).1 hZT
        by_cases hNT : N = T
        · subst hNT
          rcases ReflTransGen.cases_head hNZ with rfl | ⟨c, hNc, hcZ⟩
          · have := hsnap_le N hT; omega
          · have h1 := vo.commit_lt_start_of_transGen ts hSIa (TransGen.head' hNc hcZ)
            have h2 := ts.start_lt_commit Z hZ
            have h3 := ts.start_lt_commit N hT
            exact absurd (h1.trans (h2.trans (hZT'.trans h3))) (lt_irrefl _)
        · refine hSIb ⟨T, N, ⟨hT, Ne.symm hNT, k, v, hmem, hN⟩, ?_⟩
          exact (reflTransGen_mono (fun a b h => Or.inl (Or.inl h)) hNZ).tail
            (Or.inr ⟨hZ, hT, hZT'⟩)
  · -- no conflicting write between the snapshot and the parent state
    intro k hwT
    refine e.state_eq_of_no_writer (hsnap_le T hT) fun Z hZ hwZ => ?_
    by_contra hc
    push Not at hc
    obtain ⟨h1, h2⟩ := hc
    have hZT : Z ≠ T := by rintro rfl; omega
    rcases vo.total hZ hT hwZ hwT hZT with h | h
    · have := (hsnap T Z hZ).2 (hlt k Z T h); omega
    · have := hvo k T Z h; omega

end ToState

/-! ### From the state-based definition to Adya -/

private lemma encode_lt_iff {M a b i j : ℕ} (hi : i < M) (hj : j < M) :
    a * M + i < b * M + j ↔ a < b ∨ (a = b ∧ i < j) := by
  constructor
  · intro h
    rcases lt_trichotomy a b with hab | rfl | hab
    · exact Or.inl hab
    · exact Or.inr ⟨rfl, by omega⟩
    · have : (b + 1) * M ≤ a * M := Nat.mul_le_mul_right _ hab
      rw [add_mul, one_mul] at this
      omega
  · rintro (hab | ⟨rfl, hij⟩)
    · have : (a + 1) * M ≤ b * M := Nat.mul_le_mul_right _ hab
      rw [add_mul, one_mul] at this
      omega
    · omega

private lemma encode_inj {M a b i j : ℕ} (hi : i < M) (hj : j < M)
    (h : a * M + i = b * M + j) : a = b ∧ i = j := by
  have h1 : ¬ (a * M + i < b * M + j) := by omega
  have h2 : ¬ (b * M + j < a * M + i) := by omega
  rw [encode_lt_iff hi hj] at h1
  rw [encode_lt_iff hj hi] at h2
  omega

/-- The paper's "only if" direction of Theorem 2: the version order of the execution and
timestamps in `ℕ`. -/
theorem theorem2_to_adya (e : Execution H) (he : ∀ T ∈ H.committed, e.CTSI T) :
    ∃ ts : Timestamps H ℕ, ¬ e.vo.G1 ∧ ¬ e.vo.GSIa ts ∧ ¬ e.vo.GSIb ts := by
  classical
  -- a snapshot not after the parent state
  have hex : ∀ T ∈ H.committed, ∃ j ≤ e.idx T, e.Complete T j ∧ e.NoConf T j := by
    intro T hT
    obtain ⟨i, -, hc, hn⟩ := he T hT
    by_cases hi : i ≤ e.idx T
    · exact ⟨i, hi, hc, hn⟩
    · refine ⟨e.idx T, le_rfl, fun m hm => absurd (hc m hm).1 hi, fun k _ => rfl⟩
  let snap : ι → ℕ := fun T => if h : T ∈ H.committed then (hex T h).choose else 0
  have hsnap : ∀ T ∈ H.committed, snap T ≤ e.idx T ∧ e.Complete T (snap T) ∧
      e.NoConf T (snap T) := by
    intro T hT
    simp only [snap, hT, ↓reduceDIte]
    exact (hex T hT).choose_spec
  set M := e.order.length + 1 with hM
  have hidxM : ∀ T ∈ H.committed, e.idx T < M := fun T hT => by
    have := e.idx_lt_length hT; omega
  let ts : Timestamps H ℕ :=
    { start := fun T => (2 * snap T + 1) * M + e.idx T
      commit := fun T => (2 * e.idx T + 2) * M + 0
      start_lt_commit := fun T hT => by
        have := (hsnap T hT).1
        exact (encode_lt_iff (hidxM T hT) (by omega)).2 (Or.inl (by omega))
      start_inj := fun T hT T' hT' h =>
        e.idx_inj hT hT' (encode_inj (hidxM T hT) (hidxM T' hT') h).2
      commit_inj := fun T hT T' hT' h => by
        have := (encode_inj (M := M) (by omega) (by omega) h).1
        exact e.idx_inj hT hT' (by omega)
      start_ne_commit := fun T hT T' hT' h => by
        have := (encode_inj (hidxM T hT) (by omega) h).1
        omega }
  have hsd : ∀ X ∈ H.committed, ∀ Y ∈ H.committed, H.SD ts X Y ↔ e.idx X < snap Y := by
    intro X hX Y hY
    simp only [TxnSet.SD, ts]
    rw [encode_lt_iff (by omega) (hidxM Y hY)]
    constructor
    · rintro ⟨-, -, h | ⟨h, -⟩⟩ <;> omega
    · intro h; exact ⟨hX, hY, Or.inl (by omega)⟩
  -- every dependency edge `X → Y` has `X` before the snapshot of `Y`
  have hdep : ∀ X Y, e.vo.Dep X Y → e.idx X < snap Y := by
    rintro X Y (⟨k, hXY, -⟩ | ⟨hX, hY, hne, k, -, hmem⟩)
    · obtain ⟨hX, hY, hwX, hwY, hlt⟩ := hXY
      by_contra hc
      exact e.state_ne_of_writer hX hwX (by omega) hlt ((hsnap Y hY).2.2 k hwY)
    · obtain ⟨m, hm, hm'⟩ := exists_getElem?_of_mem hmem
      exact (e.lt_of_readState_ne hm' hne ((hsnap Y hY).2.1 m hm)).2
  have hssg : ∀ X Y, e.vo.SSGDep ts X Y → e.idx X < snap Y := by
    rintro X Y (h | h)
    · exact hdep X Y h
    · exact (hsd X h.1 Y h.2.1).1 h
  have hssg_c : ∀ X Y, e.vo.SSGDep ts X Y → X ∈ H.committed := by
    rintro X Y (h | h)
    · exact (e.vo.dep_committed h).1
    · exact h.1
  have hpath : ∀ X Y, TransGen (e.vo.SSGDep ts) X Y → e.idx X < snap Y := by
    intro X Y h
    induction h with
    | single h => exact hssg _ _ h
    | tail _ hbc ih =>
      have := hssg _ _ hbc
      have := (hsnap _ (hssg_c _ _ hbc)).1
      omega
  refine ⟨ts, ?_, ?_, ?_⟩
  · rintro (hG | ⟨X, hX⟩)
    · exact e.not_G1a (fun T hT m hm => ⟨_, (hsnap T hT).2.1 m hm⟩) hG
    · have h := hpath X X (transGen_mono (fun a b h => Or.inl h) hX)
      have hXc : X ∈ H.committed := by
        obtain ⟨c, -, hc⟩ := TransGen.tail'_iff.1 hX
        exact (e.vo.dep_committed hc).2
      have := (hsnap X hXc).1
      omega
  · rintro ⟨X, Y, h, hn⟩
    obtain ⟨hX, hY⟩ := e.vo.dep_committed h
    exact hn ((hsd X hX Y hY).2 (hdep X Y h))
  · rintro ⟨A, B, ⟨hA, hne, k, v, hmem, hN⟩, hBA⟩
    rcases ReflTransGen.cases_head hBA with rfl | ⟨c, hBc, hcA⟩
    · exact hne rfl
    have hBA' := hpath B A (TransGen.head' hBc hcA)
    obtain ⟨m, hm, hm'⟩ := exists_getElem?_of_mem hmem
    rcases ((e.readState_read hm').1 ((hsnap A hA).2.1 m hm)).2 with hs | ⟨rfl, -⟩
    · have := e.le_idx_of_isNextAfter hs hN; omega
    · have := hN.1.2.2.2.2
      have := (hsnap A hA).1
      omega

/-- **Theorem 2** of [Crooks, Pu, Alvisi, Clement, PODC 2017]. A set of transactions satisfies
the state-based definition of snapshot isolation (`∃ e, ∀ T, CT_SI(T, e)`) iff it has a version
order and start/commit timestamps for which Adya's phenomena G1 and G-SI (G-SIa, G-SIb) are
excluded (PL-SI). -/
theorem theorem2 (hwf : H.WellFormed) :
    H.Satisfies Execution.CTSI ↔
      ∃ (vo : VersionOrder H) (ts : Timestamps H ℕ), ¬ vo.G1 ∧ ¬ vo.GSIa ts ∧ ¬ vo.GSIb ts := by
  constructor
  · rintro ⟨e, he⟩
    obtain ⟨ts, h⟩ := theorem2_to_adya e he
    exact ⟨e.vo, ts, h⟩
  · rintro ⟨vo, ts, h1, h2, h3⟩
    exact theorem2_of_adya vo ts hwf h1 h2 h3

end Podc.SeeingIsBelieving
