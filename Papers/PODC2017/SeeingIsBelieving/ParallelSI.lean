import Papers.PODC2017.SeeingIsBelieving.ReadCommitted

/-!
# Theorem 10 (PL-2+ part): parallel snapshot isolation

`∃ e : ∀ T ∈ 𝒯 : CT_PSI(T, e) ≡ PL-2+`, where PL-2+ (Adya's *lazy consistency*) is `¬G1 ∧
¬G-single`, read as "for some version order". The paper's Theorems 5 and 10 also claim
equivalence with the operational specification of PSI of Sovran et al.; that part is not
formalized.
-/

namespace Podc.SeeingIsBelieving

open Relation

variable {K ι : Type*} [DecidableEq K] [DecidableEq ι] {H : TxnSet K ι}

namespace Execution

variable (e : Execution H)

/-- Read states lie in `[0, idx T]`, so an operation with a read state has a last one. -/
lemma exists_isLastReadState {T : ι} {m : ℕ} (h : ∃ i, e.ReadState T m i) :
    ∃ i, e.IsLastReadState T m i := by
  classical
  obtain ⟨i, hi⟩ := h
  refine ⟨Nat.findGreatest (e.ReadState T m) (e.idx T),
    Nat.findGreatest_spec hi.1 hi, fun i' hi' => Nat.le_findGreatest hi'.1 hi'⟩

/-- `T` reads `V`'s value of `k` from the state generated by `V` (if `V` precedes `T`). -/
lemma readState_idx_succ {T V : ι} {m : ℕ} {k : K} (hm : (H.ops T)[m]? = some (.read k (some V)))
    (hV : V ∈ H.committed) (hw : H.Writes V k) (hlt : e.idx V < e.idx T) :
    e.ReadState T m (e.idx V + 1) :=
  (e.readState_read hm).2 ⟨hlt, Or.inl (e.state_idx_succ hV hw)⟩

end Execution

/-- From the state-based definition of PSI to PL-2+. -/
theorem theorem10_to_adya (e : Execution H) (he : ∀ T ∈ H.committed, e.CTPSI T) :
    ¬ e.vo.G1 ∧ ¬ e.vo.GSingle := by
  have hpre : ∀ T ∈ H.committed, e.PreRead T := fun T hT => (he T hT).1
  refine ⟨e.not_G1_of_preRead hpre, ?_⟩
  -- every dependency edge is a `▶` edge
  have hdprec : ∀ X Y, e.vo.Dep X Y → e.DPrec X Y := by
    rintro X Y (⟨k, hXY, -⟩ | ⟨hX, hY, hne, k, hwX, hmem⟩)
    · obtain ⟨hX, hY, hwX, hwY, hlt⟩ := hXY
      exact ⟨hX, hY, Or.inr ⟨hlt, k, hwY, hwX⟩⟩
    · obtain ⟨m, hm, hm'⟩ := exists_getElem?_of_mem hmem
      obtain ⟨i, hi⟩ := hpre Y hY m hm
      have hXi := (e.lt_of_readState_ne hm' hne hi).2
      refine ⟨hX, hY, Or.inl ⟨m, hm, e.readState_idx_succ hm' hX hwX (by have := hi.1; omega),
        fun i' hi' => ?_⟩⟩
      have := (e.lt_of_readState_ne hm' hne hi').2
      omega
  rintro ⟨A, B, ⟨hA, hne, k, v, hmem, hN⟩, hBA⟩
  rcases ReflTransGen.cases_head hBA with rfl | ⟨c, hBc, hcA⟩
  · exact hne rfl
  have hBA' : TransGen e.DPrec B A := transGen_mono hdprec (TransGen.head' hBc hcA)
  obtain ⟨m, hm, hm'⟩ := exists_getElem?_of_mem hmem
  obtain ⟨hBc', hwB⟩ := e.vo.isNextAfter_committed hN
  obtain ⟨i, hi⟩ := e.exists_isLastReadState (hpre A hA m hm)
  have hkey : ((H.ops A)[m]).key = k := by
    rw [List.getElem?_eq_getElem hm, Option.some_inj] at hm'; rw [hm']; rfl
  have hBi := (he A hA).2 B hBA' m hm (hkey ▸ hwB) i hi
  rcases ((e.readState_read hm').1 hi.1) with ⟨hiA, hs | ⟨rfl, -⟩⟩
  · have := e.le_idx_of_isNextAfter hs hN; omega
  · have := hN.1.2.2.2.2; omega

/-- From PL-2+ to the state-based definition of PSI. -/
theorem theorem10_of_adya (hwf : H.WellFormed) (vo : VersionOrder H) (hG1 : ¬ vo.G1)
    (hGs : ¬ vo.GSingle) : H.Satisfies Execution.CTPSI := by
  obtain ⟨e, he⟩ := vo.exists_execution_of_not_G1c (fun h => hG1 (Or.inr h))
  have hG1a : ¬ H.G1a := fun h => hG1 (Or.inl h)
  have hpre : ∀ T ∈ H.committed, e.PreRead T := fun T hT =>
    e.preRead_of_wr hwf hG1a (fun X Y h => he X Y (Or.inr h)) hT
  have hvo : ∀ k Z V, vo.lt k Z V → e.idx Z < e.idx V := fun k Z V h =>
    lt_of_transGen e.idx (fun a b h => he a b (Or.inl h)) (vo.transGen_ww_of_lt h)
  -- every `▶` edge is a dependency path
  have hdep : ∀ X Y, e.DPrec X Y → TransGen vo.Dep X Y := by
    rintro X Y ⟨hX, hY, ⟨m, hm, hfirst, hmin⟩ | ⟨hlt, k, hwY, hwX⟩⟩
    · have hm' : (H.ops Y)[m]? = some (H.ops Y)[m] := List.getElem?_eq_getElem hm
      have hmem : (H.ops Y)[m] ∈ H.ops Y := List.getElem_mem hm
      generalize (H.ops Y)[m] = o at hm' hmem
      -- a read state `s_0` would contradict `idx X + 1 ≤ ·`
      have h0 : ¬ e.ReadState Y m 0 := fun h => by have := hmin 0 h; omega
      cases o with
      | write k => exact absurd ((e.readState_write hm').2 (Nat.zero_le _)) h0
      | read k v =>
        rcases ((e.readState_read hm').1 hfirst) with ⟨hXY, hs | hint⟩
        · cases v with
          | none => exact absurd ((e.readState_read hm').2 ⟨Nat.zero_le _, Or.inl rfl⟩) h0
          | some V =>
            obtain ⟨hV, hwV, hVX, -⟩ := e.state_eq_some_iff.1 hs
            have hVY : V ≠ Y := by
              rintro rfl
              exact h0 ((e.readState_read hm').2
                ⟨Nat.zero_le _, Or.inr ⟨rfl, hwf.read_own V hY m k hm'⟩⟩)
            have := hmin _ ((e.readState_read hm').2
              ⟨by omega, Or.inl (e.state_idx_succ hV hwV)⟩)
            have hVX' : V = X := e.idx_inj hV hX (by omega)
            subst hVX'
            exact TransGen.single (Or.inr ⟨hV, hY, hVY, k, hwV, hmem⟩)
        · exact absurd ((e.readState_read hm').2 ⟨Nat.zero_le _, Or.inr hint⟩) h0
    · have hXY : X ≠ Y := by rintro rfl; omega
      rcases vo.total hX hY hwX hwY hXY with h | h
      · exact transGen_mono (fun a b h => Or.inl h) (vo.transGen_ww_of_lt h)
      · have := hvo k Y X h; omega
  have hDP : ∀ X Y, TransGen e.DPrec X Y → TransGen vo.Dep X Y := by
    intro X Y h
    induction h with
    | single h => exact hdep _ _ h
    | tail _ h ih => exact ih.trans (hdep _ _ h)
  refine ⟨e, fun T hT => ⟨hpre T hT, fun T' hT'T m hm hw i hi => ?_⟩⟩
  have hdT : TransGen vo.Dep T' T := hDP _ _ hT'T
  have hlt : e.idx T' < e.idx T := lt_of_transGen e.idx (fun a b h => he a b h) hdT
  have hT' : T' ∈ H.committed := by
    obtain ⟨c, hc, -⟩ := TransGen.head'_iff.1 hdT
    exact (vo.dep_committed hc).1
  have hm' : (H.ops T)[m]? = some (H.ops T)[m] := List.getElem?_eq_getElem hm
  have hmem : (H.ops T)[m] ∈ H.ops T := List.getElem_mem hm
  generalize (H.ops T)[m] = o at hm' hmem hw
  -- the read state `s_{idx T}` (the parent state) makes `sl_o` late enough
  have hlast : e.ReadState T m (e.idx T) → e.idx T' + 1 ≤ i := fun h => by
    have := hi.2 _ h; omega
  -- a version of the read key installed after the one read closes a G-single cycle
  have hcyc : ∀ (k : K) (v : Option ι), Op.read k v ∈ H.ops T →
      (v = none ∨ ∃ V, v = some V ∧ vo.lt k V T') → H.Writes T' k → False := by
    intro k v hmemv hv hwk
    obtain ⟨N, hN, hNT'⟩ := vo.exists_isNextAfter hT' hwk hv
    have hpath : TransGen vo.Dep N T :=
      TransGen.trans_right (reflTransGen_mono (fun a b h => Or.inl h) hNT') hdT
    by_cases hNT : N = T
    · subst hNT; exact hG1 (Or.inr ⟨N, hpath⟩)
    · exact hGs ⟨T, N, ⟨hT, Ne.symm hNT, k, v, hmemv, hN⟩, hpath.to_reflTransGen⟩
  cases o with
  | write k => exact hlast ((e.readState_write hm').2 le_rfl)
  | read k v =>
    by_cases hint : v = some T ∧ Op.write k ∈ (H.ops T).take m
    · exact hlast ((e.readState_read hm').2 ⟨le_rfl, Or.inr hint⟩)
    cases v with
    | none => exact (hcyc k none hmem (Or.inl rfl) hw).elim
    | some V =>
      have hVT : V ≠ T := by
        rintro rfl; exact hint ⟨rfl, hwf.read_own V hT m k hm'⟩
      have hwV := hwf.read_other T hT k V hmem hVT
      have hVc : V ∈ H.committed := by
        by_contra hc; exact hG1a ⟨T, hT, k, V, hmem, hc⟩
      have hVT' := he V T (Or.inr ⟨hVc, hT, hVT, k, hwV, hmem⟩)
      have hVi := hi.2 _ (e.readState_idx_succ hm' hVc hwV hVT')
      by_cases hTV : T' = V
      · subst hTV; omega
      rcases vo.total hT' hVc hw hwV hTV with h | h
      · have := hvo k T' V h; omega
      · exact (hcyc k (some V) hmem (Or.inr ⟨V, rfl, h⟩) hw).elim

/-- **Theorem 10** of [Crooks, Pu, Alvisi, Clement, PODC 2017], the equivalence with PL-2+:
a set of transactions satisfies the state-based definition of PSI (`∃ e, ∀ T, CT_PSI(T, e)`)
iff it has a version order for which Adya's phenomena G1 and G-single are excluded. -/
theorem theorem10 (hwf : H.WellFormed) :
    H.Satisfies Execution.CTPSI ↔ ∃ vo : VersionOrder H, ¬ vo.G1 ∧ ¬ vo.GSingle := by
  constructor
  · rintro ⟨e, he⟩
    exact ⟨e.vo, theorem10_to_adya e he⟩
  · rintro ⟨vo, h1, h2⟩
    exact theorem10_of_adya hwf vo h1 h2

end Podc.SeeingIsBelieving
