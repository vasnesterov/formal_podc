import Papers.PODC2026.FastByzantineTOB.FlutterBasic

set_option linter.unusedSectionVars false

/-!
# Flutter: local invariants of a correct server

We abstract the effect of a global step on the state of one correct server as a local step
`LStep`, and prove the server-local invariants (No Duplication, Observations 2–8, the bookkeeping
behind Lemmas 17–20) for `LStep`.
-/

namespace Podc.FastByzantineTOB.Flutter

variable {P C M T : Type*} [LinearOrder C] [LinearOrder M] [LinearOrder T] [AddCommMonoid T]
  [Fintype P] [DecidableEq P] [DecidableEq C]

/-- The deliveries generated by a sequence of `order` calls (lines 47–50). -/
def delSeq (l : List (Tag C M T)) : List (C × M) :=
  l.foldl (fun acc x => if (x.client, x.msg) ∈ acc then acc else acc ++ [(x.client, x.msg)]) []

lemma delSeq_concat (l : List (Tag C M T)) (x : Tag C M T) : delSeq (l ++ [x]) =
    if (x.client, x.msg) ∈ delSeq l then delSeq l else delSeq l ++ [(x.client, x.msg)] := by
  unfold delSeq; rw [List.foldl_append]; rfl

lemma delSeq_nodup (l : List (Tag C M T)) : (delSeq l).Nodup := by
  induction l using List.reverseRecOn with
  | nil => simp [delSeq]
  | append_singleton l x ih =>
    rw [delSeq_concat]; split_ifs with h
    · exact ih
    · refine List.nodup_append.mpr ⟨ih, by simp, ?_⟩
      intro a ha b hb hab
      simp only [List.mem_singleton] at hb
      subst hb hab
      exact h ha

lemma mem_delSeq (l : List (Tag C M T)) (cm : C × M) :
    cm ∈ delSeq l ↔ ∃ x ∈ l, (x.client, x.msg) = cm := by
  induction l using List.reverseRecOn with
  | nil => simp [delSeq]
  | append_singleton l x ih =>
    rw [delSeq_concat]
    split_ifs with h
    · rw [ih]
      constructor
      · rintro ⟨y, hy, rfl⟩; exact ⟨y, List.mem_append_left _ hy, rfl⟩
      · rintro ⟨y, hy, rfl⟩
        rcases List.mem_append.mp hy with hy | hy
        · exact ⟨y, hy, rfl⟩
        · simp only [List.mem_singleton] at hy; subst hy; exact ih.mp h
    · simp only [List.mem_append, List.mem_singleton, ih]
      constructor
      · rintro (⟨y, hy, rfl⟩ | rfl)
        · exact ⟨y, Or.inl hy, rfl⟩
        · exact ⟨x, Or.inr rfl, rfl⟩
      · rintro ⟨y, hy | rfl, rfl⟩
        · exact Or.inl ⟨y, hy, rfl⟩
        · exact Or.inr rfl

lemma delSeq_prefix {l l' : List (Tag C M T)} (h : l <+: l') : delSeq l <+: delSeq l' := by
  obtain ⟨r, rfl⟩ := h
  induction r using List.reverseRecOn with
  | nil => simp
  | append_singleton r x ih =>
    rw [← List.append_assoc, delSeq_concat]
    split_ifs
    · exact ih
    · exact ih.trans (List.prefix_append _ _)

variable (S : Setup P C T)

/-- Local version of `spot`. -/
noncomputable def SState.spotL (l : SState P C M T) (x : Tag C M T) : SState P C M T :=
  { l with
    cands := spotCands S l x
    observed := insert x l.observed
    obox := if x ∈ l.observed then l.obox else l.obox ++ [.observe x] }

/-- Local version of `accept` (lines 32–36). -/
noncomputable def SState.acceptL (l : SState P C M T) (x : Tag C M T) : SState P C M T :=
  if x ∈ l.proposed then l.spotL S x
  else { l.spotL S x with
    props := insert (x, decide (l.clock < x.bet)) l.props
    proposed := insert x l.proposed }

/-- The possible changes of the state of a correct server in one global step. -/
inductive LStep : SState P C M T → SState P C M T → Prop
  | refl (l) : LStep l l
  | tick (l) (t : T) (h : l.clock ≤ t) : LStep l { l with clock := t }
  | beat (l) : LStep l { l with obox := l.obox ++ [.time l.clock] }
  | remote (l) (σ : P) (t : T) : LStep l
      { l with remote := Function.update l.remote σ (max (l.remote σ) (t : WithBot T)) }
  | spot (l) (x : Tag C M T) : LStep l (l.spotL S x)
  | accept (l) (x : Tag C M T) : LStep l (l.acceptL S x)
  | proposeFalse (l) (x : Tag C M T) (h : x ∈ l.observed) : LStep l
      { l with props := insert (x, false) l.props, proposed := insert x l.proposed }
  | decide (l) (x : Tag C M T) (v : Bool) : LStep l
      { l with decs := insert (x, v) l.decs, decisions := Function.update l.decisions x (some v) }
  | process (l) (x : Tag C M T) (v : Bool) (hx : x ∈ l.cands) (hlp : l.lp < (x : WithBot (Tag C M T)))
      (hmin : ∀ z : Tag C M T, z ∈ l.cands → l.lp < (z : WithBot (Tag C M T)) → x ≤ z) (hv : l.decisions x = some v)
      (hb : (x.bet : WithBot T) ≤ lockTime S.q l.remote) : LStep l
      { (if v then l.order x else l) with
        lp := (x : WithBot (Tag C M T))
        procd := insert (x, v) l.procd }

lemma spot_srv_self (s : State P C M T) (p : P) (x : Tag C M T) :
    (s.spot S p x).srv p = (s.srv p).spotL S x := by
  rw [spot_srv, Function.update_self]; rfl

lemma spot_srv_ne (s : State P C M T) {p q : P} (h : q ≠ p) (x : Tag C M T) :
    (s.spot S p x).srv q = s.srv q := by
  rw [spot_srv, Function.update_of_ne h]

lemma accept_srv_self (s : State P C M T) (p : P) (x : Tag C M T) :
    (s.accept S p x).srv p = (s.srv p).acceptL S x := by
  have hp : ((s.spot S p x).srv p).proposed = (s.srv p).proposed := by rw [spot_srv_self]; rfl
  unfold State.accept SState.acceptL
  dsimp only
  rw [hp]
  split_ifs
  · exact spot_srv_self S s p x
  · simp [spot_srv_self, SState.spotL]

lemma accept_srv_ne (s : State P C M T) {p q : P} (h : q ≠ p) (x : Tag C M T) :
    (s.accept S p x).srv q = s.srv q := by
  simp only [State.accept]
  split_ifs
  · exact spot_srv_ne S s h x
  · simp [Function.update_of_ne h, spot_srv_ne S s h x]

/-- The server acting in an action (if any). -/
def Action.srvActor : Action P C M T → Option P
  | .tick p _ | .beat p | .srvRecv p _ _ | .cliMsg p _ _ | .proposeFalse p _ | .decide p _ _
  | .process p _ _ => some p
  | _ => none

lemma onSrv_srv_ne (s : State P C M T) {p q : P} (h : q ≠ p) (σ : P) (msg : Msg C M T) :
    (s.onSrv S p σ msg).srv q = s.srv q := by
  cases msg <;> simp [State.onSrv, Function.update_of_ne h, spot_srv_ne S s h]

lemma onCli_srv_ne (s : State P C M T) {p q : P} (h : q ≠ p) (θ : C) (msg : Msg C M T) :
    (s.onCli S p θ msg).srv q = s.srv q := by
  cases msg <;> simp [State.onCli, accept_srv_ne S s h]

lemma onDec_srv (s : State P C M T) (θ : C) (σ : P) (msg : Msg C M T) :
    (s.onDec θ σ msg).srv = s.srv := by
  cases msg <;> rfl

/-- A step does not change the state of servers other than the actor. -/
lemma exec_srv_ne (s : State P C M T) (a : Action P C M T) (q : P) (h : a.srvActor ≠ some q) :
    (exec S s a).srv q = s.srv q := by
  cases a with
  | tick p t => simp [Action.srvActor] at h; simp [exec, Function.update_of_ne (Ne.symm h)]
  | beat p => simp [Action.srvActor] at h; simp [exec, Function.update_of_ne (Ne.symm h)]
  | srvRecv p σ msg =>
    simp [Action.srvActor] at h
    simpa [exec] using onSrv_srv_ne S (s.recv S (.inl σ) (.inl p)) (Ne.symm h) σ msg
  | cliMsg p θ msg =>
    simp [Action.srvActor] at h
    simpa [exec] using onCli_srv_ne S (s.recv S (.inr θ) (.inl p)) (Ne.symm h) θ msg
  | proposeFalse p x => simp [Action.srvActor] at h; simp [exec, Function.update_of_ne (Ne.symm h)]
  | decide p x v => simp [Action.srvActor] at h; simp [exec, Function.update_of_ne (Ne.symm h)]
  | process p x v => simp [Action.srvActor] at h; simp [exec, Function.update_of_ne (Ne.symm h)]
  | cTick => rfl
  | cBroadcast => rfl
  | cRecv θ σ msg => simp [exec, onDec_srv]
  | cRetry θ m => simp only [exec]; split <;> rfl

/-- The state of any server changes by a local step. -/
lemma exec_srv_lstep (s : State P C M T) (a : Action P C M T) (ha : Enabled S s a) (q : P) :
    LStep S (s.srv q) ((exec S s a).srv q) := by
  by_cases h : a.srvActor = some q
  · cases a with
    | tick p t =>
      simp [Action.srvActor] at h; subst h
      simpa [exec] using LStep.tick _ t ha.2
    | beat p =>
      simp [Action.srvActor] at h; subst h
      simpa [exec] using LStep.beat _
    | srvRecv p σ msg =>
      simp [Action.srvActor] at h; subst h
      cases msg with
      | time t => simpa [exec, State.onSrv] using LStep.remote _ σ t
      | observe x => simpa [exec, State.onSrv, spot_srv_self] using LStep.spot _ x
      | message => simpa [exec, State.onSrv] using LStep.refl _
      | decision => simpa [exec, State.onSrv] using LStep.refl _
    | cliMsg p θ msg =>
      simp [Action.srvActor] at h; subst h
      cases msg with
      | message m b => simpa [exec, State.onCli, accept_srv_self] using LStep.accept _ _
      | _ => simpa [exec, State.onCli] using LStep.refl _
    | proposeFalse p x =>
      simp [Action.srvActor] at h; subst h
      simpa [exec] using LStep.proposeFalse _ x ha.2.1
    | decide p x v =>
      simp [Action.srvActor] at h; subst h
      simpa [exec] using LStep.decide _ x v
    | process p x v =>
      simp [Action.srvActor] at h; subst h
      obtain ⟨-, h1, h2, h3, h4, h5⟩ := ha
      simpa [exec] using LStep.process _ x v h1 h2 h3 h4 h5
    | _ => simp [Action.srvActor] at h
  · rw [exec_srv_ne S s a q h]; exact LStep.refl _

/-! ### Monotonicity along local steps -/

section Mono

variable {S} {l l' : SState P C M T} (h : LStep S l l')
include h

lemma LStep.props_mono : l.props ⊆ l'.props := by
  cases h <;> simp [SState.spotL, SState.acceptL, SState.order] <;> (try split_ifs) <;>
    simp [Finset.subset_insert]

lemma LStep.cands_mono : l.cands ⊆ l'.cands := by
  cases h <;> simp [SState.spotL, SState.acceptL, SState.order, spotCands] <;> (try split_ifs) <;>
    simp [Finset.subset_insert]

lemma LStep.observed_mono : l.observed ⊆ l'.observed := by
  cases h <;> simp [SState.spotL, SState.acceptL, SState.order] <;> (try split_ifs) <;>
    simp [Finset.subset_insert]

lemma LStep.decs_mono : l.decs ⊆ l'.decs := by
  cases h <;> simp [SState.spotL, SState.acceptL, SState.order] <;> (try split_ifs) <;>
    simp [Finset.subset_insert]

lemma LStep.orders_prefix : l.orders <+: l'.orders := by
  cases h <;> simp [SState.spotL, SState.acceptL, SState.order] <;> (try split_ifs) <;>
    simp

lemma LStep.remote_mono (σ : P) : l.remote σ ≤ l'.remote σ := by
  cases h with
  | remote ρ t =>
    by_cases hσ : σ = ρ
    · subst hσ; simp
    · simp [Function.update_of_ne hσ]
  | process x v =>
    simp only; split_ifs <;> simp [SState.order] <;> split_ifs <;> simp
  | _ => simp [SState.spotL, SState.acceptL] <;> (try split_ifs) <;> simp

lemma LStep.lockTime_mono (hq : 1 ≤ S.q) : lockTime S.q l.remote ≤ lockTime S.q l'.remote :=
  Flutter.lockTime_mono hq h.remote_mono

lemma LStep.obox_prefix : l.obox <+: l'.obox := by
  cases h with
  | process x v => simp only; split_ifs <;> simp [SState.order] <;> split_ifs <;> simp
  | _ => simp [SState.spotL, SState.acceptL] <;> (try split_ifs) <;> simp

lemma LStep.clock_mono : l.clock ≤ l'.clock := by
  cases h with
  | tick t ht => exact ht
  | process x v => simp only; split_ifs <;> simp [SState.order] <;> split_ifs <;> simp
  | _ => simp [SState.spotL, SState.acceptL] <;> (try split_ifs) <;> simp

end Mono

/-! ### The local invariant -/

/-- The property of Lemma 15 for a list of messages `o` and a tag `y`: every `Time` message with a
time `≥ y.bet` is preceded by an `Observe` message for `y`. -/
def L15 (o : List (Msg C M T)) (y : Tag C M T) : Prop :=
  ∀ (i : ℕ) (t : T), o[i]? = some (Msg.time t : Msg C M T) → y.bet ≤ t →
    ∃ j < i, o[j]? = some (Msg.observe y)

lemma L15.append_observe {o : List (Msg C M T)} {y : Tag C M T} (h : L15 o y) (x : Tag C M T) :
    L15 (o ++ [.observe x]) y := by
  unfold L15 at h ⊢
  intro i t hi hle
  by_cases hil : i < o.length
  · rw [List.getElem?_append_left hil] at hi
    obtain ⟨j, hj, hj'⟩ := h i t hi hle
    exact ⟨j, hj, by rw [List.getElem?_append_left (by omega)]; exact hj'⟩
  · rw [List.getElem?_append_right (by omega)] at hi
    rcases Nat.lt_or_ge (i - o.length) 1 with h1 | h1
    · simp [show i - o.length = 0 by omega] at hi
    · rw [List.getElem?_eq_none (by simpa using h1)] at hi; simp at hi

lemma L15.append_time {o : List (Msg C M T)} {y : Tag C M T} (h : L15 o y)
    (hy : Msg.observe y ∈ o) (c : T) : L15 (o ++ [.time c]) y := by
  unfold L15 at h ⊢
  intro i t hi hle
  by_cases hil : i < o.length
  · rw [List.getElem?_append_left hil] at hi
    obtain ⟨j, hj, hj'⟩ := h i t hi hle
    exact ⟨j, hj, by rw [List.getElem?_append_left (by omega)]; exact hj'⟩
  · obtain ⟨j, hj, hj'⟩ := List.getElem_of_mem hy
    have hi' : o.length ≤ i := by omega
    exact ⟨j, by omega, by rw [List.getElem?_append_left hj, List.getElem?_eq_getElem hj, hj']⟩

lemma L15.of_lt {o : List (Msg C M T)} {y : Tag C M T} (h : ∀ t, Msg.time t ∈ o → t < y.bet) :
    L15 o y := by
  unfold L15
  intro i t hi hle
  exact absurd hle (not_le.mpr (h t (List.mem_of_getElem? hi)))

/-- The local invariant of a correct server. -/
structure LInv (l : SState P C M T) : Prop where
  /-- `order` is a deterministic state machine: deliveries are `delSeq` of the order calls. -/
  dels : l.dels = delSeq l.orders
  /-- `delivered` is the set of delivered pairs (Observation 2). -/
  delivered : ∀ cm, cm ∈ l.delivered ↔ cm ∈ l.dels
  /-- Recorded decisions come from `con` (line 42). -/
  decisions : ∀ x v, l.decisions x = some v → (x, v) ∈ l.decs
  /-- Processed candidates were decided, and ordered if accepted (lines 43–46). -/
  procd : ∀ x v, (x, v) ∈ l.procd → (x, v) ∈ l.decs ∧ (v = true → x ∈ l.orders)
  /-- Order calls were processed with decision `True` (Lemma 18). -/
  orders_procd : ∀ x ∈ l.orders, (x, true) ∈ l.procd
  /-- Order calls are strictly increasing (Lemma 17). -/
  sorted : l.orders.SortedLT
  /-- Order calls are at most `last_processed` (Observation 8). -/
  orders_le : ∀ x ∈ l.orders, (x : WithBot (Tag C M T)) ≤ l.lp
  /-- The bet of `last_processed` is at most the lock time (used in Lemma 19). -/
  lp_lock : ∀ x : Tag C M T, l.lp = x → (x.bet : WithBot T) ≤ lockTime S.q l.remote
  /-- Candidates up to `last_processed` have been processed (Lemma 20). -/
  cands : ∀ z ∈ l.cands, (z : WithBot (Tag C M T)) ≤ l.lp → ∃ v, (z, v) ∈ l.procd
  /-- Proposed tags were observed. -/
  props_obs : ∀ x v, (x, v) ∈ l.props → x ∈ l.observed
  /-- `Time` messages carry past local times (clocks are non-decreasing). -/
  time_le : ∀ t, Msg.time t ∈ l.obox → t ≤ l.clock
  /-- Observed tags were relayed to every server (lines 24–28). -/
  obs_box : ∀ y ∈ l.observed, Msg.observe y ∈ l.obox
  /-- Lemma 15: if `p` proposed `True` for `y`, its `Observe` message for `y` precedes every
  `Time` message with a time `≥ y.bet`. -/
  lemma15 : ∀ y, (y, true) ∈ l.props → L15 l.obox y

lemma LInv.init (t0 : T) : LInv S (SState.init t0 : SState P C M T) where
  dels := by simp [SState.init, delSeq]
  delivered := by simp [SState.init]
  decisions := by simp [SState.init]
  procd := by simp [SState.init]
  orders_procd := by simp [SState.init]
  sorted := by simp [SState.init, List.sortedLT_iff_pairwise]
  orders_le := by simp [SState.init]
  lp_lock := by simp [SState.init]
  cands := by simp [SState.init]
  props_obs := by simp [SState.init]
  time_le := by simp [SState.init]
  obs_box := by simp [SState.init]
  lemma15 := by simp [SState.init]

lemma LInv.spotL {l : SState P C M T} (hI : LInv S l) (x : Tag C M T) : LInv S (l.spotL S x) := by
  have hc : ∀ z ∈ spotCands S l x, (z : WithBot (Tag C M T)) ≤ l.lp →
      ∃ v, (z, v) ∈ l.procd := by
    intro z hz hzl
    simp only [spotCands] at hz
    split_ifs at hz with hlt
    · rcases Finset.mem_insert.mp hz with rfl | hz
      · exfalso
        cases hlp : l.lp with
        | bot => rw [hlp] at hzl; exact absurd hzl (by simp)
        | coe y =>
          rw [hlp, WithBot.coe_le_coe] at hzl
          have := (WithBot.coe_le_coe.mpr (Tag.bet_le_of_le hzl)).trans (hI.lp_lock y hlp)
          exact absurd hlt (not_lt.mpr this)
      · exact hI.cands z hz hzl
    · exact hI.cands z hz hzl
  unfold SState.spotL
  split_ifs with hx
  · refine { hI with
      cands := hc
      props_obs := fun y v hy => Finset.mem_insert_of_mem (hI.props_obs y v hy)
      obs_box := ?_ }
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact hI.obs_box _ hx
    · exact hI.obs_box y hy
  · refine { hI with
      cands := hc
      props_obs := fun y v hy => Finset.mem_insert_of_mem (hI.props_obs y v hy)
      time_le := fun t ht => hI.time_le t (by simpa using ht)
      obs_box := ?_
      lemma15 := fun y hy => (hI.lemma15 y hy).append_observe x }
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · simp
    · exact List.mem_append_left _ (hI.obs_box y hy)

lemma LInv.addProp {l : SState P C M T} (hI : LInv S l) (x : Tag C M T) (v : Bool)
    (hx : x ∈ l.observed) (hv : v = true → ∀ t, Msg.time t ∈ l.obox → t < x.bet) :
    LInv S { l with props := insert (x, v) l.props, proposed := insert x l.proposed } := by
  refine { hI with props_obs := ?_, lemma15 := ?_ }
  · intro y w hy
    rcases Finset.mem_insert.mp hy with h | hy
    · simp only [Prod.mk.injEq] at h; obtain ⟨rfl, -⟩ := h; exact hx
    · exact hI.props_obs y w hy
  · intro y hy
    rcases Finset.mem_insert.mp hy with h | hy
    · simp only [Prod.mk.injEq] at h; obtain ⟨rfl, rfl⟩ := h
      exact L15.of_lt (hv rfl)
    · exact hI.lemma15 y hy

lemma LInv.step (hq : 1 ≤ S.q) {l l' : SState P C M T} (hI : LInv S l) (h : LStep S l l') :
    LInv S l' := by
  have hlock := h.lockTime_mono hq
  cases h with
  | refl => exact hI
  | tick t ht =>
    exact { hI with time_le := fun t' h => (hI.time_le t' h).trans ht }
  | beat =>
    refine { hI with
      time_le := ?_
      obs_box := fun y hy => List.mem_append_left _ (hI.obs_box y hy)
      lemma15 := fun y hy => (hI.lemma15 y hy).append_time (hI.obs_box y (hI.props_obs y _ hy)) _ }
    intro t ht
    rcases List.mem_append.mp ht with ht | ht
    · exact hI.time_le t ht
    · simp only [List.mem_singleton, Msg.time.injEq] at ht; subst ht; exact le_rfl
  | remote σ t =>
    refine { hI with lp_lock := fun x hx => (hI.lp_lock x hx).trans hlock }
  | spot x => exact hI.spotL S x
  | accept x =>
    have h1 := hI.spotL S x
    unfold SState.acceptL
    split_ifs
    · exact h1
    · refine h1.addProp S x _ (by simp [SState.spotL]) ?_
      intro hv t ht
      have := h1.time_le t ht
      simp only [decide_eq_true_eq] at hv
      simp only [SState.spotL] at this
      exact lt_of_le_of_lt this hv
  | proposeFalse x hx => exact hI.addProp S x false hx (by simp)
  | decide x v =>
    refine { hI with
      decisions := ?_
      procd := fun y w hy => ⟨Finset.mem_insert_of_mem (hI.procd y w hy).1, (hI.procd y w hy).2⟩ }
    intro y w hy
    by_cases hxy : y = x
    · subst hxy
      simp only [Function.update_self, Option.some.injEq] at hy
      subst hy
      exact Finset.mem_insert_self _ _
    · simp only [Function.update_of_ne hxy] at hy
      exact Finset.mem_insert_of_mem (hI.decisions y w hy)
  | process x v hx hlp hmin hv hb =>
    -- the effect of `order`
    have hord : ((if v then l.order x else l).orders = if v then l.orders ++ [x] else l.orders) ∧
        ((if v then l.order x else l).dels = delSeq (if v then l.orders ++ [x] else l.orders)) ∧
        (∀ cm, cm ∈ (if v then l.order x else l).delivered ↔
          cm ∈ (if v then l.order x else l).dels) ∧
        (if v then l.order x else l).decs = l.decs ∧
        (if v then l.order x else l).decisions = l.decisions ∧
        (if v then l.order x else l).cands = l.cands ∧
        (if v then l.order x else l).remote = l.remote ∧
        (if v then l.order x else l).props = l.props ∧
        (if v then l.order x else l).observed = l.observed ∧
        (if v then l.order x else l).clock = l.clock ∧
        (if v then l.order x else l).obox = l.obox := by
      split_ifs with hv'
      · unfold SState.order
        rw [delSeq_concat, ← hI.dels]
        have hd := hI.delivered (x.client, x.msg)
        split_ifs with h1 h2 h2
        · simp [hI.delivered]
        · exact absurd (hd.mp h1) h2
        · exact absurd (hd.mpr h2) h1
        · refine ⟨rfl, rfl, ?_, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
          intro cm
          simp [hI.delivered, or_comm]
      · exact ⟨rfl, hI.dels, hI.delivered, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    obtain ⟨ho, hd, hdl, hdc, hdn, hca, hre, hpr, hob, hcl, hbx⟩ := hord
    have hxv : (x, v) ∈ l.decs := hI.decisions x v hv
    -- old order calls are below `x`
    have hlt : ∀ y ∈ l.orders, y < x := fun y hy =>
      WithBot.coe_lt_coe.mp ((hI.orders_le y hy).trans_lt hlp)
    constructor
    · exact hd.trans (by rw [ho])
    · exact hdl
    · intro y w hy; rw [hdc]; exact hI.decisions y w (hdn ▸ hy)
    · intro y w hy
      simp only [Finset.mem_insert, Prod.mk.injEq] at hy
      rw [hdc, ho]
      rcases hy with ⟨rfl, rfl⟩ | hy
      · refine ⟨hxv, fun hv' => ?_⟩
        simp [hv']
      · refine ⟨(hI.procd y w hy).1, fun hw => ?_⟩
        have := (hI.procd y w hy).2 hw
        split_ifs <;> simp [this]
    · intro y hy
      rw [ho] at hy
      split_ifs at hy with hv'
      · rcases List.mem_append.mp hy with hy | hy
        · exact Finset.mem_insert_of_mem (hI.orders_procd y hy)
        · simp only [List.mem_singleton] at hy; subst hy; subst hv'; exact Finset.mem_insert_self _ _
      · exact Finset.mem_insert_of_mem (hI.orders_procd y hy)
    · rw [ho]
      split_ifs
      · rw [List.sortedLT_iff_pairwise, List.pairwise_append] at *
        exact ⟨List.sortedLT_iff_pairwise.mp hI.sorted, List.pairwise_singleton _ _,
          fun a ha b hb => by simp only [List.mem_singleton] at hb; subst hb; exact hlt a ha⟩
      · exact hI.sorted
    · intro y hy
      rw [ho] at hy
      simp only
      split_ifs at hy
      · rcases List.mem_append.mp hy with hy | hy
        · exact WithBot.coe_le_coe.mpr (hlt y hy).le
        · simp only [List.mem_singleton] at hy; subst hy; exact le_rfl
      · exact WithBot.coe_le_coe.mpr (hlt y hy).le
    · intro y hy
      simp only [WithBot.coe_inj] at hy
      subst hy
      rw [hre]; exact hb
    · intro z hz hzl
      rw [hca] at hz
      simp only [WithBot.coe_le_coe] at hzl
      by_cases hz' : (z : WithBot (Tag C M T)) ≤ l.lp
      · obtain ⟨w, hw⟩ := hI.cands z hz hz'
        exact ⟨w, Finset.mem_insert_of_mem hw⟩
      · have := le_antisymm hzl (hmin z hz (not_le.mp hz'))
        subst this
        exact ⟨v, Finset.mem_insert_self _ _⟩
    · intro y w hy
      rw [hob]; exact hI.props_obs y w (hpr ▸ hy)
    · intro t ht; simp only [hcl, hbx] at ht ⊢; exact hI.time_le t ht
    · intro y hy; simp only [hob, hbx] at hy ⊢; exact hI.obs_box y hy
    · intro y hy; simp only [hpr, hbx] at hy ⊢; exact hI.lemma15 y hy

end Podc.FastByzantineTOB.Flutter
