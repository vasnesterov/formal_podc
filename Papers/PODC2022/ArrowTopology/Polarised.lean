import Papers.PODC2022.ArrowTopology.Domains

/-!
# The polarised domain `N''_I` (Section 4.2)

Section 4.2 of S. Rajsbaum, A. Raventós-Pujol, *A Distributed Combinatorial Topology Approach to
Arrow's Impossibility Theorem*, PODC 2022: a counterexample to the hypothesis (Baryshnikov,
Lauwers, Baigent) that a domain admits Arrovian aggregation iff its induced complex is
contractible.

Two right-wing parties `A, B` (`T3.x, T3.y`) and a left-wing party `C` (`T3.z`); two voters; the
polarised domain consists of the profiles in which no voter ranks `C` in the middle. The
aggregation map has two local dictators: voter `0` on `{A, B}`, voter `1` on `{A, C}` and
`{B, C}`.

* `polarF_P_AB`, `polarF_P_AC`, `polarF_P_BC`: the defining equations of the paper's `F`
  (`F(R)` is a well-defined strict total order on the domain by construction).
* `polarised_unanimity`, `polarised_iia`, `polarised_nonDictatorial`, `polarised_admits`:
  `F` is unanimous, IIA and non-dictatorial on the polarised domain.
* Non-contractibility: Mathlib has no geometric realisation of abstract simplicial complexes, so we
  only prove the combinatorial certificate `polarised_fVector`: the complex generated by the 16
  triangles of the domain has 12 vertices, 36 edges and 16 triangles, hence Euler characteristic
  `12 − 36 + 16 = −8 ≠ 1` (`polarised_euler`). That a contractible complex has Euler
  characteristic `1` is standard (homotopy invariance of homology) but **not** formalized here.
* `polarised_covers`: the polarised domain contains all 12 vertices of `N_I`, so Theorem 6 of the
  full version applies to it (`polarised_misses_criticalPair`).
-/

namespace Podc.ArrowTopology

open Cslib.SocialChoice

namespace ThreeAlts

variable {X : Type*} (T3 : ThreeAlts X)

/-- `C` (`T3.z`) is not the middle alternative of `r`. -/
def ZNotMiddle (r : Pref X) : Prop :=
  ¬ (r.P T3.x T3.z ∧ r.P T3.z T3.y) ∧ ¬ (r.P T3.y T3.z ∧ r.P T3.z T3.x)

/-- The polarised domain `N''_I`: no voter ranks `C` in the middle. -/
def polarised : Set (Profile (Fin 2) X) := {R | ∀ i, T3.ZNotMiddle (R i)}

theorem sig1_one_iff (r : Pref X) : T3.sig1 r 1 = true ↔ r.P T3.y T3.z := T3.sig1_eq_true_iff r 1

theorem sig1_two_iff (r : Pref X) : T3.sig1 r 2 = true ↔ r.P T3.z T3.x := T3.sig1_eq_true_iff r 2

theorem sig1_one_false_iff (r : Pref X) : T3.sig1 r 1 = false ↔ r.P T3.z T3.y :=
  T3.sig1_eq_false_iff r 1

theorem sig1_two_false_iff (r : Pref X) : T3.sig1 r 2 = false ↔ r.P T3.x T3.z :=
  T3.sig1_eq_false_iff r 2

/-- `C` is not in the middle iff the signs on `BC` and `CA` differ. -/
theorem zNotMiddle_iff (r : Pref X) : T3.ZNotMiddle r ↔ T3.sig1 r 1 ≠ T3.sig1 r 2 := by
  unfold ZNotMiddle
  rw [← T3.sig1_two_false_iff, ← T3.sig1_one_false_iff, ← T3.sig1_one_iff, ← T3.sig1_two_iff]
  cases T3.sig1 r 1 <;> cases T3.sig1 r 2 <;> simp

/-- The paper's aggregation map: `AB` decided by voter `0`, `BC` and `CA` by voter `1`. -/
noncomputable def polarF : Aggregation (Fin 2) X := fun R =>
  T3.ofSigns (T3.sig1 (R 0) 0) (T3.sig1 (R 1) 1) (T3.sig1 (R 1) 2)

/-- The voter deciding the pair `pr j`. -/
def localDictator (j : Fin 3) : Fin 2 := if j = 0 then 0 else 1

theorem sig1_polarF {R : Profile (Fin 2) X} (hR : R ∈ T3.polarised) (j : Fin 3) :
    T3.sig1 (T3.polarF R) j = T3.sig1 (R (localDictator j)) j := by
  have hout : OutTri (T3.sig1 (R 0) 0) (T3.sig1 (R 1) 1) (T3.sig1 (R 1) 2) :=
    fun h => (T3.zNotMiddle_iff (R 1)).1 (hR 1) h.2
  have := T3.sig1_ofSigns hout
  fin_cases j
  · exact this.1
  · exact this.2.1
  · exact this.2.2

/-- On each pair, `F` follows the local dictator of that pair. -/
theorem polarF_P_iff {R : Profile (Fin 2) X} (hR : R ∈ T3.polarised) {a b : X} {j : Fin 3}
    (hj : T3.pr j = (a, b) ∨ T3.pr j = (b, a)) :
    (T3.polarF R).P a b ↔ (R (localDictator j)).P a b :=
  T3.P_iff_P_of_sig1_eq hj (T3.sig1_polarF hR j)

/-- Sec. 4.2: `A F(R) B ⇔ A R₁ B`. -/
theorem polarF_P_AB {R : Profile (Fin 2) X} (hR : R ∈ T3.polarised) :
    (T3.polarF R).P T3.x T3.y ↔ (R 0).P T3.x T3.y :=
  T3.polarF_P_iff hR (j := 0) (Or.inl rfl)

/-- Sec. 4.2: `A F(R) C ⇔ A R₂ C`. -/
theorem polarF_P_AC {R : Profile (Fin 2) X} (hR : R ∈ T3.polarised) :
    (T3.polarF R).P T3.x T3.z ↔ (R 1).P T3.x T3.z :=
  T3.polarF_P_iff hR (j := 2) (Or.inr rfl)

/-- Sec. 4.2: `B F(R) C ⇔ B R₂ C`. -/
theorem polarF_P_BC {R : Profile (Fin 2) X} (hR : R ∈ T3.polarised) :
    (T3.polarF R).P T3.y T3.z ↔ (R 1).P T3.y T3.z :=
  T3.polarF_P_iff hR (j := 1) (Or.inl rfl)

theorem polarised_unanimity : UnanimityOn T3.polarised T3.polarF := by
  intro R hR a b hab
  have hne : a ≠ b := (R 0).ne_of_P (hab 0)
  obtain ⟨j, hj⟩ := T3.exists_pr a b hne
  exact (T3.polarF_P_iff hR hj).2 (hab _)

theorem polarised_iia : IIAOn T3.polarised T3.polarF := by
  intro R hR S hS a b h
  by_cases hne : a = b
  · subst hne; simp [(T3.polarF R).irrefl, (T3.polarF S).irrefl]
  obtain ⟨j, hj⟩ := T3.exists_pr a b hne
  rw [T3.polarF_P_iff hR hj, T3.polarF_P_iff hS hj]
  exact h _

/-- The witness profile `(ABC, CBA)`: `F` gives `CAB`. -/
noncomputable def witness : Profile (Fin 2) X :=
  ![T3.ofSigns true true false, T3.ofSigns false false true]

theorem witness_sig1 :
    (T3.sig1 (T3.witness 0) 0 = true ∧ T3.sig1 (T3.witness 0) 1 = true ∧
      T3.sig1 (T3.witness 0) 2 = false) ∧
    (T3.sig1 (T3.witness 1) 0 = false ∧ T3.sig1 (T3.witness 1) 1 = false ∧
      T3.sig1 (T3.witness 1) 2 = true) :=
  ⟨T3.sig1_ofSigns (by decide), T3.sig1_ofSigns (by decide)⟩

theorem witness_mem : T3.witness ∈ T3.polarised := by
  intro i
  rw [zNotMiddle_iff]
  obtain ⟨⟨-, a1, a2⟩, ⟨-, b1, b2⟩⟩ := T3.witness_sig1
  fin_cases i
  · simp only [Fin.zero_eta, Fin.isValue]; rw [a1, a2]; decide
  · simp only [Fin.mk_one, Fin.isValue]; rw [b1, b2]; decide

theorem polarised_nonDictatorial (k : Fin 2) : ¬ IsDictatorOn T3.polarised T3.polarF k := by
  intro hk
  obtain ⟨⟨a0, -, a2⟩, ⟨b0, -, b2⟩⟩ := T3.witness_sig1
  have hR := T3.witness_mem
  fin_cases k
  · -- voter 0 ranks `A` above `C`, but `F` follows voter 1, who ranks `C` above `A`
    have h0 : (T3.witness 0).P T3.x T3.z := (T3.sig1_two_false_iff _).1 a2
    have h1 : (T3.witness 1).P T3.z T3.x := (T3.sig1_two_iff _).1 b2
    have := (T3.polarF_P_AC hR).1 (hk _ hR _ _ h0)
    exact (T3.witness 1).asymm this h1
  · -- voter 1 ranks `B` above `A`, but `F` follows voter 0, who ranks `A` above `B`
    have h1 : (T3.witness 1).P T3.y T3.x := (T3.sig1_eq_false_iff _ 0).1 b0
    have h0 : (T3.witness 0).P T3.x T3.y := (T3.sig1_eq_true_iff _ 0).1 a0
    have hF := hk _ hR _ _ h1
    have := (T3.polarF_P_AB hR).2 h0
    exact (T3.polarF T3.witness).asymm this hF

/-- Sec. 4.2 of [Rajsbaum–Raventós-Pujol, PODC 2022]: the polarised domain admits a unanimous,
IIA, non-dictatorial aggregation map (namely `polarF`). -/
theorem polarised_admits : AdmitsNonDictatorial T3.polarised :=
  ⟨T3.polarF, T3.polarised_unanimity, T3.polarised_iia, T3.polarised_nonDictatorial⟩

end ThreeAlts

/-! ### The concrete polarised domain and its complex -/

/-- The 16 profiles of the polarised domain: each voter has `ABC`, `BAC`, `CAB` or `CBA`. -/
def polarList : List Prof2 :=
  [Ord3.ABC, .BAC, .CAB, .CBA].flatMap fun a => [Ord3.ABC, .BAC, .CAB, .CBA].map fun b => (a, b)

theorem Ord3.zNotMiddle_iff (o : Ord3) :
    Alt.three.ZNotMiddle o.toPref ↔ o = .ABC ∨ o = .BAC ∨ o = .CAB ∨ o = .CBA := by
  rw [ThreeAlts.zNotMiddle_iff, Ord3.sig1_toPref, Ord3.sig1_toPref]
  cases o <;> decide

theorem polarised_eq_dom : Alt.three.polarised = dom polarList := by
  ext R
  obtain ⟨p, rfl⟩ := Prof2.toProfile_surjective R
  rw [mem_dom]
  simp only [ThreeAlts.polarised, Set.mem_ofPred_eq, Fin.forall_fin_two, Prof2.toProfile, prof,
    Matrix.cons_val_zero, Matrix.cons_val_one, Ord3.zNotMiddle_iff]
  obtain ⟨a, b⟩ := p
  revert a b; decide

/-- Cross-check with the Boolean checker. -/
theorem admitsB_polarList : admitsB polarList = true := by decide +kernel

/-- The polarised domain contains all 12 vertices of `N_I` (every pair is free). -/
theorem polarised_covers : ∀ (j : Fin 3) (σ : Fin 2 → Bool), ∃ p ∈ polarList, tri p j = σ := by
  decide +kernel

/-- Consistently with Theorem 6 of the full version, the polarised domain misses both profiles of
a critical pair. -/
theorem polarised_misses_criticalPair :
    ∃ p1 p2, IsCriticalPair p1 p2 ∧ p1 ∉ polarList ∧ p2 ∉ polarList := by
  have : ∃ q ∈ cpList, q.1 ∉ polarList ∧ q.2 ∉ polarList := by decide +kernel
  obtain ⟨⟨p1, p2⟩, hq, h⟩ := this
  exact ⟨p1, p2, mem_cpList.1 hq, h⟩

/-- The triangle of `N_I` of a profile, as a set of vertices. -/
def triangle (p : Prof2) : Finset (Vtx (Fin 2)) := Finset.univ.image fun j => (j, tri p j)

/-- The simplicial complex generated by the triangles of the profiles in `L` (nonempty faces). -/
def complexOf (L : List Prof2) : Finset (Finset (Vtx (Fin 2))) :=
  (L.toFinset.biUnion fun p => (triangle p).powerset).erase ∅

/-- Number of `k`-dimensional faces. -/
def numFaces (K : Finset (Finset (Vtx (Fin 2)))) (k : ℕ) : ℕ :=
  (K.filter fun σ => σ.card = k + 1).card

/-- Sec. 4.2 (non-contractibility certificate): the complex of the polarised domain has 12
vertices, 36 edges and 16 triangles. -/
theorem polarised_fVector : numFaces (complexOf polarList) 0 = 12 ∧
    numFaces (complexOf polarList) 1 = 36 ∧ numFaces (complexOf polarList) 2 = 16 ∧
    (complexOf polarList).card = 12 + 36 + 16 := by
  decide +kernel

/-- Euler characteristic `V − E + F = −8` of the complex of the polarised domain. Since a
contractible complex has Euler characteristic `1` (not formalized: Mathlib has no geometric
realisation of simplicial complexes), the complex is not contractible, as claimed in Sec. 4.2. -/
theorem polarised_euler :
    (numFaces (complexOf polarList) 0 : ℤ) - numFaces (complexOf polarList) 1 +
      numFaces (complexOf polarList) 2 = -8 := by
  obtain ⟨h0, h1, h2, -⟩ := polarised_fVector
  rw [h0, h1, h2]; norm_num

end Podc.ArrowTopology
