import Papers.PODC2014.SignatureFreeBA.Local

/-!
# Embedding the one-round machine into the asynchronous model

Global states of the counterexample are assembled from one local state per round (`asm`).
`apply` executes an adversary event (a step of `Cslib.Byzantine.AsyncBroadcast.Step` if it is
enabled, otherwise nothing), and `apply_embed` shows that an enabled local event of round `r`
acts on the assembled state exactly as the local machine predicts.
-/

namespace Podc.SignatureFreeBA.Attack

open Cslib.Byzantine.AsyncBroadcast Podc.SignatureFreeBA Podc.SignatureFreeBA.Local

/-- The processes: `0, 1, 2` correct, `3` Byzantine. -/
abbrev Pr := Fin 4

/-- Inputs: `0, 1` propose `0`, process `2` proposes `1`. -/
def x0 : Pr → Bool := ![false, false, true, false]

/-- A message of round `r`. -/
def emb (r : ℕ) : LM → Msg
  | .bval v d => .bval r v d
  | .aux v => .aux r v

/-- The round of a message. -/
def rnd : Msg → ℕ
  | .bval r _ _ => r
  | .aux r _ => r

/-- A message without its round. -/
def loc : Msg → LM
  | .bval _ v d => .bval v d
  | .aux _ v => .aux v

@[simp] theorem rnd_emb (r : ℕ) (m : LM) : rnd (emb r m) = r := by cases m <;> rfl
@[simp] theorem loc_emb (r : ℕ) (m : LM) : loc (emb r m) = m := by cases m <;> rfl

theorem emb_rnd_loc (m : Msg) : emb (rnd m) (loc m) = m := by cases m <;> rfl

/-- `m` is an estimate for round `r + 1` that `p` computed in round `r`. -/
def NxtSent (L : ℕ → LS) (p : Pr) (m : Msg) : Prop :=
  ∃ r v d, m = .bval (r + 1) v (some d) ∧ (L r).nxt p = some (v, d)

/-- The global state assembled from the local states `L r` of all rounds. -/
def asm (L : ℕ → LS) (B : Set Pr) : State Pr Msg Bool where
  sent := {e | (L (rnd e.2)).sent e.1 (loc e.2) = true ∨ NxtSent L e.1 e.2}
  rcv := {e | (L (rnd e.2.2)).rcv e.1 e.2.1 (loc e.2.2) = true}
  dec := fun _ => none
  bad := B

theorem mem_sent_asm {L : ℕ → LS} {B : Set Pr} {p : Pr} {m : Msg} :
    (p, m) ∈ (asm L B).sent ↔ (L (rnd m)).sent p (loc m) = true ∨ NxtSent L p m := Iff.rfl

theorem mem_rcv_asm {L : ℕ → LS} {B : Set Pr} {q s : Pr} {m : Msg} :
    (q, s, m) ∈ (asm L B).rcv ↔ (L (rnd m)).rcv q s (loc m) = true := Iff.rfl

/-! ### Adversary events -/

/-- Events chosen by the adversary. `est p r V`: `p` executes lines 05–11 of round `r` with
`values = V`; the coin is supplied by the system, not by the adversary. -/
inductive Ev
  | send (p : Pr) (m : Msg)
  | est (p : Pr) (r : ℕ) (V : Finset Bool)
  | deliver (q s : Pr) (m : Msg)
  | inject (q s : Pr) (m : Msg)
  | corrupt (p : Pr)
  | skip

/-- The estimate message of `est p r V` under the coin sequence `coin`. -/
def estMsg (coin : ℕ → Bool) (r : ℕ) (V : Finset Bool) : Msg :=
  .bval (r + 1) (nextEst V (coin r)).1 (some (nextEst V (coin r)).2)

open Classical in
/-- Execute an event if it is enabled (otherwise stutter). -/
noncomputable def apply (coin : ℕ → Bool) (e : Ev) (σ : State Pr Msg Bool) : State Pr Msg Bool :=
  match e with
  | .send p m => if p ∉ σ.bad ∧ (mmr 1 coin).send p (x0 p) (σ.inbox p) (σ.out p) m
      then { σ with sent := insert (p, m) σ.sent } else σ
  | .est p r V => if p ∉ σ.bad ∧ (mmr 1 coin).send p (x0 p) (σ.inbox p) (σ.out p) (estMsg coin r V)
      then { σ with sent := insert (p, estMsg coin r V) σ.sent } else σ
  | .deliver q s m => if (s, m) ∈ σ.sent then { σ with rcv := insert (q, s, m) σ.rcv } else σ
  | .inject q s m => if s ∈ σ.bad then { σ with rcv := insert (q, s, m) σ.rcv } else σ
  | .corrupt p => if (insert p σ.bad).ncard ≤ 1 then { σ with bad := insert p σ.bad } else σ
  | .skip => σ

theorem apply_step (coin : ℕ → Bool) (e : Ev) (σ : State Pr Msg Bool) :
    Step (mmr 1 coin) x0 .byzantine 1 σ (apply coin e σ) ∨ apply coin e σ = σ := by
  cases e with
  | send p m =>
    simp only [apply]; split_ifs with h
    · exact Or.inl (Step.send _ _ _ h.1 h.2)
    · exact Or.inr rfl
  | est p r V =>
    simp only [apply]; split_ifs with h
    · exact Or.inl (Step.send _ _ _ h.1 h.2)
    · exact Or.inr rfl
  | deliver q s m =>
    simp only [apply]; split_ifs with h
    · exact Or.inl (Step.deliver _ _ _ _ h)
    · exact Or.inr rfl
  | inject q s m =>
    simp only [apply]; split_ifs with h
    · exact Or.inl (Step.inject _ _ _ _ rfl h)
    · exact Or.inr rfl
  | corrupt p =>
    simp only [apply]; split_ifs with h
    · exact Or.inl (Step.corrupt _ _ h)
    · exact Or.inr rfl
  | skip => exact Or.inr rfl

/-- The execution generated by a strategy `strat` (a function of the time and of the current
global state) under the coin sequence `coin`. -/
noncomputable def gen (strat : ℕ → State Pr Msg Bool → Ev) (coin : ℕ → Bool) :
    ℕ → State Pr Msg Bool
  | 0 => State.init
  | i + 1 => apply coin (strat i (gen strat coin i)) (gen strat coin i)

/-- The generated execution as an execution of the asynchronous system. -/
noncomputable def genExec (strat : ℕ → State Pr Msg Bool → Ev) (coin : ℕ → Bool) :
    Exec (mmr 1 coin) x0 .byzantine 1 :=
  ⟨gen strat coin, rfl, fun _ => apply_step coin _ _⟩

/-- A local event of round `r` as an adversary event. -/
def embedEv (r : ℕ) : LE → Ev
  | .dlv q s m => .deliver q s (emb r m)
  | .inj q m => .inject q 3 (emb r m)
  | .echo p v => .send p (.bval r v none)
  | .aux p w => .send p (.aux r w)
  | .est p V => .est p r V
  | .skip => .skip

/-! ### Counting in assembled states -/

theorem bvCnt_asm (L : ℕ → LS) (B : Set Pr) (p : Pr) (r : ℕ) (v : Bool) :
    bvCnt ((asm L B).inbox p) r v = lcnt (L r) p v := by
  unfold bvCnt cntP lcnt
  rw [← Set.ncard_coe_finset]
  congr 1
  ext s
  simp only [Set.mem_ofPred_eq, State.inbox, Finset.coe_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨m, hm, d, rfl⟩
    exact ⟨d, hm⟩
  · rintro ⟨d, hd⟩
    exact ⟨.bval r v d, hd, d, rfl⟩

theorem binVal_asm (L : ℕ → LS) (B : Set Pr) (p : Pr) (r : ℕ) (v : Bool) :
    BinVal 1 ((asm L B).inbox p) r v ↔ lbin (L r) p v := by
  unfold BinVal lbin
  rw [bvCnt_asm]

theorem auxQuorum_asm (L : ℕ → LS) (B : Set Pr) (p : Pr) (r : ℕ) (V : Finset Bool) :
    AuxQuorum 1 ((asm L B).inbox p) r V ↔ lquorum (L r) p V := by
  unfold AuxQuorum lquorum
  simp only [Fintype.card_fin, Nat.add_one_sub_one, binVal_asm]
  rfl

/-! ### Simulation of local events -/

/-- Frame conditions for simulating round `r`: the estimates computed in round `r − 1` are the
own broadcasts of round `r`, and round `r + 1` has no local broadcasts yet. -/
structure Frame (L : ℕ → LS) (r : ℕ) : Prop where
  pos : 1 ≤ r
  cons : ∀ p v d, (L (r - 1)).nxt p = some (v, d) → (L r).sent p (.bval v (some d)) = true
  next : ∀ p m, (L (r + 1)).sent p m = false

theorem state_eq {σ τ : State Pr Msg Bool} (h1 : σ.sent = τ.sent) (h2 : σ.rcv = τ.rcv)
    (h3 : σ.dec = τ.dec) (h4 : σ.bad = τ.bad) : σ = τ := by
  cases σ; cases τ; simp_all

theorem nxtSent_update_of_nxt (L : ℕ → LS) (r : ℕ) (ℓ : LS) (h : ℓ.nxt = (L r).nxt) (p : Pr)
    (m : Msg) : NxtSent (Function.update L r ℓ) p m ↔ NxtSent L p m := by
  unfold NxtSent
  refine exists_congr fun r' => exists_congr fun v => exists_congr fun d => and_congr_right
    fun _ => ?_
  by_cases hr : r' = r
  · subst hr; simp [h]
  · simp [Function.update_of_ne hr]

theorem asm_update_rcv (L : ℕ → LS) (B : Set Pr) (r : ℕ) (ℓ : LS) (hs : ℓ.sent = (L r).sent)
    (hn : ℓ.nxt = (L r).nxt) (q s : Pr) (m : LM)
    (hr : ∀ a b c, ℓ.rcv a b c = ((a == q && b == s && c == m) || (L r).rcv a b c)) :
    asm (Function.update L r ℓ) B = { asm L B with rcv := insert (q, s, emb r m) (asm L B).rcv } := by
  refine state_eq ?_ ?_ rfl rfl
  · ext ⟨p, m'⟩
    simp only [asm, Set.mem_ofPred_eq, nxtSent_update_of_nxt L r ℓ hn]
    by_cases h : rnd m' = r
    · rw [h]; simp [hs]
    · simp [Function.update_of_ne h]
  · ext ⟨a, b, m'⟩
    simp only [asm, Set.mem_ofPred_eq, Set.mem_insert_iff, Prod.mk.injEq]
    by_cases h : rnd m' = r
    · rw [h, Function.update_self, hr]
      constructor
      · intro h'
        simp only [Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq] at h'
        rcases h' with ⟨⟨rfl, rfl⟩, rfl⟩ | h'
        · left; exact ⟨rfl, rfl, by rw [← h, emb_rnd_loc]⟩
        · right; exact h'
      · rintro (⟨rfl, rfl, rfl⟩ | h')
        · simp
        · simp [h']
    · rw [Function.update_of_ne h]
      constructor
      · exact Or.inr
      · rintro (⟨rfl, rfl, rfl⟩ | h')
        · exact absurd (rnd_emb r m) h
        · exact h'

theorem asm_update_sent (L : ℕ → LS) (B : Set Pr) (r : ℕ) (ℓ : LS) (hc : ℓ.rcv = (L r).rcv)
    (hn : ℓ.nxt = (L r).nxt) (p : Pr) (m : LM)
    (hs : ∀ a c, ℓ.sent a c = ((a == p && c == m) || (L r).sent a c)) :
    asm (Function.update L r ℓ) B = { asm L B with sent := insert (p, emb r m) (asm L B).sent } := by
  refine state_eq ?_ ?_ rfl rfl
  · ext ⟨a, m'⟩
    simp only [asm, Set.mem_ofPred_eq, Set.mem_insert_iff, Prod.mk.injEq,
      nxtSent_update_of_nxt L r ℓ hn]
    by_cases h : rnd m' = r
    · rw [h, Function.update_self, hs]
      constructor
      · intro h'
        simp only [Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq] at h'
        rcases h' with (⟨rfl, rfl⟩ | h') | h'
        · left; exact ⟨rfl, by rw [← h, emb_rnd_loc]⟩
        · right; left; exact h'
        · right; right; exact h'
      · rintro (⟨rfl, rfl⟩ | h' | h')
        · simp
        · simp [h']
        · right; exact h'
    · rw [Function.update_of_ne h]
      constructor
      · exact Or.inr
      · rintro (⟨rfl, rfl⟩ | h')
        · exact absurd (rnd_emb r m) h
        · exact h'
  · ext ⟨a, b, m'⟩
    simp only [asm, Set.mem_ofPred_eq]
    by_cases h : rnd m' = r
    · rw [h]; simp [hc]
    · simp [Function.update_of_ne h]

theorem asm_update_nxt (L : ℕ → LS) (B : Set Pr) (r : ℕ) (ℓ : LS) (hs : ℓ.sent = (L r).sent)
    (hc : ℓ.rcv = (L r).rcv) (p : Pr) (v d : Bool) (hp : (L r).nxt p = none)
    (hn : ℓ.nxt = fun a => if a = p then some (v, d) else (L r).nxt a) :
    asm (Function.update L r ℓ) B =
      { asm L B with sent := insert (p, .bval (r + 1) v (some d)) (asm L B).sent } := by
  refine state_eq ?_ ?_ rfl rfl
  · ext ⟨a, m'⟩
    simp only [asm, Set.mem_ofPred_eq, Set.mem_insert_iff, Prod.mk.injEq]
    have h1 : (Function.update L r ℓ (rnd m')).sent = (L (rnd m')).sent := by
      by_cases h : rnd m' = r
      · rw [h, Function.update_self, hs]
      · rw [Function.update_of_ne h]
    rw [h1]
    unfold NxtSent
    constructor
    · rintro (h' | ⟨r', v', d', rfl, h'⟩)
      · exact Or.inr (Or.inl h')
      · by_cases hr : r' = r
        · subst hr
          rw [Function.update_self, hn] at h'
          by_cases ha : a = p
          · subst ha
            simp only [ite_true, Option.some.injEq, Prod.mk.injEq] at h'
            obtain ⟨rfl, rfl⟩ := h'
            exact Or.inl ⟨rfl, rfl⟩
          · simp only [ha, ite_false] at h'
            exact Or.inr (Or.inr ⟨r', v', d', rfl, h'⟩)
        · rw [Function.update_of_ne hr] at h'
          exact Or.inr (Or.inr ⟨r', v', d', rfl, h'⟩)
    · rintro (⟨rfl, rfl⟩ | h' | ⟨r', v', d', rfl, h'⟩)
      · exact Or.inr ⟨r, v, d, rfl, by simp [hn]⟩
      · exact Or.inl h'
      · refine Or.inr ⟨r', v', d', rfl, ?_⟩
        by_cases hr : r' = r
        · subst hr
          rw [Function.update_self, hn]
          by_cases ha : a = p
          · subst ha; rw [hp] at h'; exact absurd h' (by simp)
          · simp [ha, h']
        · rwa [Function.update_of_ne hr]
  · ext ⟨a, b, m'⟩
    simp only [asm, Set.mem_ofPred_eq]
    by_cases h : rnd m' = r
    · rw [h]; simp [hc]
    · simp [Function.update_of_ne h]

/-- **Simulation.** An enabled local event of round `r` acts on the assembled global state as
predicted by the one-round machine (with the coin of round `r`). -/
theorem apply_embed (coin : ℕ → Bool) (L : ℕ → LS) (r : ℕ) (hF : Frame L r) (e : LE)
    (hg : guard (L r) e) :
    apply coin (embedEv r e) (asm L {3}) = asm (Function.update L r (step (coin r) (L r) e)) {3} := by
  cases e with
  | dlv q s m =>
    have h : (s, emb r m) ∈ (asm L {3}).sent := Or.inl (by simpa using hg.2)
    simp only [embedEv, apply, h, ite_true]
    exact (asm_update_rcv L {3} r (step (coin r) (L r) (.dlv q s m)) rfl rfl q s m
      fun _ _ _ => rfl).symm
  | inj q m =>
    have h : (3 : Pr) ∈ (asm L {3}).bad := rfl
    simp only [embedEv, apply, h, ite_true]
    exact (asm_update_rcv L {3} r (step (coin r) (L r) (.inj q m)) rfl rfl q 3 m
      fun _ _ _ => rfl).symm
  | echo p v =>
    obtain ⟨hp, hc, hs⟩ := hg
    have h : p ∉ (asm L {3}).bad ∧ (mmr 1 coin).send p (x0 p) ((asm L {3}).inbox p)
        ((asm L {3}).out p) (.bval r v none) := by
      refine ⟨hp, ?_, fun d hd => ?_⟩
      · show 1 + 1 ≤ bvCnt _ r v
        rw [bvCnt_asm]; exact hc
      · rcases hd with hd | ⟨r', v', d', he, hn⟩
        · simp only [rnd, loc] at hd
          rw [hs d] at hd; exact absurd hd (by simp)
        · simp only [Msg.bval.injEq] at he
          obtain ⟨hr, hv, hd⟩ := he
          have hr' : r - 1 = r' := by omega
          have := hF.cons p v' d' (by rw [hr']; simpa using hn)
          have h2 := hs d
          rw [hv, hd, this] at h2
          exact absurd h2 (by simp)
    simp only [embedEv, apply]
    rw [ite_eq_left h]
    exact (asm_update_sent L {3} r (step (coin r) (L r) (.echo p v)) rfl rfl p (.bval v none)
      fun _ _ => rfl).symm
  | aux p w =>
    obtain ⟨hp, ⟨v, d, hv⟩, hb, hs⟩ := hg
    have h : p ∉ (asm L {3}).bad ∧ (mmr 1 coin).send p (x0 p) ((asm L {3}).inbox p)
        ((asm L {3}).out p) (.aux r w) := by
      refine ⟨hp, ⟨v, d, Or.inl (by simp only [rnd, loc]; exact hv)⟩,
        (binVal_asm L {3} p r w).2 hb, ?_⟩
      rintro m (hm | ⟨r', v', d', rfl, -⟩) ⟨w', hw'⟩
      · subst hw'
        simp only [rnd, loc] at hm; rw [hs] at hm; exact absurd hm (by simp)
      · cases hw'
    simp only [embedEv, apply]
    rw [ite_eq_left h]
    exact (asm_update_sent L {3} r (step (coin r) (L r) (.aux p w)) rfl rfl p (.aux w)
      fun _ _ => rfl).symm
  | est p V =>
    obtain ⟨hp, ⟨w, hw⟩, hn, hq⟩ := hg
    obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by have := hF.pos; omega⟩
    have h : p ∉ (asm L {3}).bad ∧ (mmr 1 coin).send p (x0 p) ((asm L {3}).inbox p)
        ((asm L {3}).out p) (estMsg coin (r' + 1) V) := by
      refine ⟨hp, ⟨w, Or.inl (by simp only [rnd, loc]; exact hw)⟩, ?_, V,
        (auxQuorum_asm L {3} p _ V).2 hq, rfl⟩
      rintro m (hm | ⟨r'', v', d', rfl, hn'⟩) ⟨v, d, hvd⟩
      · subst hvd
        have := hF.next p (loc (.bval (r' + 1 + 1) v (some d)))
        simp only [rnd] at hm
        rw [this] at hm; exact absurd hm (by simp)
      · simp only [Msg.bval.injEq] at hvd
        obtain ⟨hr, -, -⟩ := hvd
        have : r'' = r' + 1 := by omega
        subst this
        rw [hn] at hn'; exact absurd hn' (by simp)
    simp only [embedEv, apply]
    rw [ite_eq_left h]
    refine (asm_update_nxt L {3} (r' + 1) (step (coin (r' + 1)) (L (r' + 1)) (.est p V)) rfl rfl p
      (nextEst V (coin (r' + 1))).1 (nextEst V (coin (r' + 1))).2 hn ?_).symm
    funext a
    simp [step]
  | skip =>
    simp [embedEv, apply, step]

end Podc.SignatureFreeBA.Attack
