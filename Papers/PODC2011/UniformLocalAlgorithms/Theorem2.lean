import Papers.PODC2011.UniformLocalAlgorithms.Theorem1

/-!
# Theorem 2: the randomized transformer (Section 4.4)

Given a non-uniform *weak Monte-Carlo* algorithm `A_Γ` with guarantee `ρ > 0`, whose running time
with good guesses is bounded by `f` (with a sequence-number function `s_f`), and a `Γ`-monotone
pruning algorithm `P`, the algorithm `τ` of Algorithm 2 (Iteration `i` runs Iterations `1, …, i`
of `π`, every sub-iteration with fresh random bits) is a uniform Las Vegas algorithm with expected
running time `O(f* · s_f(f*))`.

## Model of randomness

* A randomized algorithm with tapes in `W` is an `Alg V (α × W) β` run on `tag x ω`: every node
  `v` of the instance holds its input `x v` and its tape `ω v` (locality covers the tapes).
* The tapes of `A_Γ` are i.i.d. with law `ν` on `R` (joint law `Measure.infinitePi`); `τ` has tapes
  in `ℕ → R`, i.i.d. with law `ν` in every coordinate. Sub-iteration `(i, j, g)` of `τ` uses
  coordinate `code (i, j, g)` (an injective numbering), i.e. fresh random variables.
* `WeakMonteCarlo ν Pb F Γ A f ρ`: on every finite instance of `F`, with good guesses `g` and
  `T ≥ f g`, `A g` solves the instance within `T` rounds with probability `≥ ρ`.
* `OutputsMeasurable A`: the outputs of `A g` are measurable functions of the tapes (finite
  instances). Inputs and outputs range over countable types.
* `Alg.runTime U G x ω ∈ ℝ≥0∞`: first round at which all nodes have terminated (`∞` if never).

## Proof structure

* `measure_stageRun_mem_le` (abstract stage processes, CSLib candidate): stages with independent
  random variables, each good stage fails with probability `≤ q` from every reachable state ⇒ all
  good stages fail with probability `≤ q ^ #good` (decomposition over countably many states, no
  conditional probabilities).
* `measure_active_le`: applied to the run of `τ` (the current instances are countably many since
  they are sub-instances of the finite instance `x` with labels in a countable type).
* `le_countP_preT`: the first `s + i` iterations of `τ` contain `≥ i(i+1)/2` good sub-iterations.
* `lintegral_le_of_phases` + `max_dur_le` + `summable_pow_mul_pow_tri`: the expectation bound.
  The paper's step `α_{i+1} ≤ K · α_i` is replaced by the upper bound
  `α_{s+i} ≤ C · s_f(2^s) 2^s · (2a)^i` (see `max_dur_le`).
* `theorem_2`: Theorem 2. `weakMonteCarlo_ignoreTape`: the hypotheses are satisfiable.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace Podc.UniformLocalAlgorithms

section StageProcess

variable {Ω E S σ : Type*}

/-- Run the stages of `L` from `s₀`; stage `b` uses the random variable `Y (idx b)`. -/
def stageRun (Y : ℕ → Ω → E) (idx : σ → ℕ) (app : σ → S → E → S) (L : List σ) (s₀ : S)
    (ω : Ω) : S :=
  L.foldl (fun z b => app b z (Y (idx b) ω)) s₀

variable {Y : ℕ → Ω → E} {idx : σ → ℕ} {app : σ → S → E → S}

@[simp] lemma stageRun_nil (s₀ : S) (ω : Ω) : stageRun Y idx app [] s₀ ω = s₀ := rfl

@[simp] lemma stageRun_cons (b : σ) (L : List σ) (s₀ : S) (ω : Ω) :
    stageRun Y idx app (b :: L) s₀ ω = stageRun Y idx app L (app b s₀ (Y (idx b) ω)) ω := rfl

lemma stageRun_append_singleton (L : List σ) (b : σ) (s₀ : S) (ω : Ω) :
    stageRun Y idx app (L ++ [b]) s₀ ω = app b (stageRun Y idx app L s₀ ω) (Y (idx b) ω) := by
  simp [stageRun, List.foldl_append]

lemma stageRun_mem_of_forall {I : Set S} {L : List σ} {s₀ : S} (hs₀ : s₀ ∈ I)
    (hI : ∀ b ∈ L, ∀ z ∈ I, ∀ e, app b z e ∈ I) (ω : Ω) : stageRun Y idx app L s₀ ω ∈ I := by
  induction L generalizing s₀ with
  | nil => exact hs₀
  | cons b L ih =>
    exact ih (hI b (by simp) _ hs₀ _) (fun b' hb' => hI b' (by simp [hb']))

variable [mΩ : MeasurableSpace Ω] [mE : MeasurableSpace E]

/-- The σ-algebra generated by the random variables used by the stages of `L`. -/
@[instance_reducible] def stageSigma (Y : ℕ → Ω → E) (idx : σ → ℕ) (L : List σ) :
    MeasurableSpace Ω :=
  ⨆ c ∈ {c | c ∈ L.map idx}, mE.comap (Y c)

lemma stageSigma_le (hY : ∀ c, Measurable (Y c)) (L : List σ) : stageSigma Y idx L ≤ mΩ :=
  iSup₂_le fun c _ => (hY c).comap_le

omit mΩ in
/-- The fibres of the state after `L` are measurable with respect to the σ-algebra of the random
variables used by `L`. -/
lemma measurableSet_stageRun_eq {I : Set S} (hIc : I.Countable) {L : List σ} {s₀ : S}
    (hs₀ : s₀ ∈ I) (hI : ∀ b ∈ L, ∀ z ∈ I, ∀ e, app b z e ∈ I)
    (hmeas : ∀ b ∈ L, ∀ z ∈ I, ∀ z', MeasurableSet {e | app b z e = z'}) (z : S) :
    MeasurableSet[stageSigma Y idx L] {ω | stageRun Y idx app L s₀ ω = z} := by
  induction L using List.reverseRecOn generalizing z with
  | nil =>
    by_cases h : s₀ = z
    · simp [h]
    · simp [h]
  | append_singleton L b ih =>
    have hI' : ∀ b' ∈ L, ∀ z ∈ I, ∀ e, app b' z e ∈ I := fun b' hb' => hI b' (by simp [hb'])
    have hmeas' : ∀ b' ∈ L, ∀ z ∈ I, ∀ z', MeasurableSet {e | app b' z e = z'} :=
      fun b' hb' => hmeas b' (by simp [hb'])
    have hset : {ω | stageRun Y idx app (L ++ [b]) s₀ ω = z} =
        ⋃ z₁ ∈ I, {ω | stageRun Y idx app L s₀ ω = z₁} ∩ (Y (idx b)) ⁻¹' {e | app b z₁ e = z} := by
      ext ω
      simp only [stageRun_append_singleton, Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff,
        Set.mem_preimage, exists_prop]
      constructor
      · intro h
        exact ⟨_, stageRun_mem_of_forall hs₀ hI' ω, rfl, h⟩
      · rintro ⟨z₁, -, rfl, h⟩; exact h
    rw [hset]
    refine MeasurableSet.biUnion hIc fun z₁ hz₁ => MeasurableSet.inter ?_ ?_
    · have hle : stageSigma Y idx L ≤ stageSigma Y idx (L ++ [b]) := by
        refine iSup₂_le fun c hc => le_iSup₂_of_le
          (f := fun c (_ : c ∈ {c | c ∈ (L ++ [b]).map idx}) => mE.comap (Y c)) c
          (by simp only [Set.mem_ofPred_eq] at hc ⊢; simp [hc]) le_rfl
      exact hle _ (ih hI' hmeas' z₁)
    · have hle : mE.comap (Y (idx b)) ≤ stageSigma Y idx (L ++ [b]) :=
        le_iSup₂_of_le (f := fun c (_ : c ∈ {c | c ∈ (L ++ [b]).map idx}) => mE.comap (Y c))
          (idx b) (by simp) le_rfl
      exact hle _ ⟨_, hmeas b (by simp) z₁ hz₁ z, rfl⟩

lemma measurableSet_stageRun_mem (hY : ∀ c, Measurable (Y c)) {I : Set S} (hIc : I.Countable)
    {L : List σ} {s₀ : S} (hs₀ : s₀ ∈ I) (hI : ∀ b ∈ L, ∀ z ∈ I, ∀ e, app b z e ∈ I)
    (hmeas : ∀ b ∈ L, ∀ z ∈ I, ∀ z', MeasurableSet {e | app b z e = z'}) (A : Set S) :
    MeasurableSet {ω | stageRun Y idx app L s₀ ω ∈ A} := by
  have hset : {ω | stageRun Y idx app L s₀ ω ∈ A} =
      ⋃ z ∈ I ∩ A, {ω | stageRun Y idx app L s₀ ω = z} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
    exact ⟨fun h => ⟨_, ⟨stageRun_mem_of_forall hs₀ hI ω, h⟩, rfl⟩,
      by rintro ⟨z, ⟨-, hz⟩, rfl⟩; exact hz⟩
  rw [hset]
  exact MeasurableSet.biUnion (hIc.mono Set.inter_subset_left) fun z _ =>
    stageSigma_le hY L _ (measurableSet_stageRun_eq hIc hs₀ hI hmeas z)

-- CSLib candidate
/-- **The stage-process lemma.** Stages use independent random variables `Y (idx b)` with pairwise
distinct indices. The reachable states lie in a countable set `I`, the set `A` ("still active") is
absorbing backwards (a stage cannot enter `A` from outside), and every good stage stays in `A`
with probability at most `q` from every reachable state of `A`. Then the state is in `A` after
`L` with probability at most `q ^ (number of good stages of L)`. -/
theorem measure_stageRun_mem_le {μ : Measure Ω} [IsProbabilityMeasure μ]
    (hY : ∀ c, Measurable (Y c)) (hind : iIndepFun Y μ) {I : Set S} (hIc : I.Countable)
    {A : Set S} (good : σ → Bool) {q : ℝ≥0∞} (L : List σ) (hnd : (L.map idx).Nodup) {s₀ : S}
    (hs₀ : s₀ ∈ I) (hI : ∀ b ∈ L, ∀ z ∈ I, ∀ e, app b z e ∈ I)
    (hmeas : ∀ b ∈ L, ∀ z ∈ I, ∀ z', MeasurableSet {e | app b z e = z'})
    (hA : ∀ b ∈ L, ∀ z ∈ I, ∀ e, app b z e ∈ A → z ∈ A)
    (hq : ∀ b ∈ L, good b → ∀ z ∈ I, z ∈ A → μ ((Y (idx b)) ⁻¹' {e | app b z e ∈ A}) ≤ q) :
    μ {ω | stageRun Y idx app L s₀ ω ∈ A} ≤ q ^ L.countP good := by
  induction L using List.reverseRecOn with
  | nil =>
    simp only [List.countP_nil, pow_zero]
    exact prob_le_one
  | append_singleton L b ih =>
    have hI' : ∀ b' ∈ L, ∀ z ∈ I, ∀ e, app b' z e ∈ I := fun b' hb' => hI b' (by simp [hb'])
    have hmeas' : ∀ b' ∈ L, ∀ z ∈ I, ∀ z', MeasurableSet {e | app b' z e = z'} :=
      fun b' hb' => hmeas b' (by simp [hb'])
    have hnd' : (L.map idx).Nodup := by
      rw [List.map_append] at hnd; exact hnd.sublist (List.sublist_append_left _ _)
    have hnotin : idx b ∉ L.map idx := by
      rw [List.map_append, List.map_singleton, List.nodup_append] at hnd
      exact fun h => hnd.2.2 _ h _ (List.mem_singleton_self _) rfl
    have ih' := ih hnd' hI' hmeas' (fun b' hb' => hA b' (by simp [hb']))
      (fun b' hb' => hq b' (by simp [hb']))
    have hmemI := stageRun_mem_of_forall (Y := Y) (idx := idx) hs₀ hI'
    have hAb := hA b (by simp)
    by_cases hg : good b = true
    · rw [List.countP_append, pow_add]
      simp only [List.countP_singleton, hg, ite_true, pow_one]
      -- independence of the past and of the random variable of `b`
      have hindep : Indep (stageSigma Y idx L) (mE.comap (Y (idx b))) μ := by
        have h := indep_iSup_of_disjoint (m := fun c => mE.comap (Y c)) (μ := μ)
          (fun c => (hY c).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 hind)
          (S := {c | c ∈ L.map idx}) (T := {idx b})
          (Set.disjoint_singleton_right.2 hnotin)
        simpa [stageSigma] using h
      have hB : ∀ z ∈ I, MeasurableSet {e | app b z e ∈ A} := by
        intro z hz
        have : {e | app b z e ∈ A} = ⋃ z' ∈ I ∩ A, {e | app b z e = z'} := by
          ext e
          simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
          exact ⟨fun h => ⟨_, ⟨hI b (by simp) z hz e, h⟩, rfl⟩,
            by rintro ⟨z', ⟨-, hz'⟩, rfl⟩; exact hz'⟩
        rw [this]
        exact MeasurableSet.biUnion (hIc.mono Set.inter_subset_left) fun z' _ =>
          hmeas b (by simp) z hz z'
      have hsub : {ω | stageRun Y idx app (L ++ [b]) s₀ ω ∈ A} ⊆
          ⋃ z ∈ I ∩ A, {ω | stageRun Y idx app L s₀ ω = z} ∩
            (Y (idx b)) ⁻¹' {e | app b z e ∈ A} := by
        intro ω hω
        simp only [Set.mem_ofPred_eq, stageRun_append_singleton] at hω
        simp only [Set.mem_iUnion, Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_preimage,
          exists_prop]
        exact ⟨_, ⟨hmemI ω, hAb _ (hmemI ω) _ hω⟩, rfl, hω⟩
      calc μ {ω | stageRun Y idx app (L ++ [b]) s₀ ω ∈ A}
          ≤ μ (⋃ z ∈ I ∩ A, {ω | stageRun Y idx app L s₀ ω = z} ∩
            (Y (idx b)) ⁻¹' {e | app b z e ∈ A}) := measure_mono hsub
        _ ≤ ∑' z : ↥(I ∩ A), μ ({ω | stageRun Y idx app L s₀ ω = z} ∩
            (Y (idx b)) ⁻¹' {e | app b z e ∈ A}) :=
          measure_biUnion_le _ (hIc.mono Set.inter_subset_left) _
        _ ≤ ∑' z : ↥(I ∩ A), μ ((fun ω => stageRun Y idx app L s₀ ω) ⁻¹' {(z : S)}) * q := by
          refine ENNReal.tsum_le_tsum fun z => ?_
          rw [(Indep_iff _ _ _).1 hindep _ _
            (measurableSet_stageRun_eq hIc hs₀ hI' hmeas' z) ⟨_, hB z z.2.1, rfl⟩]
          exact mul_le_mul_right (hq b (by simp) hg z z.2.1 z.2.2) _
        _ = μ ((fun ω => stageRun Y idx app L s₀ ω) ⁻¹' (I ∩ A)) * q := by
          rw [ENNReal.tsum_mul_right, tsum_measure_preimage_singleton
            (hIc.mono Set.inter_subset_left)
            (fun z _ => stageSigma_le hY L _ (measurableSet_stageRun_eq hIc hs₀ hI' hmeas' z))]
        _ ≤ μ {ω | stageRun Y idx app L s₀ ω ∈ A} * q := by
          gcongr
          intro ω hω; exact hω.2
        _ ≤ q ^ L.countP good * q := by gcongr
    · rw [List.countP_append]
      simp only [List.countP_singleton, hg, Bool.false_eq_true, ite_false, add_zero]
      refine le_trans (measure_mono fun ω hω => ?_) ih'
      simp only [Set.mem_ofPred_eq, stageRun_append_singleton] at hω ⊢
      exact hAb _ (hmemI ω) _ hω

end StageProcess

/-! ## Random tapes -/

section Tapes

variable {V R : Type*}

/-- The `c`-th random variable of every node: `tapeAt c ω v = ω v c`. -/
def tapeAt (c : ℕ) (ω : V → ℕ → R) : V → R := fun v => ω v c

variable [MeasurableSpace R]

lemma measurable_tapeAt (c : ℕ) : Measurable (tapeAt (V := V) (R := R) c) := by
  unfold tapeAt; fun_prop

variable (ν : Measure R) [IsProbabilityMeasure ν]

/-- Under i.i.d. tapes, the `c`-th random variables of all nodes are i.i.d. with law `ν`. -/
lemma map_tapeAt (c : ℕ) :
    (Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν).map (tapeAt c) =
      Measure.infinitePi fun _ : V => ν := by
  have : tapeAt (V := V) (R := R) c = fun ω v => (fun w : ℕ → R => w c) (ω v) := rfl
  rw [this, Measure.infinitePi_map_pi _ (fun _ => measurable_pi_apply c)]
  congr 1; funext v
  exact Measure.infinitePi_map_eval _ c

lemma measure_tapeAt_preimage (c : ℕ) {B : Set (V → R)} (hB : MeasurableSet B) :
    (Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν) (tapeAt c ⁻¹' B) =
      (Measure.infinitePi fun _ : V => ν) B := by
  rw [← Measure.map_apply (measurable_tapeAt c) hB, map_tapeAt]

-- CSLib candidate
/-- Swapping the two indices of i.i.d. tapes preserves the law. -/
lemma map_swap_tapes :
    (Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν).map
        (fun ω (c : ℕ) (v : V) => ω v c) =
      Measure.infinitePi fun _ : ℕ => Measure.infinitePi fun _ : V => ν := by
  have h1 := Measure.infinitePi_map_curry (ι := V) (κ := ℕ) (fun _ _ => ν)
  have h2 := Measure.infinitePi_map_curry (ι := ℕ) (κ := V) (fun _ _ => ν)
  have h3 := Measure.infinitePi_map_piCongrLeft (X := fun _ : ℕ × V => R)
    (fun _ : ℕ × V => ν) (Equiv.prodComm V ℕ)
  rw [← h1, ← h2, ← h3, Measure.map_map (by fun_prop) (by fun_prop),
    Measure.map_map (by fun_prop) (by fun_prop)]
  congr 1

/-- The `c`-th random variables `tapeAt c` (`c ∈ ℕ`) are independent. -/
lemma iIndepFun_tapeAt :
    iIndepFun (fun c => tapeAt (V := V) (R := R) c)
      (Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν) := by
  rw [iIndepFun_iff_map_fun_eq_infinitePi_map measurable_tapeAt]
  simp only [map_tapeAt]
  exact map_swap_tapes ν

end Tapes

/-! ## Randomized algorithms -/

section Randomized

open SimpleGraph Cslib.Local

variable {V α β γ W R : Type*} {ℓ : ℕ}

/-- The instance `x` in which every node `v` of the instance also holds its random tape `ω v`. -/
def tag (x : V → Option α) (ω : V → W) : V → Option (α × W) :=
  fun v => (x v).map fun a => (a, ω v)

/-- The input part of a labelling with tapes. -/
def untag (x : V → Option (α × W)) : V → Option α := fun v => (x v).map Prod.fst

@[simp] lemma isSome_tag {x : V → Option α} {ω : V → W} {v : V} :
    (tag x ω v).isSome = (x v).isSome := by simp [tag]

@[simp] lemma untag_tag (x : V → Option α) (ω : V → W) : untag (tag x ω) = x := by
  funext v; simp [untag, tag, Option.map_map, Function.comp_def]

@[simp] lemma isSome_untag {x : V → Option (α × W)} {v : V} :
    (untag x v).isSome = (x v).isSome := by simp [untag]

lemma res_tag (G : SimpleGraph V) (x : V → Option α) (ω : V → W) : res G (tag x ω) = res G x :=
  res_congr fun v => by simp

lemma res_untag (G : SimpleGraph V) (x : V → Option (α × W)) : res G (untag x) = res G x :=
  res_congr fun v => by simp

/-- A randomized algorithm with tapes in `W` is an algorithm `U : Alg V (α × W) β`, run on the
instance `tag x ω` (every node knows its own tape, so the locality of `U` covers the tapes).
`U.RSolvesWithin Pb G x ω T`: with the tapes `ω`, after `T` rounds all nodes of the instance have
terminated and their outputs form a solution of `(G, x)`. -/
def Alg.RSolvesWithin (U : Alg V (α × W) β) (Pb : Problem V α β) (G : SimpleGraph V)
    (x : V → Option α) (ω : V → W) (T : ℕ) : Prop :=
  ∃ y, Pb.sol G x y ∧ ∀ v, (x v).isSome → U.out T G (tag x ω) v = some (y v)

/-- The running time of a randomized algorithm on `(G, x)` with tapes `ω`: the first round at
which all nodes of the instance have terminated (`∞` if this never happens). -/
noncomputable def Alg.runTime (U : Alg V (α × W) β) (G : SimpleGraph V) (x : V → Option α)
    (ω : V → W) : ℝ≥0∞ :=
  ⨅ (T : ℕ) (_ : ∀ v, (x v).isSome → (U.out T G (tag x ω) v).isSome), (T : ℝ≥0∞)

lemma Alg.runTime_le {U : Alg V (α × W) β} {G : SimpleGraph V} {x : V → Option α} {ω : V → W}
    {T : ℕ} (h : ∀ v, (x v).isSome → (U.out T G (tag x ω) v).isSome) : U.runTime G x ω ≤ T :=
  iInf₂_le T h

/-- Run `A` on relabelled inputs. -/
def Alg.relabel (A : Alg V α β) (e : γ → α) : Alg V γ β where
  out t G x := A.out t G (fun v => (x v).map e)
  isLocal t := isLocal_comp_label (A.isLocal t) (Option.map e)
  stable h := A.stable h

/-! ### Lifting problems, families and pruning algorithms to labels with tapes -/

/-- `Pb` on instances with tapes (the tapes are ignored). -/
def Problem.lift (Pb : Problem V α β) (W : Type*) : Problem V (α × W) β where
  sol G x y := Pb.sol G (untag x) y
  congr h hs := Pb.congr (fun v hv => h v (by simpa using hv)) hs
  empty := Pb.empty

/-- `F` on instances with tapes (the tapes are ignored). -/
def Family.lift (F : Family V α) (W : Type*) : Family V (α × W) where
  mem G x := F.mem G (untag x)
  res_eq h := (res_untag _ _).symm.trans (F.res_eq h)

/-- Keep the tape of a node that is not pruned. -/
def retag (a : Option α) (o : Option (α × W)) : Option (α × W) :=
  a.bind fun a => o.map fun p => (a, p.2)

lemma map_fst_retag {a : Option α} {o : Option (α × W)} (h : a.isSome → o.isSome) :
    (retag a o).map Prod.fst = a := by
  cases a with
  | none => rfl
  | some a =>
    cases o with
    | none => simp at h
    | some p => rfl

/-- A pruning algorithm acting on instances with tapes: it ignores the tapes, and the nodes that
are not pruned keep their tapes. -/
def Pruning.lift {Pb : Problem V α β} {F : Family V α} (P : Pruning Pb F) (W : Type*) :
    Pruning (Pb.lift W) (F.lift W) where
  prune G x ŷ v := retag (P.prune G (untag x) ŷ v) (x v)
  rad := P.rad
  isLocal := by
    intro G z G' z' v h
    have h1 := P.isLocal G (fun u => (untag (fun u => (z u).1) u, (z u).2)) G'
      (fun u => (untag (fun u => (z' u).1) u, (z' u).2)) v
      ⟨h.1, fun u hu => by simp [untag, h.2 u hu]⟩
    have h2 : z v = z' v := h.2 v (by simp)
    simp only at h1 ⊢
    rw [h1, h2]
  sub G x ŷ v h := by
    simp only [retag] at h
    cases hP : P.prune G (untag x) ŷ v with
    | none => simp [hP] at h
    | some a => cases hx : x v with
      | none => simp [hP, hx] at h
      | some p => simp
  mem G x ŷ h := by
    have hu : untag (fun v => retag (P.prune G (untag x) ŷ v) (x v)) = P.prune G (untag x) ŷ := by
      funext v
      exact map_fst_retag fun hv => by simpa using P.sub G (untag x) ŷ v hv
    show F.mem _ (untag _)
    rw [hu, ← res_untag, hu]
    exact P.mem G (untag x) ŷ h
  detect G x ŷ h hs v := by
    show retag _ _ = none
    rw [P.detect G (untag x) ŷ h hs v]; rfl
  glue G x ŷ y' h hs := by
    have hu : untag (fun v => retag (P.prune G (untag x) ŷ v) (x v)) = P.prune G (untag x) ŷ := by
      funext v
      exact map_fst_retag fun hv => by simpa using P.sub G (untag x) ŷ v hv
    have hs' : Pb.sol (res G (P.prune G (untag x) ŷ)) (P.prune G (untag x) ŷ) y' := by
      have := hs
      simp only [Problem.lift] at this
      rwa [← res_untag, hu] at this
    have hiff : ∀ v, (retag (P.prune G (untag x) ŷ v) (x v)).isSome =
        (P.prune G (untag x) ŷ v).isSome := fun v => by
      have := congrArg Option.isSome (congrFun hu v)
      simpa [untag] using this
    show Pb.sol G (untag x) _
    simp only [hiff]
    exact P.glue G (untag x) ŷ y' h hs'

lemma Pruning.untag_lift_prune {Pb : Problem V α β} {F : Family V α} (P : Pruning Pb F)
    (G : SimpleGraph V) (x : V → Option (α × W)) (ŷ : V → β) :
    untag ((P.lift W).prune G x ŷ) = P.prune G (untag x) ŷ := by
  funext v
  exact map_fst_retag fun hv => by simpa using P.sub G (untag x) ŷ v hv

end Randomized

/-! ## The algorithm `τ` (Algorithm 2) -/

section Tau

open SimpleGraph Cslib.Local

variable {V α β R : Type*} {ℓ : ℕ} [MeasurableSpace R]

/-- `A` (a randomized algorithm `A g` with tapes in `R` for every vector `g` of guesses) is a
*weak Monte-Carlo algorithm with guarantee `ρ`* for `Pb` and `F`, depending on `Γ`, whose running
time is bounded by `f` (Section 2): on every (finite) instance of `F`, for every vector `g` of good
guesses and every `T ≥ f g`, with probability at least `ρ` (the tapes of the nodes being i.i.d.
with law `ν`) `A g` solves the instance within `T` rounds. Nothing is required otherwise (`A g`
may never terminate). -/
def WeakMonteCarlo (ν : Measure R) (Pb : Problem V α β) (F : Family V α) (Γ : Fin ℓ → Param V α)
    (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (f : (Fin ℓ → ℕ) → ℝ) (ρ : ℝ) : Prop :=
  ∀ G x, F.mem G x → (supp x).Finite → ∀ g : Fin ℓ → ℕ, (∀ k, Γ k G x ≤ g k) →
    ∀ T : ℕ, f g ≤ T →
      ENNReal.ofReal ρ ≤ (Measure.infinitePi fun _ : V => ν) {e | (A g).RSolvesWithin Pb G x e T}

/-- Measurability of the outputs of a randomized algorithm in the tapes (on finite instances).
This holds for any algorithm that reads finitely many random bits in a measurable way. -/
def OutputsMeasurable (A : (Fin ℓ → ℕ) → Alg V (α × R) β) : Prop :=
  ∀ g t (G : SimpleGraph V) (x : V → Option α), (supp x).Finite → ∀ v b,
    MeasurableSet {e : V → R | (A g).out t G (tag x e) v = some b}

/-- The stage "run `A g` restricted to `t` rounds, every node using the `c`-th random variable of
its tape". -/
def tauStage (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) (c : ℕ) (g : Fin ℓ → ℕ) (t : ℕ) :
    Stage V (α × (ℕ → R)) β :=
  ((A g).relabel (fun p : α × (ℕ → R) => (p.1, p.2 c))).restrict t b₀

/-- The sub-iterations of Iteration `i` of `τ`, as triples `(i, j, g)`: for `j = 1, …, i`, and
every `g ∈ S(2^j)`, run `A g` restricted to `c · 2^j` rounds. -/
noncomputable def tauTriples (S : ℕ → Finset (Fin ℓ → ℕ)) (i : ℕ) :
    List (ℕ × ℕ × (Fin ℓ → ℕ)) :=
  (List.range (i + 1)).flatMap fun j =>
    if j = 0 then [] else (S (2 ^ j)).toList.map fun g => (i, j, g)

/-- An injective numbering of the sub-iterations: the sub-iteration `(i, j, g)` uses the random
variable number `code (i, j, g)` of every tape (fresh random bits for every sub-iteration). -/
noncomputable def code : ℕ × ℕ × (Fin ℓ → ℕ) → ℕ :=
  Classical.choose (Countable.exists_injective_nat (ℕ × ℕ × (Fin ℓ → ℕ)))

lemma code_injective : Function.Injective (code (ℓ := ℓ)) :=
  Classical.choose_spec (Countable.exists_injective_nat (ℕ × ℕ × (Fin ℓ → ℕ)))

/-- The stage of the sub-iteration `tr = (i, j, g)`. -/
noncomputable def tauStageOf (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) (c : ℕ)
    (tr : ℕ × ℕ × (Fin ℓ → ℕ)) : Stage V (α × (ℕ → R)) β :=
  tauStage A b₀ (code tr) tr.2.2 (c * 2 ^ tr.2.1)

/-- The phases of `τ`: phase `i` ("Iteration `i`") consists of Iterations `1, …, i` of `π`. -/
noncomputable def tauPhases (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (S : ℕ → Finset (Fin ℓ → ℕ))
    (c : ℕ) (b₀ : β) (i : ℕ) : List (Stage V (α × (ℕ → R)) β) :=
  (tauTriples S i).map (tauStageOf A b₀ c)

/-- The uniform randomized algorithm `τ` of Algorithm 2 (tapes in `ℕ → R`). -/
noncomputable def algTau {Pb : Problem V α β} {F : Family V α} (P : Pruning Pb F)
    (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ) (b₀ : β) :
    Alg V (α × (ℕ → R)) β :=
  (P.lift (ℕ → R)).alg (tauPhases A S c b₀)

/-! ### The run of `τ` as a stage process -/

/-- The tentative output of `A g` restricted to `t` rounds on the current instance `z` with the
random variables `e`. -/
def stageOut (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) (G : SimpleGraph V) (g : Fin ℓ → ℕ)
    (t : ℕ) (z : V → Option α) (e : V → R) : V → β :=
  fun v => ((A g).out t (res G z) (tag z e) v).getD b₀

/-- The effect of the sub-iteration `tr` on the current instance `z`. -/
def tauStep {Pb : Problem V α β} {F : Family V α} (P : Pruning Pb F)
    (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) (G : SimpleGraph V) (c : ℕ)
    (tr : ℕ × ℕ × (Fin ℓ → ℕ)) (z : V → Option α) (e : V → R) : V → Option α :=
  P.prune (res G z) z (stageOut A b₀ G tr.2.2 (c * 2 ^ tr.2.1) z e)

variable {Pb : Problem V α β} {F : Family V α}

omit [MeasurableSpace R] in
lemma relabel_tag (x : V → Option α) (ω : V → ℕ → R) (c : ℕ) :
    (fun u => (tag x ω u).map (fun p : α × (ℕ → R) => (p.1, p.2 c))) = tag x (tapeAt c ω) := by
  funext u; simp [tag, tapeAt, Option.map_map, Function.comp_def]

omit [MeasurableSpace R] in
lemma retag_tag {a : Option α} {x : V → Option α} {ω : V → ℕ → R} {v : V}
    (h : a.isSome → (x v).isSome) : retag a (tag x ω v) = tag (fun _ => a) ω v := by
  cases a with
  | none => rfl
  | some a =>
    cases hx : x v with
    | none => simp [hx] at h
    | some b => simp [retag, tag, hx]

omit [MeasurableSpace R] in
lemma act_lift_step (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β)
    (G : SimpleGraph V) (c : ℕ) (tr : ℕ × ℕ × (Fin ℓ → ℕ))
    {z' : Pruning.State V (α × (ℕ → R)) β} {x₀ : V → Option α} {ω : V → ℕ → R}
    (h : Pruning.act z' = tag x₀ ω) :
    Pruning.act ((P.lift (ℕ → R)).step (tauStageOf A b₀ c tr) G z') =
      tag (tauStep P A b₀ G c tr x₀ (tapeAt (code tr) ω)) ω := by
  show (fun v => (P.lift (ℕ → R)).prune (res G (Pruning.act z')) (Pruning.act z')
    ((tauStageOf A b₀ c tr).run (res G (Pruning.act z')) (Pruning.act z')) v) = _
  rw [h, res_tag]
  funext v
  simp only [Pruning.lift, untag_tag, tauStageOf, tauStage, Alg.restrict, Alg.relabel,
    relabel_tag]
  exact retag_tag (P.sub _ _ _ v)

omit [MeasurableSpace R] in
lemma act_lift_runList (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β)
    (G : SimpleGraph V) (c : ℕ) (L : List (ℕ × ℕ × (Fin ℓ → ℕ)))
    {z' : Pruning.State V (α × (ℕ → R)) β} {x₀ : V → Option α} {ω : V → ℕ → R}
    (h : Pruning.act z' = tag x₀ ω) :
    Pruning.act ((P.lift (ℕ → R)).runList (L.map (tauStageOf A b₀ c)) G z') =
      tag (stageRun (fun k => tapeAt k) code (tauStep P A b₀ G c) L x₀ ω) ω := by
  induction L generalizing z' x₀ with
  | nil => simpa using h
  | cons tr L ih =>
    simp only [List.map_cons, Pruning.runList_cons, stageRun_cons]
    exact ih (act_lift_step P A b₀ G c tr h)

end Tau

/-! ## Combinatorics of `τ` -/

section TauLists

variable {ℓ : ℕ}

/-- The sub-iterations of the first `m` iterations of `τ`. -/
noncomputable def preT (S : ℕ → Finset (Fin ℓ → ℕ)) (m : ℕ) : List (ℕ × ℕ × (Fin ℓ → ℕ)) :=
  (List.range m).flatMap (tauTriples S)

lemma preT_succ (S : ℕ → Finset (Fin ℓ → ℕ)) (m : ℕ) :
    preT S (m + 1) = preT S m ++ tauTriples S m := by
  simp [preT, List.range_succ, List.flatMap_append]

lemma mem_tauTriples {S : ℕ → Finset (Fin ℓ → ℕ)} {i : ℕ} {tr : ℕ × ℕ × (Fin ℓ → ℕ)} :
    tr ∈ tauTriples S i ↔ tr.1 = i ∧ 1 ≤ tr.2.1 ∧ tr.2.1 ≤ i ∧ tr.2.2 ∈ S (2 ^ tr.2.1) := by
  obtain ⟨a, j, g⟩ := tr
  simp only [tauTriples, List.mem_flatMap, List.mem_range]
  constructor
  · rintro ⟨j', hj', hmem⟩
    split_ifs at hmem with h0
    · simp at hmem
    · simp only [List.mem_map, Finset.mem_toList, Prod.mk.injEq] at hmem
      obtain ⟨g', hg', rfl, rfl, rfl⟩ := hmem
      exact ⟨rfl, by omega, by omega, hg'⟩
  · rintro ⟨rfl, h1, h2, hg⟩
    refine ⟨j, by omega, ?_⟩
    rw [ite_eq_right (by omega)]
    exact List.mem_map.2 ⟨g, Finset.mem_toList.2 hg, rfl⟩

lemma nodup_tauTriples (S : ℕ → Finset (Fin ℓ → ℕ)) (i : ℕ) : (tauTriples S i).Nodup := by
  unfold tauTriples
  rw [List.nodup_flatMap]
  refine ⟨fun j _ => ?_, (List.nodup_range).imp fun {j j'} hjj' => ?_⟩
  · split_ifs
    · exact List.nodup_nil
    · exact (Finset.nodup_toList _).map fun g g' h => by simpa using h
  · intro tr h1 h2
    simp only at h1 h2
    split_ifs at h1 h2 <;> simp only [List.not_mem_nil, List.mem_map] at h1 h2
    obtain ⟨g, -, rfl⟩ := h1
    obtain ⟨g', -, h⟩ := h2
    simp only [Prod.mk.injEq] at h
    exact hjj' h.2.1.symm

lemma nodup_preT (S : ℕ → Finset (Fin ℓ → ℕ)) (m : ℕ) : (preT S m).Nodup := by
  unfold preT
  rw [List.nodup_flatMap]
  refine ⟨fun i _ => nodup_tauTriples S i, (List.nodup_range).imp fun {i i'} hii' => ?_⟩
  intro tr h1 h2
  exact hii' ((mem_tauTriples.1 h1).1.symm.trans (mem_tauTriples.1 h2).1)

lemma nodup_preT_code (S : ℕ → Finset (Fin ℓ → ℕ)) (m : ℕ) : ((preT S m).map code).Nodup :=
  (nodup_preT S m).map code_injective

/-- Iteration `r ≥ s - 1` of `τ` contains at least `r + 1 - s` good sub-iterations, if every
`S(2^j)` with `j ≥ s` contains a good guess vector. -/
lemma le_countP_tauTriples (S : ℕ → Finset (Fin ℓ → ℕ)) (gb : ℕ × ℕ × (Fin ℓ → ℕ) → Bool)
    {s : ℕ} (hs : 1 ≤ s) (r : ℕ) (h : ∀ j, s ≤ j → ∃ g ∈ S (2 ^ j), gb (r, j, g)) :
    r + 1 - s ≤ (tauTriples S r).countP gb := by
  suffices ∀ n, n - s ≤ ((List.range n).flatMap fun j =>
      if j = 0 then [] else (S (2 ^ j)).toList.map fun g => (r, j, g)).countP gb from this (r + 1)
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.flatMap_append, List.countP_append]
    by_cases hn : s ≤ n
    · obtain ⟨g, hg, hgb⟩ := h n hn
      have : 1 ≤ (if n = 0 then [] else (S (2 ^ n)).toList.map fun g => (r, n, g)).countP gb := by
        rw [ite_eq_right (by omega)]
        exact List.countP_pos_iff.2 ⟨_, List.mem_map.2 ⟨g, Finset.mem_toList.2 hg, rfl⟩, hgb⟩
      simp only [List.flatMap_singleton]
      omega
    · omega

lemma le_countP_preT (S : ℕ → Finset (Fin ℓ → ℕ)) (gb : ℕ × ℕ × (Fin ℓ → ℕ) → Bool)
    {s : ℕ} (hs : 1 ≤ s) (h : ∀ r j, s ≤ j → ∃ g ∈ S (2 ^ j), gb (r, j, g)) (i : ℕ) :
    i * (i + 1) / 2 ≤ (preT S (s + i)).countP gb := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [← Nat.add_assoc, preT_succ, List.countP_append]
    have h1 := le_countP_tauTriples S gb hs (s + i) (h (s + i))
    have h2 : (i + 1) * (i + 1 + 1) / 2 = i * (i + 1) / 2 + (i + 1) := by
      have : (i + 1) * (i + 1 + 1) = i * (i + 1) + 2 * (i + 1) := by ring
      rw [this, Nat.add_mul_div_left _ _ two_pos]
    omega

end TauLists

/-! ## Two analytic lemmas -/

section Series

open Filter Topology

lemma tri_succ (i : ℕ) : (i + 1) * (i + 1 + 1) / 2 = i * (i + 1) / 2 + (i + 1) := by
  have : (i + 1) * (i + 1 + 1) = i * (i + 1) + 2 * (i + 1) := by ring
  rw [this, Nat.add_mul_div_left _ _ two_pos]

/-- `∑ bⁱ r^{i(i+1)/2}` converges for `0 ≤ r < 1` (ratio test: the ratio is `b r^{i+1} → 0`). -/
lemma summable_pow_mul_pow_tri {b r : ℝ} (hb : 0 ≤ b) (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Summable fun i : ℕ => b ^ i * r ^ (i * (i + 1) / 2) := by
  have hlim : Tendsto (fun i : ℕ => b * r ^ (i + 1)) atTop (𝓝 0) := by
    have := ((tendsto_pow_atTop_nhds_zero_of_lt_one hr0 hr1).comp
      (tendsto_add_atTop_nat 1)).const_mul b
    simpa [Function.comp_def] using this
  have hev : ∀ᶠ i in atTop, b * r ^ (i + 1) ≤ 1 / 2 :=
    hlim.eventually (Iic_mem_nhds (by norm_num))
  refine summable_of_ratio_norm_eventually_le (r := 1 / 2) (by norm_num) ?_
  filter_upwards [hev] with i hi
  rw [Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg (by positivity), tri_succ, pow_succ,
    pow_add]
  calc b ^ i * b * (r ^ (i * (i + 1) / 2) * r ^ (i + 1))
      = (b * r ^ (i + 1)) * (b ^ i * r ^ (i * (i + 1) / 2)) := by ring
    _ ≤ 1 / 2 * (b ^ i * r ^ (i * (i + 1) / 2)) :=
      mul_le_mul_of_nonneg_right hi (by positivity)

-- CSLib candidate
/-- Expectation of a running time by phases: if `T ≤ D m` outside the measurable event `Act m`
("still active after `m` phases") and `D m ≥ m`, then
`E[T] ≤ D s + ∑ᵢ D (s+i+1) · P(Act (s+i))`. -/
lemma lintegral_le_of_phases {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ] (T : Ω → ℝ≥0∞) (Act : ℕ → Set Ω) (hAct : ∀ m, MeasurableSet (Act m))
    (D : ℕ → ℕ) (hD : ∀ m, m ≤ D m) (hT : ∀ m ω, ω ∉ Act m → T ω ≤ D m) (s : ℕ) :
    ∫⁻ ω, T ω ∂μ ≤ D s + ∑' i, (D (s + i + 1) : ℝ≥0∞) * μ (Act (s + i)) := by
  have hpt : ∀ ω, T ω ≤
      D s + ∑' i, (Act (s + i)).indicator (fun _ => (D (s + i + 1) : ℝ≥0∞)) ω := by
    intro ω
    by_cases hall : ∀ i, ω ∈ Act (s + i)
    · have : ∑' i, (Act (s + i)).indicator (fun _ => (D (s + i + 1) : ℝ≥0∞)) ω = ⊤ := by
        refine top_le_iff.1 ?_
        calc (⊤ : ℝ≥0∞) = ∑' _ : ℕ, (1 : ℝ≥0∞) :=
              (ENNReal.tsum_const_eq_top_of_ne_zero one_ne_zero).symm
          _ ≤ _ := ENNReal.tsum_le_tsum fun i => by
              rw [Set.indicator_of_mem (hall i)]
              exact_mod_cast le_trans (by omega) (hD (s + i + 1))
      rw [this, add_top]; exact le_top
    · push Not at hall
      classical
      have hk : ω ∉ Act (s + Nat.find hall) := Nat.find_spec hall
      rcases hk0 : Nat.find hall with _ | k
      · rw [hk0] at hk
        exact (hT _ _ hk).trans (by simp)
      · rw [hk0] at hk
        have hmem : ω ∈ Act (s + k) :=
          not_not.1 (Nat.find_min hall (by omega : k < Nat.find hall))
        calc T ω ≤ D (s + k + 1) := hT _ _ (by simpa [Nat.add_assoc] using hk)
          _ = (Act (s + k)).indicator (fun _ => (D (s + k + 1) : ℝ≥0∞)) ω := by
              rw [Set.indicator_of_mem hmem]
          _ ≤ ∑' i, (Act (s + i)).indicator (fun _ => (D (s + i + 1) : ℝ≥0∞)) ω :=
              ENNReal.le_tsum (f := fun i =>
                (Act (s + i)).indicator (fun _ => (D (s + i + 1) : ℝ≥0∞)) ω) k
          _ ≤ _ := le_add_self
  calc ∫⁻ ω, T ω ∂μ
      ≤ ∫⁻ ω, ((D s : ℝ≥0∞) +
          ∑' i, (Act (s + i)).indicator (fun _ => (D (s + i + 1) : ℝ≥0∞)) ω) ∂μ :=
        lintegral_mono hpt
    _ = D s + ∑' i, (D (s + i + 1) : ℝ≥0∞) * μ (Act (s + i)) := by
        rw [lintegral_add_left measurable_const, lintegral_const, measure_univ, mul_one,
          lintegral_tsum fun i => (measurable_const.indicator (hAct _)).aemeasurable]
        simp_rw [lintegral_indicator_const (hAct _)]

end Series

/-! ## Analysis of `τ` on a fixed instance -/

section Analysis

open SimpleGraph Cslib.Local

variable {V α β R : Type*} {ℓ : ℕ}

/-- In the induced subgraph `res G z`, a node outside the instance is isolated. -/
lemma eq_of_res_edist_ne_top {G : SimpleGraph V} {z : V → Option α} {v u : V} (hv : z v = none)
    (h : (res G z).edist v u ≠ ⊤) : u = v := by
  obtain ⟨p⟩ := SimpleGraph.edist_ne_top_iff_reachable.1 h
  cases p with
  | nil => rfl
  | cons hadj _ => simp [hv] at hadj

/-- The output of a node outside the current instance does not depend on the tapes. -/
lemma stageOut_of_eq_none (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) (G : SimpleGraph V)
    (g : Fin ℓ → ℕ) (t : ℕ) {z : V → Option α} {v : V} (hv : z v = none) (e e' : V → R) :
    stageOut A b₀ G g t z e v = stageOut A b₀ G g t z e' v := by
  unfold stageOut
  congr 1
  refine (A g).isLocal t _ _ _ _ _ ⟨fun _ _ _ => Iff.rfl, fun u hu => ?_⟩
  obtain rfl := eq_of_res_edist_ne_top hv (ne_top_of_le_ne_top (by simp) hu)
  simp [tag, hv]

variable [MeasurableSpace R]

lemma measurableSet_stageOut [Countable β] {A : (Fin ℓ → ℕ) → Alg V (α × R) β}
    (hmeas : OutputsMeasurable A) (b₀ : β) (G : SimpleGraph V) (g : Fin ℓ → ℕ) (t : ℕ)
    {z : V → Option α} (hz : (supp z).Finite) (v : V) (b : β) :
    MeasurableSet {e | stageOut A b₀ G g t z e v = b} := by
  have h1 : ∀ b', MeasurableSet {e : V → R | (A g).out t (res G z) (tag z e) v = some b'} :=
    fun b' => hmeas g t (res G z) z hz v b'
  have h2 : {e : V → R | (A g).out t (res G z) (tag z e) v = none} =
      (⋃ b', {e : V → R | (A g).out t (res G z) (tag z e) v = some b'})ᶜ := by
    ext e
    simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    exact ⟨fun h b' h' => by simp [h] at h', fun h => Option.eq_none_iff_forall_ne_some.2 h⟩
  have h3 : {e | stageOut A b₀ G g t z e v = b} =
      {e : V → R | (A g).out t (res G z) (tag z e) v = some b} ∪
        ({e : V → R | (A g).out t (res G z) (tag z e) v = none} ∩ {_e | b₀ = b}) := by
    ext e
    simp only [stageOut, Set.mem_ofPred_eq, Set.mem_union, Set.mem_inter_iff]
    cases (A g).out t (res G z) (tag z e) v <;> simp
  rw [h3, h2]
  exact (h1 b).union ((MeasurableSet.iUnion h1).compl.inter (MeasurableSet.const _))

lemma measurableSet_tauStep_eq [Countable β] {Pb : Problem V α β} {F : Family V α}
    (P : Pruning Pb F) {A : (Fin ℓ → ℕ) → Alg V (α × R) β} (hmeas : OutputsMeasurable A)
    (b₀ : β) (G : SimpleGraph V) (c : ℕ) (tr : ℕ × ℕ × (Fin ℓ → ℕ)) {z : V → Option α}
    (hz : (supp z).Finite) (z' : V → Option α) :
    MeasurableSet {e | tauStep P A b₀ G c tr z e = z'} := by
  rcases isEmpty_or_nonempty (V → R) with hE | ⟨⟨e₀⟩⟩
  · rw [Set.eq_empty_of_isEmpty {e | tauStep P A b₀ G c tr z e = z'}]
    exact MeasurableSet.empty
  have : Finite (supp z) := hz.to_subtype
  set out := stageOut A b₀ G tr.2.2 (c * 2 ^ tr.2.1) z
  let glue : (supp z → β) → V → β := fun w v =>
    if h : (z v).isSome then w ⟨v, h⟩ else out e₀ v
  have hglue : ∀ e w, (∀ v : supp z, out e v = w v) → out e = glue w := by
    intro e w hw
    funext v
    by_cases h : (z v).isSome
    · simp only [glue, h, dite_true]; exact hw ⟨v, h⟩
    · simp only [glue, h]
      exact stageOut_of_eq_none A b₀ G _ _ (by simpa using h) e e₀
  have hset : {e | tauStep P A b₀ G c tr z e = z'} =
      ⋃ w : supp z → β, (⋂ v : supp z, {e | out e v = w v}) ∩
        {_e | P.prune (res G z) z (glue w) = z'} := by
    ext e
    simp only [tauStep, Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_iInter]
    constructor
    · intro h
      exact ⟨fun v => out e v, fun v => rfl, by rw [← hglue e _ fun v => rfl]; exact h⟩
    · rintro ⟨w, hw, h⟩
      have := hglue e w hw
      simp only [out] at this
      rw [this]; exact h
  rw [hset]
  exact MeasurableSet.iUnion fun w => (MeasurableSet.iInter fun v : supp z =>
    measurableSet_stageOut hmeas b₀ G _ _ hz (v : V) (w v)).inter (MeasurableSet.const _)

section Instance

variable {Pb : Problem V α β} {F : Family V α} {Γ : Fin ℓ → Param V α}

/-- The current instances that can occur during a run on `(G, x)`: sub-instances of `x` which
belong to `F` and whose parameters are at most `Γ*(G, x)`. -/
def Reach (F : Family V α) (Γ : Fin ℓ → Param V α) (G : SimpleGraph V) (x : V → Option α) :
    Set (V → Option α) :=
  {z | Pruning.RunInv F Γ G (correct Γ G x) z ∧ ∀ v, (z v).isSome → (x v).isSome}

/-- Some node is still active. -/
def Active : Set (V → Option α) := {z | ∃ v, (z v).isSome}

omit [MeasurableSpace R] in
lemma mem_reach_self {G : SimpleGraph V} {x : V → Option α} (hx : F.mem G x) :
    x ∈ Reach F Γ G x := by
  refine ⟨⟨?_, fun k => ?_⟩, fun v hv => hv⟩
  · rw [F.res_eq hx]; exact hx
  · show Γ k (res G x) x ≤ Γ k G x
    rw [F.res_eq hx]

omit [MeasurableSpace R] in
lemma reach_countable [Countable α] {G : SimpleGraph V} {x : V → Option α}
    (hx : (supp x).Finite) : (Reach F Γ G x).Countable := by
  have : Finite (supp x) := hx.to_subtype
  refine Set.MapsTo.countable_of_injOn (f := fun z (v : supp x) => z v) (t := Set.univ)
    (Set.mapsTo_univ _ _) ?_ Set.countable_univ
  intro z hz z' hz' h
  funext v
  by_cases hv : (x v).isSome
  · exact congrFun h ⟨v, hv⟩
  · have h1 : z v = none := Option.not_isSome_iff_eq_none.1 fun h' => hv (hz.2 v h')
    have h2 : z' v = none := Option.not_isSome_iff_eq_none.1 fun h' => hv (hz'.2 v h')
    rw [h1, h2]

omit [MeasurableSpace R] in
lemma supp_finite_of_mem_reach {G : SimpleGraph V} {x z : V → Option α} (hx : (supp x).Finite)
    (hz : z ∈ Reach F Γ G x) : (supp z).Finite :=
  hx.subset fun v hv => hz.2 v hv

omit [MeasurableSpace R] in
lemma tauStep_mem_reach (P : Pruning Pb F) (hP : ∀ k, P.Monotone (Γ k))
    (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β) {G : SimpleGraph V} {x : V → Option α} (c : ℕ)
    (tr : ℕ × ℕ × (Fin ℓ → ℕ)) {z : V → Option α} (hz : z ∈ Reach F Γ G x) (e : V → R) :
    tauStep P A b₀ G c tr z e ∈ Reach F Γ G x :=
  ⟨P.inv_prune hP _ hz.1, fun v hv => hz.2 v (P.sub _ _ _ v hv)⟩

omit [MeasurableSpace R] in
lemma active_of_tauStep (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (b₀ : β)
    (G : SimpleGraph V) (c : ℕ) (tr : ℕ × ℕ × (Fin ℓ → ℕ)) {z : V → Option α} {e : V → R}
    (h : tauStep P A b₀ G c tr z e ∈ Active) : z ∈ Active := by
  obtain ⟨v, hv⟩ := h
  exact ⟨v, P.sub _ _ _ v hv⟩

lemma measurableSet_tauStep_mem [Countable α] [Countable β] (P : Pruning Pb F)
    (hP : ∀ k, P.Monotone (Γ k)) {A : (Fin ℓ → ℕ) → Alg V (α × R) β} (hmeas : OutputsMeasurable A)
    (b₀ : β) {G : SimpleGraph V} {x : V → Option α} (hx : (supp x).Finite) (c : ℕ)
    (tr : ℕ × ℕ × (Fin ℓ → ℕ)) {z : V → Option α} (hz : z ∈ Reach F Γ G x)
    (B : Set (V → Option α)) : MeasurableSet {e | tauStep P A b₀ G c tr z e ∈ B} := by
  have : {e | tauStep P A b₀ G c tr z e ∈ B} =
      ⋃ z' ∈ Reach F Γ G x ∩ B, {e | tauStep P A b₀ G c tr z e = z'} := by
    ext e
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
    exact ⟨fun h => ⟨_, ⟨tauStep_mem_reach P hP A b₀ c tr hz e, h⟩, rfl⟩,
      by rintro ⟨z', ⟨-, hz'⟩, rfl⟩; exact hz'⟩
  rw [this]
  exact MeasurableSet.biUnion ((reach_countable hx).mono Set.inter_subset_left) fun z' _ =>
    measurableSet_tauStep_eq P hmeas b₀ G c tr (supp_finite_of_mem_reach hx hz) z'

/-- A sub-iteration `tr = (i, j, g)` is *good* for `(G, x)` if its guess vector is good and its
budget `c · 2^j` is at least `f g`. -/
def GoodSub (Γ : Fin ℓ → Param V α) (f : (Fin ℓ → ℕ) → ℝ) (c : ℕ) (G : SimpleGraph V)
    (x : V → Option α) (tr : ℕ × ℕ × (Fin ℓ → ℕ)) : Prop :=
  (∀ k, correct Γ G x k ≤ tr.2.2 k) ∧ f tr.2.2 ≤ ((c * 2 ^ tr.2.1 : ℕ) : ℝ)

/-- A good sub-iteration prunes all nodes with probability at least `ρ`, from every reachable
instance (this uses fresh random variables, whatever happened before). -/
lemma measure_tauStep_active_le [Countable α] [Countable β] (ν : Measure R)
    [IsProbabilityMeasure ν] {A : (Fin ℓ → ℕ) → Alg V (α × R) β} {f : (Fin ℓ → ℕ) → ℝ} {ρ : ℝ}
    (hMC : WeakMonteCarlo ν Pb F Γ A f ρ) (hmeas : OutputsMeasurable A) (P : Pruning Pb F)
    (hP : ∀ k, P.Monotone (Γ k)) (b₀ : β) {G : SimpleGraph V} {x : V → Option α}
    (hx : (supp x).Finite) (c : ℕ) {tr : ℕ × ℕ × (Fin ℓ → ℕ)} (hgood : GoodSub Γ f c G x tr)
    {z : V → Option α} (hz : z ∈ Reach F Γ G x) :
    (Measure.infinitePi fun _ : V => ν) {e | tauStep P A b₀ G c tr z e ∈ Active} ≤
      1 - ENNReal.ofReal ρ := by
  set μR := Measure.infinitePi fun _ : V => ν
  set S1 := {e | (A tr.2.2).RSolvesWithin Pb (res G z) z e (c * 2 ^ tr.2.1)}
  set S2 := {e | tauStep P A b₀ G c tr z e ∈ Active}
  have hS2 : MeasurableSet S2 := measurableSet_tauStep_mem P hP hmeas b₀ hx c tr hz Active
  have hdisj : Disjoint S1 S2 := by
    refine Set.disjoint_left.2 fun e he1 he2 => ?_
    obtain ⟨y, hy, hout⟩ := he1
    have hsol : Pb.sol (res G z) z (stageOut A b₀ G tr.2.2 (c * 2 ^ tr.2.1) z e) :=
      Pb.congr (fun v hv => by simp [stageOut, hout v hv]) hy
    obtain ⟨v, hv⟩ := he2
    simp [tauStep, P.detect _ _ _ hz.1.1 hsol v] at hv
  have hρ : ENNReal.ofReal ρ ≤ μR S1 := by
    have h := hMC (res G z) z hz.1.1 (supp_finite_of_mem_reach hx hz) tr.2.2
      (fun k => (hz.1.2 k).trans (hgood.1 k)) _ hgood.2
    exact h
  have hsum : μR S1 + μR S2 ≤ 1 := by
    rw [← measure_union hdisj hS2]; exact prob_le_one
  calc μR S2 ≤ 1 - μR S1 := ENNReal.le_sub_of_add_le_left (measure_ne_top _ _) hsum
    _ ≤ 1 - ENNReal.ofReal ρ := tsub_le_tsub_left hρ _

/-- **Probability core of Theorem 2.** For any list `L` of sub-iterations with pairwise distinct
random variables, the probability that some node is still active after running `L` is at most
`(1 - ρ) ^ (number of good sub-iterations of L)`. -/
theorem measure_active_le [Countable α] [Countable β] (ν : Measure R) [IsProbabilityMeasure ν]
    {A : (Fin ℓ → ℕ) → Alg V (α × R) β} {f : (Fin ℓ → ℕ) → ℝ} {ρ : ℝ}
    (hMC : WeakMonteCarlo ν Pb F Γ A f ρ) (hmeas : OutputsMeasurable A) (P : Pruning Pb F)
    (hP : ∀ k, P.Monotone (Γ k)) (b₀ : β) {G : SimpleGraph V} {x : V → Option α}
    (hxF : F.mem G x) (hx : (supp x).Finite) (c : ℕ) (L : List (ℕ × ℕ × (Fin ℓ → ℕ)))
    (hnd : (L.map code).Nodup) [DecidablePred (GoodSub Γ f c G x)] :
    (Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν)
        {ω | stageRun (fun k => tapeAt k) code (tauStep P A b₀ G c) L x ω ∈ Active} ≤
      (1 - ENNReal.ofReal ρ) ^ L.countP (fun tr => decide (GoodSub Γ f c G x tr)) := by
  refine measure_stageRun_mem_le measurable_tapeAt (iIndepFun_tapeAt ν) (reach_countable hx)
    _ L hnd (mem_reach_self hxF) (fun tr _ z hz e => tauStep_mem_reach P hP A b₀ c tr hz e)
    (fun tr _ z hz z' => measurableSet_tauStep_eq P hmeas b₀ G c tr
      (supp_finite_of_mem_reach hx hz) z')
    (fun tr _ z _ e h => active_of_tauStep P A b₀ G c tr h) ?_
  intro tr _ hg z hz _
  rw [measure_tapeAt_preimage ν _ (measurableSet_tauStep_mem P hP hmeas b₀ hx c tr hz Active)]
  exact measure_tauStep_active_le ν hMC hmeas P hP b₀ hx c (by simpa using hg) hz

end Instance

section TauRun

variable {Pb : Problem V α β} {F : Family V α}

omit [MeasurableSpace R] in
lemma pre_tauPhases (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ)
    (b₀ : β) (m : ℕ) :
    Pruning.pre (tauPhases A S c b₀) m = (preT S m).map (tauStageOf A b₀ c) := by
  simp only [Pruning.pre, preT, List.map_flatMap]; rfl

omit [MeasurableSpace R] in
/-- `τ` is Las Vegas: whatever the tapes, if all nodes have terminated after `T` rounds, their
outputs form a solution (Observation 3.4). -/
theorem algTau_correct (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β)
    (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ) (b₀ : β) {G : SimpleGraph V} {x : V → Option α}
    (hx : F.mem G x) (ω : V → ℕ → R) (T : ℕ)
    (h : ∀ v, (x v).isSome → ((algTau P A S c b₀).out T G (tag x ω) v).isSome) :
    (algTau P A S c b₀).RSolvesWithin Pb G x ω T := by
  set P' := P.lift (ℕ → R)
  set L := Pruning.pre (tauPhases A S c b₀) (P'.numPhases (tauPhases A S c b₀) T)
  have hval := P'.valid_runList (L := L) (G := G) (Pruning.valid_init (β := β) (tag x ω))
  have hend : ∀ v, Pruning.act (P'.runList L G (Pruning.init (tag x ω))) v = none := by
    intro v
    by_cases hv : (x v).isSome
    · exact hval v (h v hv)
    · by_contra hc
      have := P'.act_runList_isSome (Option.isSome_iff_ne_none.2 hc)
      simp only [Pruning.act, Pruning.init, isSome_tag] at this
      exact hv this
  have hmem : (F.lift (ℕ → R)).mem
      (res G (Pruning.act (Pruning.init (tag x ω) : Pruning.State V (α × (ℕ → R)) β)))
      (Pruning.act (Pruning.init (tag x ω) : Pruning.State V (α × (ℕ → R)) β)) := by
    show F.mem (res G (tag x ω)) (untag (tag x ω))
    rw [res_tag, untag_tag, F.res_eq hx]; exact hx
  obtain ⟨y, hy, hout⟩ := P'.runList_correct (L := L) (Pruning.valid_init _) hmem hend
  refine ⟨y, ?_, fun v hv => hout v (by simpa [Pruning.act, Pruning.init] using hv)⟩
  have : Pb.sol (res G (tag x ω)) (untag (tag x ω)) y := hy
  rwa [res_tag, untag_tag, F.res_eq hx] at this

omit [MeasurableSpace R] in
/-- If all nodes are pruned after the first `m` iterations of `τ`, then `τ` terminates within the
duration of these iterations. -/
lemma runTime_algTau_le (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β)
    (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ) (b₀ : β) {G : SimpleGraph V} {x : V → Option α}
    (hx : F.mem G x) (ω : V → ℕ → R) (m : ℕ)
    (hm : stageRun (fun k => tapeAt k) code (tauStep P A b₀ G c) (preT S m) x ω ∉ Active) :
    (algTau P A S c b₀).runTime G x ω ≤
      (max m ((P.lift (ℕ → R)).dur (Pruning.pre (tauPhases A S c b₀) m)) : ℕ) := by
  have hact := act_lift_runList P A b₀ G c (preT S m)
    (z' := (Pruning.init (tag x ω) : Pruning.State V (α × (ℕ → R)) β)) (x₀ := x) (ω := ω) rfl
  rw [← pre_tauPhases] at hact
  have hs : ∀ v, Pruning.act ((P.lift (ℕ → R)).runList (Pruning.pre (tauPhases A S c b₀) m) G
      (Pruning.init (tag x ω))) v = none := by
    intro v
    rw [hact]
    have : stageRun (fun k => tapeAt k) code (tauStep P A b₀ G c) (preT S m) x ω v = none := by
      by_contra hc; exact hm ⟨v, Option.isSome_iff_ne_none.2 hc⟩
    simp [tag, this]
  have hmem : (F.lift (ℕ → R)).mem G (tag x ω) := by
    show F.mem G (untag (tag x ω)); rw [untag_tag]; exact hx
  obtain ⟨y, -, hout⟩ := (P.lift (ℕ → R)).solvesWithin_of_runList_empty hmem hs
  refine Alg.runTime_le fun v hv => ?_
  have := hout v (by simpa using hv)
  simp only [algTau] at this ⊢
  rw [this]; rfl

omit [MeasurableSpace R] in
lemma dur_tauPhases_le (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β)
    (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ) (b₀ : β) (sf : ℕ → ℕ) (hsf : Monotone sf)
    (hS : ∀ i, (S i).card ≤ sf i) (r : ℕ) :
    (P.lift (ℕ → R)).dur (tauPhases A S c b₀ r) ≤ sf (2 ^ r) * ((c + P.rad) * 2 ^ (r + 1)) := by
  set A' : (Fin ℓ → ℕ) → Alg V (α × (ℕ → R)) β :=
    fun g => (A g).relabel (fun p : α × (ℕ → R) => (p.1, p.2 0))
  have h := dur_pre_piPhases_le (P.lift (ℕ → R)) A' S c b₀ sf hsf hS r
  have heq : (P.lift (ℕ → R)).dur (tauPhases A S c b₀ r) =
      (P.lift (ℕ → R)).dur (Pruning.pre (piPhases A' S c b₀) (r + 1)) := by
    simp only [Pruning.dur, tauPhases, tauTriples, Pruning.pre, piPhases, List.map_flatMap,
      List.map_map]
    congr 1
    refine List.flatMap_congr fun j _ => ?_
    split_ifs <;> simp [Function.comp_def, tauStageOf, tauStage, Alg.restrict]
  rw [heq]; exact h

omit [MeasurableSpace R] in
lemma dur_pre_tauPhases_le (P : Pruning Pb F) (A : (Fin ℓ → ℕ) → Alg V (α × R) β)
    (S : ℕ → Finset (Fin ℓ → ℕ)) (c : ℕ) (b₀ : β) (sf : ℕ → ℕ) (hsf : Monotone sf)
    (hS : ∀ i, (S i).card ≤ sf i) (m : ℕ) :
    (P.lift (ℕ → R)).dur (Pruning.pre (tauPhases A S c b₀) m) ≤
      sf (2 ^ m) * ((c + P.rad) * 2 ^ (m + 1)) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Pruning.pre_succ, Pruning.dur_append]
    have h1 := dur_tauPhases_le P A S c b₀ sf hsf hS m
    have h2 : sf (2 ^ m) ≤ sf (2 ^ (m + 1)) := hsf (Nat.pow_le_pow_right (by norm_num) (by omega))
    have h3 : sf (2 ^ m) * ((c + P.rad) * 2 ^ (m + 1)) ≤
        sf (2 ^ (m + 1)) * ((c + P.rad) * 2 ^ (m + 1)) := Nat.mul_le_mul_right _ h2
    calc _ ≤ sf (2 ^ m) * ((c + P.rad) * 2 ^ (m + 1)) +
          sf (2 ^ m) * ((c + P.rad) * 2 ^ (m + 1)) := Nat.add_le_add ih h1
      _ ≤ sf (2 ^ (m + 1)) * ((c + P.rad) * 2 ^ (m + 1)) +
          sf (2 ^ (m + 1)) * ((c + P.rad) * 2 ^ (m + 1)) := Nat.add_le_add h3 h3
      _ = sf (2 ^ (m + 1)) * ((c + P.rad) * 2 ^ (m + 1 + 1)) := by ring

end TauRun

end Analysis

/-! ## Theorem 2 -/

section Theorem2

open SimpleGraph Cslib.Local

/-- The rounds of the first `s + i` iterations of `τ` (or `s + i`, if larger) grow at most like
`(2a)^i`, where `a` is the constant of the moderately slow function `s_f`. This replaces the
claim `α_{i+1} ≤ K α_i` of the paper, which does not follow from `s_f` being moderately slow. -/
lemma max_dur_le {sf : ℕ → ℕ} (hmono : Monotone sf) {a : ℕ}
    (hslow : ∀ i, i ≠ 1 → sf (2 * i) ≤ a * sf i) {d : ℕ → ℕ} {K : ℕ}
    (hd : ∀ m, d m ≤ sf (2 ^ m) * (K * 2 ^ (m + 1))) {s : ℕ} (hs : 1 ≤ s)
    (hsf1 : 1 ≤ sf (2 ^ s)) (i : ℕ) :
    max (s + i) (d (s + i)) ≤ (2 * K + 1) * (sf (2 ^ s) * 2 ^ s) * (2 * a) ^ i := by
  have hpow : ∀ i, sf (2 ^ (s + i)) ≤ a ^ i * sf (2 ^ s) := by
    intro i
    induction i with
    | zero => simp
    | succ i ih =>
      have h2 : 2 ^ (s + i) ≠ 1 := (Nat.one_lt_two_pow (by omega)).ne'
      calc sf (2 ^ (s + (i + 1))) = sf (2 * 2 ^ (s + i)) := by
            rw [← Nat.add_assoc, pow_succ, mul_comm]
        _ ≤ a * sf (2 ^ (s + i)) := hslow _ h2
        _ ≤ a * (a ^ i * sf (2 ^ s)) := Nat.mul_le_mul_left _ ih
        _ = a ^ (i + 1) * sf (2 ^ s) := by ring
  set X := sf (2 ^ (s + i))
  have h1 : 1 ≤ X := hsf1.trans (hmono (Nat.pow_le_pow_right two_pos (by omega)))
  have h2 : s + i ≤ 2 ^ (s + i) := (Nat.lt_two_pow_self).le
  have h3 : 2 ^ (s + i) ≤ X * 2 ^ (s + i) := Nat.le_mul_of_pos_left _ h1
  calc max (s + i) (d (s + i)) ≤ (s + i) + d (s + i) := max_le (by omega) (by omega)
    _ ≤ X * 2 ^ (s + i) + X * (K * 2 ^ (s + i + 1)) := Nat.add_le_add (h2.trans h3) (hd _)
    _ = (2 * K + 1) * (X * 2 ^ (s + i)) := by ring
    _ ≤ (2 * K + 1) * ((a ^ i * sf (2 ^ s)) * 2 ^ (s + i)) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (hpow i))
    _ = (2 * K + 1) * (sf (2 ^ s) * 2 ^ s) * (2 * a) ^ i := by ring

/-- `s_f(2^s) · 2^s = O(f* · s_f(f*))` for the least `s ≥ 1` with `f* ≤ 2^s` (as in Theorem 1). -/
lemma sf_mul_pow_le {sf : ℕ → ℕ} (hmono : Monotone sf) {a : ℕ}
    (hslow : ∀ i, i ≠ 1 → sf (2 * i) ≤ a * sf i) {fs : ℝ} (hfs0 : 0 ≤ fs) {s : ℕ} (hs1 : 1 ≤ s)
    (hmin : ∀ r < s, ¬ (1 ≤ r ∧ fs ≤ 2 ^ r)) :
    ((sf (2 ^ s) * 2 ^ s : ℕ) : ℝ) ≤ max (2 * a : ℝ) (2 * sf 2) * (fs * sf ⌊fs⌋₊ + 1) := by
  have hC1 : (2 * a : ℝ) ≤ max (2 * a : ℝ) (2 * sf 2) := le_max_left _ _
  have hC2 : (2 * sf 2 : ℝ) ≤ max (2 * a : ℝ) (2 * sf 2) := le_max_right _ _
  have hmax0 : 0 ≤ max (2 * a : ℝ) (2 * sf 2) := hC1.trans' (by positivity)
  rcases Nat.lt_or_ge s 2 with hs2 | hs2
  · obtain rfl : s = 1 := by omega
    push_cast
    calc (sf 2 * 2 : ℝ) = 2 * sf 2 := by ring
      _ ≤ max (2 * a : ℝ) (2 * sf 2) := hC2
      _ ≤ max (2 * a : ℝ) (2 * sf 2) * (fs * sf ⌊fs⌋₊ + 1) := by
          apply le_mul_of_one_le_right hmax0; nlinarith [Nat.cast_nonneg (α := ℝ) (sf ⌊fs⌋₊)]
  · obtain ⟨r, rfl⟩ : ∃ r, s = r + 1 := ⟨s - 1, by omega⟩
    have hr : ¬ (1 ≤ r ∧ fs ≤ 2 ^ r) := hmin r (by omega)
    have hlt : (2 : ℝ) ^ r < fs := by
      rw [not_and, not_le] at hr; exact hr (by omega)
    have hfloor : 2 ^ r ≤ ⌊fs⌋₊ := Nat.le_floor (by exact_mod_cast hlt.le)
    have hsf1 : sf (2 ^ (r + 1)) ≤ a * sf ⌊fs⌋₊ := by
      have h1 : sf (2 * 2 ^ r) ≤ a * sf (2 ^ r) :=
        hslow _ (by have : 2 ≤ 2 ^ r := Nat.le_self_pow (by omega) 2; omega)
      rw [pow_succ, mul_comm]
      exact h1.trans (Nat.mul_le_mul_left _ (hmono hfloor))
    have hsf1' : (sf (2 ^ (r + 1)) : ℝ) ≤ a * sf ⌊fs⌋₊ := by exact_mod_cast hsf1
    have hpow : (2 : ℝ) ^ (r + 1) ≤ 2 * fs := by rw [pow_succ]; linarith
    push_cast
    calc (sf (2 ^ (r + 1)) * 2 ^ (r + 1) : ℝ) ≤ (a * sf ⌊fs⌋₊) * (2 * fs) :=
          mul_le_mul hsf1' hpow (by positivity) (by positivity)
      _ = (2 * a : ℝ) * (fs * sf ⌊fs⌋₊) := by ring
      _ ≤ max (2 * a : ℝ) (2 * sf 2) * (fs * sf ⌊fs⌋₊ + 1) :=
          mul_le_mul hC1 (by linarith) (by positivity) hmax0

/-- **Theorem 2** of [Korman–Sereni–Viennot]. Let `A_Γ` be a weak Monte-Carlo algorithm with
guarantee `ρ ∈ (0, 1]` for `Π` and `F`, depending on the parameters `Γ = (p_1, …, p_ℓ)`, whose
running time with good guesses is bounded by `f : ℕ^ℓ → ℝ_{≥0}`. If `f` has a sequence-number
function `s_f` and there is a `Γ`-monotone pruning algorithm `P` for `Π` and `F`, then there is a
uniform Las Vegas algorithm `U` for `Π` and `F` whose expected running time is
`O(f* · s_f(f*))`, where `f* = f(Γ*)`.

Model: every node has an i.i.d. random tape with law `ν` for `A_Γ`; `U` uses tapes in `ℕ → R`
(i.i.d. with law `ν` in every coordinate), i.e. infinitely many fresh random variables per node.
"Las Vegas" is stated for *every* tape: whenever all nodes have terminated, the outputs form a
solution. The `O` is uniform over all (finite) instances: `E[T_U] ≤ C · (f* · s_f(⌊f*⌋) + 1)`.
We assume (as in the paper's setting of bit-string inputs and outputs) countable input and output
alphabets and outputs of `A_Γ` that are measurable in the tapes (`OutputsMeasurable`). -/
theorem theorem_2 {V α β R : Type*} {ℓ : ℕ} [Inhabited β] [Countable α] [Countable β]
    [MeasurableSpace R] (ν : Measure R) [IsProbabilityMeasure ν]
    (Pb : Problem V α β) (F : Family V α) (Γ : Fin ℓ → Param V α)
    (A : (Fin ℓ → ℕ) → Alg V (α × R) β) (f : (Fin ℓ → ℕ) → ℝ) (hf0 : ∀ g, 0 ≤ f g)
    (ρ : ℝ) (hρ : 0 < ρ) (hA : WeakMonteCarlo ν Pb F Γ A f ρ) (hmeas : OutputsMeasurable A)
    (sf : ℕ → ℕ) (hsf : IsSeqNumber f sf) (P : Pruning Pb F) (hP : ∀ k, P.Monotone (Γ k)) :
    ∃ U : Alg V (α × (ℕ → R)) β, ∃ C : ℝ, ∀ G x, F.mem G x → (supp x).Finite →
      (∀ ω T, (∀ v, (x v).isSome → (U.out T G (tag x ω) v).isSome) →
        U.RSolvesWithin Pb G x ω T) ∧
      ∫⁻ ω, U.runTime G x ω ∂(Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν)
        ≤ ENNReal.ofReal (C * (f (correct Γ G x) * sf ⌊f (correct Γ G x)⌋₊ + 1)) := by
  classical
  obtain ⟨⟨hmono, a, ha, hslow⟩, S, c, hc, hcard⟩ := hsf
  set K : ℕ := ⌈c⌉₊ + P.rad
  set K1 : ℕ := 2 * K + 1
  set q : ℝ≥0∞ := 1 - ENNReal.ofReal ρ
  have hq1 : q < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero (by simpa using hρ)
  have hqtop : q ≠ ⊤ := ne_top_of_lt hq1
  set r : ℝ := q.toReal
  have hr0 : 0 ≤ r := ENNReal.toReal_nonneg
  have hr1 : r < 1 := by
    simpa using (ENNReal.toReal_lt_toReal hqtop ENNReal.one_ne_top).2 hq1
  have hqr : q = ENNReal.ofReal r := (ENNReal.ofReal_toReal hqtop).symm
  set u : ℕ → ℝ := fun i => (2 * a : ℝ) ^ i * r ^ (i * (i + 1) / 2)
  have hu0 : ∀ i, 0 ≤ u i := fun i => by simp only [u]; positivity
  have hu : Summable u := summable_pow_mul_pow_tri (by positivity) hr0 hr1
  set Z : ℝ := ∑' i, u i
  have hZ0 : 0 ≤ Z := tsum_nonneg hu0
  set Cm : ℝ := max (2 * a : ℝ) (2 * sf 2)
  have hCm : 0 ≤ Cm := (le_max_left _ _).trans' (by positivity)
  refine ⟨algTau P A S.S ⌈c⌉₊ default, (K1 : ℝ) * (1 + 2 * a * Z) * Cm,
    fun G x hx hfin => ⟨fun ω T h => algTau_correct P A S.S ⌈c⌉₊ default hx ω T h, ?_⟩⟩
  set fs := f (correct Γ G x)
  have hex : ∃ s, 1 ≤ s ∧ fs ≤ 2 ^ s := by
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt fs (by norm_num : (1 : ℝ) < 2)
    exact ⟨n + 1, by omega, hn.le.trans (pow_le_pow_right₀ (by norm_num) (by omega))⟩
  obtain ⟨s, ⟨hs1, hfs⟩, hmin⟩ : ∃ s, (1 ≤ s ∧ fs ≤ 2 ^ s) ∧ ∀ r < s, ¬ (1 ≤ r ∧ fs ≤ 2 ^ r) :=
    ⟨Nat.find hex, Nat.find_spec hex, fun r hr => Nat.find_min hex hr⟩
  -- every iteration `j ≥ s` of `π` contains a good sub-iteration
  have hgood : ∀ r' j, s ≤ j →
      ∃ g ∈ S.S (2 ^ j), decide (GoodSub Γ f ⌈c⌉₊ G x (r', j, g)) = true := by
    intro r' j hj
    obtain ⟨g, hgS, hpg⟩ := S.dom (2 ^ j) (correct Γ G x) (by
      have : (2 : ℝ) ^ s ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) hj
      exact_mod_cast hfs.trans this)
    refine ⟨g, hgS, decide_eq_true ⟨fun k => hpg k, ?_⟩⟩
    have := hc.2 (2 ^ j) g hgS
    show f g ≤ ((⌈c⌉₊ * 2 ^ j : ℕ) : ℝ)
    push_cast at this ⊢
    exact this.trans (mul_le_mul_of_nonneg_right (Nat.le_ceil c) (by positivity))
  have hsf1 : 1 ≤ sf (2 ^ s) := by
    obtain ⟨g, hg, -⟩ := hgood 0 s le_rfl
    exact (Finset.card_pos.2 ⟨g, hg⟩).trans_le (hcard _)
  set μ := Measure.infinitePi fun _ : V => Measure.infinitePi fun _ : ℕ => ν
  set Act : ℕ → Set (V → ℕ → R) := fun m =>
    {ω | stageRun (fun k => tapeAt k) code (tauStep P A default G ⌈c⌉₊) (preT S.S m) x ω ∈ Active}
  set D : ℕ → ℕ := fun m =>
    max m ((P.lift (ℕ → R)).dur (Pruning.pre (tauPhases A S.S ⌈c⌉₊ default) m))
  have hAct : ∀ m, MeasurableSet (Act m) := fun m =>
    measurableSet_stageRun_mem measurable_tapeAt (reach_countable hfin) (mem_reach_self hx)
      (fun tr _ z hz e => tauStep_mem_reach P hP A default ⌈c⌉₊ tr hz e)
      (fun tr _ z hz z' => measurableSet_tauStep_eq P hmeas default G ⌈c⌉₊ tr
        (supp_finite_of_mem_reach hfin hz) z') Active
  have hE := lintegral_le_of_phases μ ((algTau P A S.S ⌈c⌉₊ default).runTime G x) Act hAct D
    (fun m => le_max_left _ _)
    (fun m ω hω => runTime_algTau_le P A S.S ⌈c⌉₊ default hx ω m hω) s
  have hprob : ∀ i, μ (Act (s + i)) ≤ q ^ (i * (i + 1) / 2) := by
    intro i
    refine (measure_active_le ν hA hmeas P hP default hx hfin ⌈c⌉₊ (preT S.S (s + i))
      (nodup_preT_code _ _)).trans ?_
    exact pow_le_pow_of_le_one (zero_le) hq1.le (le_countP_preT S.S _ hs1 hgood i)
  have hD : ∀ i, D (s + i) ≤ K1 * (sf (2 ^ s) * 2 ^ s) * (2 * a) ^ i :=
    max_dur_le hmono hslow
      (fun m => dur_pre_tauPhases_le P A S.S ⌈c⌉₊ default sf hmono hcard m) hs1 hsf1
  set M : ℕ := sf (2 ^ s) * 2 ^ s
  have hM : (M : ℝ) ≤ Cm * (fs * sf ⌊fs⌋₊ + 1) := sf_mul_pow_le hmono hslow (hf0 _) hs1 hmin
  calc ∫⁻ ω, (algTau P A S.S ⌈c⌉₊ default).runTime G x ω ∂μ
      ≤ D s + ∑' i, (D (s + i + 1) : ℝ≥0∞) * μ (Act (s + i)) := hE
    _ ≤ ENNReal.ofReal ((K1 : ℝ) * M) +
          ∑' i, ENNReal.ofReal ((K1 : ℝ) * M * (2 * a) * u i) := by
        gcongr with i
        · have := hD 0
          simp only [Nat.add_zero, pow_zero, mul_one] at this
          rw [← ENNReal.ofReal_natCast]
          exact ENNReal.ofReal_le_ofReal (by exact_mod_cast this)
        · have h1 := hD (i + 1)
          rw [← Nat.add_assoc] at h1
          calc (D (s + i + 1) : ℝ≥0∞) * μ (Act (s + i))
              ≤ ENNReal.ofReal ((K1 : ℝ) * M * (2 * a) ^ (i + 1)) *
                  ENNReal.ofReal r ^ (i * (i + 1) / 2) := by
                gcongr
                · rw [← ENNReal.ofReal_natCast]
                  exact ENNReal.ofReal_le_ofReal (by exact_mod_cast h1)
                · rw [← hqr]; exact hprob i
            _ = _ := by
                rw [← ENNReal.ofReal_pow hr0, ← ENNReal.ofReal_mul (by positivity)]
                congr 1
                simp only [u]; ring
    _ = ENNReal.ofReal ((K1 : ℝ) * M + (K1 : ℝ) * M * (2 * a) * Z) := by
        rw [← ENNReal.ofReal_tsum_of_nonneg (fun i => mul_nonneg (by positivity) (hu0 i))
          (hu.mul_left _), tsum_mul_left, ENNReal.ofReal_add (by positivity)
          (mul_nonneg (by positivity) hZ0)]
    _ ≤ ENNReal.ofReal ((K1 : ℝ) * (1 + 2 * a * Z) * Cm * (fs * sf ⌊fs⌋₊ + 1)) := by
        apply ENNReal.ofReal_le_ofReal
        calc ((K1 : ℝ) * M + (K1 : ℝ) * M * (2 * a) * Z) = (K1 : ℝ) * (1 + 2 * a * Z) * M := by
              ring
          _ ≤ (K1 : ℝ) * (1 + 2 * a * Z) * (Cm * (fs * sf ⌊fs⌋₊ + 1)) :=
              mul_le_mul_of_nonneg_left hM (by positivity)
          _ = _ := by ring

/-! ### Non-vacuity: deterministic algorithms are weak Monte-Carlo algorithms -/

/-- A deterministic algorithm, viewed as a randomized algorithm that ignores its tape. -/
def Alg.ignoreTape {V α β : Type*} (R : Type*) (A : Alg V α β) : Alg V (α × R) β :=
  A.relabel Prod.fst

lemma Alg.ignoreTape_out {V α β R : Type*} (A : Alg V α β) (t : ℕ) (G : SimpleGraph V)
    (x : V → Option α) (e : V → R) (v : V) :
    (A.ignoreTape R).out t G (tag x e) v = A.out t G x v := by
  have : (fun u => (tag x e u).map Prod.fst) = x := untag_tag x e
  simp only [Alg.ignoreTape, Alg.relabel, this]

/-- The hypotheses of Theorem 2 are satisfiable: a deterministic algorithm whose running time with
good guesses is bounded by `f` is a weak Monte-Carlo algorithm with guarantee `1`, and its outputs
are (trivially) measurable in the tapes. -/
lemma weakMonteCarlo_ignoreTape {V α β R : Type*} {ℓ : ℕ} [MeasurableSpace R] (ν : Measure R)
    [IsProbabilityMeasure ν] {Pb : Problem V α β} {F : Family V α} {Γ : Fin ℓ → Param V α}
    {A : (Fin ℓ → ℕ) → Alg V α β} {f : (Fin ℓ → ℕ) → ℝ} (hA : DependsWithTime Pb F Γ A f) :
    WeakMonteCarlo ν Pb F Γ (fun g => (A g).ignoreTape R) f 1 ∧
      OutputsMeasurable (fun g => (A g).ignoreTape R) := by
  refine ⟨fun G x hx _ g hg T hT => ?_, fun g t G x _ v b => ?_⟩
  · obtain ⟨y, hy, hout⟩ := hA G x hx g hg T hT
    have : {e : V → R | ((A g).ignoreTape R).RSolvesWithin Pb G x e T} = Set.univ :=
      Set.eq_univ_of_forall fun e =>
        ⟨y, hy, fun v hv => by rw [Alg.ignoreTape_out]; exact hout v hv⟩
    rw [this, measure_univ, ENNReal.ofReal_one]
  · simp only [Alg.ignoreTape_out]
    exact MeasurableSet.const _

end Theorem2

