import Papers.PODC2011.CompactPolicyRouting.Paths

/-!
# Stretch-3 compact routing on regular algebras (Section 4.4.1, Theorem 4.14)

Cowen's landmark scheme, generalized to regular routing algebras.

* `lemma_4_16`, `lemma_4_16_paper`: the algebraic core `w(p*_{u,l_v}) ⊕ w(p*_{l_v,v}) ⪯ w(p*_{u,v})³` for
  `v ∉ C(u)` (regular `A`).
* `lemma_4_15`: monotone `A`; the next hop on a preferred path towards `t` stays inside the ball of `t`.
* **Consistent next hops** (gap of the paper, which silently assumes that "the preferred path" can be followed
  hop by hop). Subpaths of preferred paths need not be preferred unless `A` is strictly monotone, so an
  arbitrary choice of preferred paths can create forwarding loops. `exists_isHO` proves (Dijkstra-style) that for
  regular `A` on a finite connected graph every node has a *hereditarily preferred* walk to `t` (every suffix
  is preferred), and `exists_inTree` turns these into an `InTree`: next hops with a strictly decreasing rank
  such that `w(x, nh x) ⊕ w(p*_{nh x, t}) = w(p*_{x,t})`.
* `Scheme`: an abstract landmark scheme (in-trees, landmark map, which node stores which destination) with the
  four properties the correctness proof needs. `Scheme.next` is the forwarding decision of a node computed only
  from its local table (`Scheme.lookup`) and the packet header (`Scheme.label`).
  `Scheme.delivers` (regular `A`, connected `G`): every packet reaches its destination along a *path* of
  stretch 3, including the "mixed" routes (towards `l_v` until the first node storing `v`, then on the in-tree)
  that the paper does not analyse.
* `paperScheme`: the paper's literal balls `B(v) = {x : w(p*_{v,x}) ⪯ w(p*_{v,l_v})}` (with consistent
  in-trees) is a `Scheme`; but `paperScheme_table_eq_univ`: for every monotone selective algebra (e.g. widest
  path) and constant edge weights, every table contains *all* `n` destinations, whatever the landmark set.
* `refinedScheme`: balls defined by the strict key `(w(p*_{x,v}), rank of x in the in-tree to v, x)`
  (lexicographic). `theorem_4_14`: delivery with stretch 3, tables `C(u) ∪ L`, and each ball `B(v)` is
  contained in the set of nodes whose key is below that of any landmark (`refinedBall_subset`), which is the
  combinatorial input to Cowen's landmark selection (left as a hypothesis, see `card_table_le`).

Delimitedness is never used.
-/

namespace Podc.CompactPolicyRouting

open SimpleGraph RoutingAlgebra

universe u v

variable {W : Type u} [LinearOrder W] {A : RoutingAlgebra W} {V : Type v} {wt : Sym2 V → W}
  {G : SimpleGraph V}

/-! ### Lemmas 4.15 and 4.16 -/

section Lemmas

variable [Finite V]

/-- Lemma 4.16 of [Rétvári et al.], core inequality: if `A` is regular and `w(p*_{v,l}) ⪯ w(p*_{v,u})` (i.e. `u`
is not strictly closer to `v` than the landmark `l`), then `w(p*_{u,l}) ⊕ w(p*_{l,v}) ⪯ w(p*_{u,v})³`. -/
theorem lemma_4_16 (hR : A.IsRegular) (hconn : G.Connected) {u v l : V}
    (h : pw A wt G v l ≤ pw A wt G v u) :
    pw A wt G u l * pw A wt G l v ≤ pw A wt G u v ^ 3 := by
  have h' : pw A wt G v l ≤ pw A wt G u v := by rw [pw_comm u v]; exact h
  have h1 : pw A wt G l v ≤ pw A wt G u v := by rw [pw_comm l v]; exact h'
  have h2 : pw A wt G u l ≤ pw A wt G u v * pw A wt G u v :=
    (pw_triangle hR.1 (hconn.preconnected u v) (hconn.preconnected v l)).trans
      (hR.mul_le_mul le_rfl h')
  calc pw A wt G u l * pw A wt G l v ≤ (pw A wt G u v * pw A wt G u v) * pw A wt G u v :=
        hR.mul_le_mul h2 h1
    _ = pw A wt G u v ^ 3 := by rw [pow_succ, pow_two]

/-- Lemma 4.16 of [Rétvári et al.], with the paper's balls: if `v ∉ C(u)`, i.e. `u ∉ B(v)` where
`B(v) = {x : w(p*_{v,x}) ⪯ w(p*_{v,l_v})}`, then `w(p*_{u,l_v}) ⊕ w(p*_{l_v,v}) ⪯ w(p*_{u,v})³`. -/
theorem lemma_4_16_paper (hR : A.IsRegular) (hconn : G.Connected) (lm : V → V) {u v : V}
    (hv : ¬ pw A wt G v u ≤ pw A wt G v (lm v)) :
    pw A wt G u (lm v) * pw A wt G (lm v) v ≤ pw A wt G u v ^ 3 :=
  lemma_4_16 hR hconn (not_le.1 hv).le

/-- Lemma 4.15 of [Rétvári et al.]: if `A` is monotone, `u` lies in the (paper's) ball of `t` with respect to
some landmark `lt`, i.e. `w(p*_{t,u}) ⪯ w(p*_{t,lt})`, and `x` is the next hop on a preferred `u – t` path, then
`x` lies in that ball too. -/
theorem lemma_4_15 (hM : A.IsMonotone) {u x t lt : V} (h : G.Adj u x) (q : G.Walk x t)
    (hp : IsPreferred A wt (Walk.cons h q)) (hu : pw A wt G t u ≤ pw A wt G t lt) :
    pw A wt G t x ≤ pw A wt G t lt := by
  rw [pw_comm] at hu ⊢
  refine le_trans ?_ hu
  rw [← hp.weight_eq, weight_cons]
  exact (pw_le_weight hM q).trans (hM.le_mul _ _)

end Lemmas

/-! ### Walks following a forwarding function -/

section Follow

-- CSLib candidate: walks generated by a forwarding function `f : V → V` (`Follows`, `Follows.getVert`,
-- `exists_follows`, `Follows.isPath`) are independent of routing algebras.

/-- A walk *follows* the forwarding function `f` if every step goes from the current node `x` to `f x`. -/
def Follows (f : V → V) : ∀ {x y : V}, G.Walk x y → Prop
  | _, _, .nil => True
  | x, _, .cons (v := y) _ p => f x = y ∧ Follows f p

/-- The `i`-th node of a walk following `f` is `f^[i]` of its start. -/
theorem Follows.getVert {f : V → V} :
    ∀ {x y : V} (p : G.Walk x y), Follows f p → ∀ i ≤ p.length, p.getVert i = f^[i] x
  | _, _, .nil, _, i, hi => by
    simp only [Walk.length_nil, Nat.le_zero] at hi; subst hi; simp
  | _, _, .cons _ _, _, 0, _ => by simp
  | _, _, .cons h p, hp, i + 1, hi => by
    rw [Walk.getVert_cons_succ, Follows.getVert p hp.2 i (by simpa using hi),
      Function.iterate_succ_apply, hp.1]

/-- If `f` moves along edges and strictly decreases a measure until `v` is reached, then from every node there
is a walk to `v` following `f`. -/
theorem exists_follows {f : V → V} {v : V} (μ : V → ℕ) (hadj : ∀ x, x ≠ v → G.Adj x (f x))
    (hμ : ∀ x, x ≠ v → μ (f x) < μ x) (s : V) : ∃ p : G.Walk s v, Follows f p := by
  induction hn : μ s using Nat.strong_induction_on generalizing s with
  | _ n ih =>
    by_cases hs : s = v
    · subst hs; exact ⟨.nil, trivial⟩
    · obtain ⟨p, hp⟩ := ih _ (hn ▸ hμ s hs) (f s) rfl
      exact ⟨.cons (hadj s hs) p, rfl, hp⟩

/-- A walk to `v` following `f` (with `f v = v`) along which a measure strictly decreases is a path. -/
theorem Follows.isPath {f : V → V} {v : V} (μ : V → ℕ) (hfv : f v = v)
    (hμ : ∀ x, x ≠ v → μ (f x) < μ x) {s : V} (p : G.Walk s v) (hp : Follows f p) :
    p.IsPath ∧ ∀ y ∈ p.support, μ y ≤ μ s := by
  induction p with
  | nil => exact ⟨Walk.IsPath.nil, by simp⟩
  | @cons x y w h p ih =>
    obtain ⟨hxy, hp⟩ := hp
    have hxw : x ≠ w := by
      rintro rfl
      rw [hfv] at hxy
      subst hxy
      exact G.ne_of_adj h rfl
    have hlt : μ y < μ x := hxy ▸ hμ x hxw
    obtain ⟨hpath, hsupp⟩ := ih hfv hμ hp
    refine ⟨(Walk.cons_isPath_iff h p).2 ⟨hpath, fun hx => ?_⟩, ?_⟩
    · exact absurd (hsupp x hx) (not_le.2 hlt)
    · intro z hz
      rw [Walk.support_cons, List.mem_cons] at hz
      rcases hz with rfl | hz
      · exact le_rfl
      · exact (hsupp z hz).trans hlt.le

end Follow

/-! ### Consistent next hops: hereditarily preferred walks and in-trees -/

section InTree

variable [Finite V]

variable (A wt) in
/-- A walk is *hereditarily preferred* if each of its suffixes has preferred weight. -/
def IsHO : ∀ {x y : V}, G.Walk x y → Prop
  | _, _, .nil => True
  | x, y, .cons h p => weight A wt (.cons h p) = pw A wt G x y ∧ IsHO p

theorem IsHO.weight_eq {x y : V} (p : G.Walk x y) (hp : IsHO A wt p) :
    weight A wt p = pw A wt G x y := by
  cases p with
  | nil => simp
  | cons h p => exact hp.1

/-- Dijkstra's cut argument: a walk from outside `S` into `S` crosses some edge `zs` (`z ∉ S`, `s ∈ S`) with
`w(z,s) ⊕ w(p*_{s,t}) ⪯` the weight of the walk. -/
theorem exists_cross_le (hR : A.IsRegular) (S : Set V) {a t : V} (q : G.Walk a t) (ha : a ∉ S)
    (ht : t ∈ S) :
    ∃ z s, z ∉ S ∧ s ∈ S ∧ G.Adj z s ∧
      A.emb (wt s(z, s)) * pw A wt G s t ≤ weight A wt q := by
  induction q with
  | nil => exact absurd ht ha
  | @cons x y w h q ih =>
    rw [weight_cons]
    by_cases hy : y ∈ S
    · exact ⟨x, y, ha, hy, h, hR.mul_le_mul_left (pw_le_weight hR.1 q) _⟩
    · obtain ⟨z, s, hz, hs, hzs, hle⟩ := ih hy ht
      exact ⟨z, s, hz, hs, hzs, hle.trans (hR.1.le_mul _ _)⟩

/-- **Consistent next hops (gap in the paper).** For a regular algebra on a finite connected graph, every node
has a hereditarily preferred walk to `t`. -/
theorem exists_isHO (hR : A.IsRegular) (hconn : G.Connected) (t x : V) :
    ∃ p : G.Walk x t, IsHO A wt p := by
  classical
  have : Fintype V := Fintype.ofFinite V
  by_contra hx
  let S : Set V := {y | ∃ p : G.Walk y t, IsHO A wt p}
  have htS : t ∈ S := ⟨.nil, trivial⟩
  let P : Finset (V × V) := Finset.univ.filter fun e => e.1 ∉ S ∧ e.2 ∈ S ∧ G.Adj e.1 e.2
  let D : V × V → A.Ext := fun e => A.emb (wt s(e.1, e.2)) * pw A wt G e.2 t
  have hcross : ∀ a (q : G.Walk a t), a ∉ S → ∃ e ∈ P, D e ≤ weight A wt q := by
    intro a q ha
    obtain ⟨z, s, hz, hs, hzs, hle⟩ := exists_cross_le (wt := wt) hR S q ha htS
    exact ⟨(z, s), by simp [P, hz, hs, hzs], hle⟩
  obtain ⟨e0, he0, -⟩ := hcross x (hconn.preconnected x t).some hx
  obtain ⟨⟨z, s⟩, heP, hmin⟩ := P.exists_min_image D ⟨e0, he0⟩
  simp only [P, Finset.mem_filter, Finset.mem_univ, true_and] at heP
  obtain ⟨hz, ⟨ps, hps⟩, hzs⟩ := heP
  obtain ⟨p, -, hp⟩ := exists_isPreferred_weight (A := A) (wt := wt) (hconn.preconnected z t)
  obtain ⟨e', he', hle⟩ := hcross z p hz
  have h1 : D (z, s) ≤ pw A wt G z t := (hmin e' he').trans (hle.trans hp.le)
  have hw : weight A wt (Walk.cons hzs ps) = D (z, s) := by
    rw [weight_cons, hps.weight_eq]
  have h2 : pw A wt G z t ≤ D (z, s) := hw ▸ pw_le_weight hR.1 _
  exact hz ⟨.cons hzs ps, by rw [hw]; exact le_antisymm h1 h2, hps⟩

variable (A wt G) in
/-- A consistent in-tree towards `t`: next hops `nh x` (a neighbour of `x` for `x ≠ t`) with a strictly
decreasing rank, such that the edge to the next hop followed by a preferred path from it is preferred. -/
structure InTree (t : V) where
  /-- The next hop of `x` towards `t`. -/
  nh : V → V
  /-- A rank strictly decreasing along next hops (e.g. the hop count of the tree path). -/
  rank : V → ℕ
  adj : ∀ x, x ≠ t → G.Adj x (nh x)
  rank_lt : ∀ x, x ≠ t → rank (nh x) < rank x
  weight_eq : ∀ x, x ≠ t → A.emb (wt s(x, nh x)) * pw A wt G (nh x) t = pw A wt G x t

/-- **Consistent next hops exist** for regular algebras on finite connected graphs (any edge weights;
delimitedness is not needed). Next hop = second node of a shortest (in hops) hereditarily preferred walk. -/
theorem exists_inTree (hR : A.IsRegular) (hconn : G.Connected) (t : V) :
    Nonempty (InTree A wt G t) := by
  classical
  have hex : ∀ x, ∃ n, ∃ p : G.Walk x t, IsHO A wt p ∧ p.length = n := fun x => by
    obtain ⟨p, hp⟩ := exists_isHO (wt := wt) hR hconn t x
    exact ⟨_, p, hp, rfl⟩
  let rank : V → ℕ := fun x => Nat.find (hex x)
  have H : ∀ x, x ≠ t → ∃ y, G.Adj x y ∧ rank y < rank x ∧
      A.emb (wt s(x, y)) * pw A wt G y t = pw A wt G x t := by
    intro x hx
    obtain ⟨p, hp, hlen⟩ := Nat.find_spec (hex x)
    cases p with
    | nil => exact absurd rfl hx
    | @cons _ y _ h q =>
      refine ⟨y, h, ?_, ?_⟩
      · have : rank y ≤ q.length := Nat.find_min' (hex y) ⟨q, hp.2, rfl⟩
        change rank y < rank x
        simp only [Walk.length_cons] at hlen
        change _ = rank x at hlen
        omega
      · rw [← hp.1, weight_cons, hp.2.weight_eq]
  choose! nh hadj hlt hw using H
  exact ⟨⟨nh, rank, hadj, hlt, hw⟩⟩

/-- A choice of consistent in-trees towards every target. -/
noncomputable def inTree (hR : A.IsRegular) (hconn : G.Connected) (t : V) : InTree A wt G t :=
  (exists_inTree hR hconn t).some

theorem InTree.pw_nh_le (hM : A.IsMonotone) {t : V} (T : InTree A wt G t) {x : V} (hx : x ≠ t) :
    pw A wt G (T.nh x) t ≤ pw A wt G x t := by
  rw [← T.weight_eq x hx]; exact hM.le_mul _ _

end InTree

/-! ### Cowen's landmark scheme -/

/-- The packet header: the label `(v, l_v, port_{l_v,v})` of the destination `v`; the port is represented by
the neighbour of `l_v` it leads to. -/
structure CowenHeader (V : Type v) where
  dest : V
  landmark : V
  port : V

/-- The forwarding decision of node `u`, computed only from `u`, its local table `tbl` (destination ↦ next hop,
if stored) and the header: stop at the destination; use the table entry for the destination if there is one;
at the destination's landmark use the port from the header; otherwise use the table entry for the landmark. -/
def cowenForward [DecidableEq V] (u : V) (tbl : V → Option V) (h : CowenHeader V) : V :=
  if u = h.dest then u
  else match tbl h.dest with
    | some p => p
    | none => if u = h.landmark then h.port else (tbl h.landmark).getD u

section Scheme

variable [Fintype V]

open Classical in
/-- Table lookup at `u`, given in-trees `tree` and the storage relation: the next hop towards `t` if `u` stores
`t`. -/
noncomputable def cowenLookup (tree : ∀ t, InTree A wt G t) (Stores : V → V → Prop) (u t : V) : Option V :=
  if Stores u t then some ((tree t).nh u) else none

/-- The label of `v` (= packet header): `(v, l_v, next hop of l_v towards v)`. -/
def cowenLabel (tree : ∀ t, InTree A wt G t) (landmark : V → V) (v : V) : CowenHeader V :=
  ⟨v, landmark v, (tree v).nh (landmark v)⟩

open Classical in
/-- The next hop chosen by `u` for a packet destined to `v`: `cowenForward` applied to `u`'s own table and the
label of `v`. -/
noncomputable def cowenNext (tree : ∀ t, InTree A wt G t) (landmark : V → V) (Stores : V → V → Prop)
    (v u : V) : V :=
  cowenForward u (cowenLookup tree Stores u) (cowenLabel tree landmark v)

variable (A wt G) in
/-- An abstract Cowen-style landmark scheme: consistent in-trees towards every node, a landmark `landmark v` for
every destination, and the relation `Stores u v` ("`u` has a routing table entry for `v`"), with the properties
used by the correctness proof. -/
structure Scheme where
  tree : ∀ t, InTree A wt G t
  landmark : V → V
  /-- `Stores u v`: node `u` has a table entry for destination `v`. -/
  Stores : V → V → Prop
  /-- Every node stores every landmark. -/
  stores_landmark : ∀ u v, Stores u (landmark v)
  good_self : ∀ v, Stores v v ∨ v = landmark v
  /-- Strong form of Lemma 4.15: from a node storing `v` (or from `l_v`) the next hop towards `v` stores `v`. -/
  stores_nh : ∀ u v, Stores u v ∨ u = landmark v → u ≠ v → Stores ((tree v).nh u) v
  /-- A node not storing `v` is not strictly closer to `v` than `l_v`. -/
  pw_landmark_le : ∀ u v, ¬ Stores u v → pw A wt G v (landmark v) ≤ pw A wt G v u

namespace Scheme

variable (S : Scheme A wt G)

open Classical in
/-- The routing table of `u`: the set of destinations it stores. -/
noncomputable def table (u : V) : Finset V := Finset.univ.filter (S.Stores u)

/-- Table lookup at `u`: the next hop towards `t` if `u` stores `t`. -/
noncomputable def lookup (u t : V) : Option V := cowenLookup S.tree S.Stores u t

/-- The label of `v` (= packet header): `(v, l_v, next hop of l_v towards v)`. -/
def label (v : V) : CowenHeader V := cowenLabel S.tree S.landmark v

/-- The next hop chosen by `u` for a packet destined to `v`. -/
noncomputable def next (v u : V) : V := cowenNext S.tree S.landmark S.Stores v u

/-- The scheme delivers every packet along a path of stretch 3: from every `s`, iterating the forwarding
function traces a path from `s` to `v` within stretch 3 (so `v` is reached after `< n` hops). -/
def Delivers : Prop :=
  ∀ s v : V, ∃ p : G.Walk s v, p.IsPath ∧ IsWithinStretch A wt 3 p ∧
    ∀ i ≤ p.length, p.getVert i = (S.next v)^[i] s

theorem mem_table {u v : V} : v ∈ S.table u ↔ S.Stores u v := by
  classical
  simp [table]

/-- `u` forwards along the in-tree of `v` once it stores `v` (or is `l_v`). -/
def Good (u v : V) : Prop := S.Stores u v ∨ u = S.landmark v

theorem next_self (v : V) : S.next v v = v := by
  simp [next, cowenNext, cowenForward, cowenLabel]

open Classical in
theorem next_eq {u v : V} (huv : u ≠ v) :
    S.next v u = if S.Good u v then (S.tree v).nh u else (S.tree (S.landmark v)).nh u := by
  classical
  simp only [next, cowenNext, cowenForward, cowenLabel, cowenLookup, Good]
  by_cases h1 : S.Stores u v
  · simp [h1, huv]
  · by_cases h2 : u = S.landmark v
    · subst h2; simp [h1, huv]
    · simp [h1, h2, huv, S.stores_landmark]

theorem good_nh {u v : V} (hu : S.Good u v) (huv : u ≠ v) : S.Good ((S.tree v).nh u) v :=
  Or.inl (S.stores_nh u v hu huv)

theorem landmark_good (v : V) : S.Good (S.landmark v) v := Or.inr rfl

open Classical in
/-- The termination measure for a packet to `v`: first the rank in the in-tree of `l_v`, then in that of `v`. -/
noncomputable def measure (v u : V) : ℕ :=
  if S.Good u v then (S.tree v).rank u
  else (Finset.univ.sup (S.tree v).rank + 1) + (S.tree (S.landmark v)).rank u

theorem measure_lt {u v : V} (huv : u ≠ v) : S.measure v (S.next v u) < S.measure v u := by
  classical
  rw [S.next_eq huv]
  by_cases hg : S.Good u v
  · rw [ite_eq_left hg, measure, measure, ite_eq_left (S.good_nh hg huv), ite_eq_left hg]
    exact (S.tree v).rank_lt u huv
  · have hul : u ≠ S.landmark v := fun h => hg (Or.inr h)
    rw [ite_eq_right hg, measure, measure, ite_eq_right hg]
    have hr := (S.tree (S.landmark v)).rank_lt u hul
    split_ifs
    · have := Finset.le_sup (f := (S.tree v).rank) (Finset.mem_univ ((S.tree (S.landmark v)).nh u))
      omega
    · omega

theorem adj_next {u v : V} (huv : u ≠ v) : G.Adj u (S.next v u) := by
  rw [S.next_eq huv]
  split_ifs with hg
  · exact (S.tree v).adj u huv
  · exact (S.tree (S.landmark v)).adj u fun h => hg (Or.inr h)

/-- Phase 2: from a good node the packet follows the in-tree of `v`, with preferred weight. -/
theorem weight_eq_of_good {v x : V} (p : G.Walk x v) (hp : Follows (S.next v) p)
    (hx : S.Good x v) : weight A wt p = pw A wt G x v := by
  induction p with
  | nil => simp
  | @cons x y w h p ih =>
    obtain ⟨hxy, hp⟩ := hp
    have hxw : x ≠ w := by
      rintro rfl
      rw [S.next_self] at hxy
      subst hxy
      exact G.ne_of_adj h rfl
    rw [S.next_eq hxw, ite_eq_left hx] at hxy
    subst hxy
    rw [weight_cons, ih hp (S.good_nh hx hxw), (S.tree w).weight_eq x hxw]

/-- Phase 1 (the mixed routes, not analysed in the paper): from a node not storing `v`, the packet first
follows the in-tree of `l_v` until the first good node, then the in-tree of `v`; its weight is at most
`w(p*_{x,l_v}) ⊕ w(p*_{l_v,v})`. -/
theorem weight_le_of_not_good (hR : A.IsRegular) (hconn : G.Connected) {v x : V} (p : G.Walk x v)
    (hp : Follows (S.next v) p) (hx : ¬ S.Good x v) :
    weight A wt p ≤ pw A wt G x (S.landmark v) * pw A wt G (S.landmark v) v := by
  induction p with
  | nil => exact absurd (S.good_self _) hx
  | @cons x y w h p ih =>
    obtain ⟨hxy, hp⟩ := hp
    have hxw : x ≠ w := by
      rintro rfl
      rw [S.next_self] at hxy
      subst hxy
      exact G.ne_of_adj h rfl
    have hxl : x ≠ S.landmark w := fun h => hx (Or.inr h)
    rw [S.next_eq hxw, ite_eq_right hx] at hxy
    subst hxy
    rw [weight_cons, ← (S.tree (S.landmark w)).weight_eq x hxl, mul_assoc]
    refine hR.mul_le_mul_left ?_ _
    by_cases hy : S.Good ((S.tree (S.landmark w)).nh x) w
    · rw [S.weight_eq_of_good p hp hy]
      exact pw_triangle hR.1 (hconn.preconnected _ _) (hconn.preconnected _ _)
    · exact ih hp hy

/-- **Correctness and stretch 3** of any `Scheme` for a regular algebra on a connected graph. -/
theorem delivers (hR : A.IsRegular) (hconn : G.Connected) : S.Delivers := by
  intro s v
  obtain ⟨p, hp⟩ := exists_follows (S.measure v) (fun x hx => S.adj_next hx)
    (fun x hx => S.measure_lt hx) s
  refine ⟨p, (hp.isPath (S.measure v) (S.next_self v) (fun x hx => S.measure_lt hx) p).1, ?_,
    hp.getVert p⟩
  unfold IsWithinStretch
  by_cases hs : S.Good s v
  · rw [S.weight_eq_of_good p hp hs, pow_succ']
    exact hR.1.le_mul' _ _
  · refine (S.weight_le_of_not_good hR hconn p hp hs).trans (lemma_4_16 hR hconn ?_)
    exact S.pw_landmark_le s v fun h => hs (Or.inl h)

end Scheme

end Scheme

/-! ### The paper's scheme (non-strict balls) -/

section Paper

variable [Fintype V]

variable (A wt G) in
/-- The paper's landmark of `v`: a landmark closest to `v` (ties broken arbitrarily). -/
noncomputable def paperLandmark (L : Finset V) (v : V) : V :=
  if h : L.Nonempty then (L.exists_min_image (pw A wt G v) h).choose else v

theorem paperLandmark_mem {L : Finset V} (hL : L.Nonempty) (v : V) : paperLandmark A wt G L v ∈ L := by
  rw [paperLandmark, dite_eq_left hL]; exact (L.exists_min_image _ hL).choose_spec.1

theorem paperLandmark_le {L : Finset V} (hL : L.Nonempty) (v : V) {l : V} (hl : l ∈ L) :
    pw A wt G v (paperLandmark A wt G L v) ≤ pw A wt G v l := by
  rw [paperLandmark, dite_eq_left hL]; exact (L.exists_min_image _ hL).choose_spec.2 l hl

/-- The paper's scheme: `u` stores `v` iff `v ∈ C(u) ∪ L`, where `v ∈ C(u) ↔ u ∈ B(v)` and
`B(v) = {x : w(p*_{v,x}) ⪯ w(p*_{v,l_v})}`; next hops from consistent in-trees `T`. -/
noncomputable def paperScheme (hM : A.IsMonotone) (T : ∀ t, InTree A wt G t) (L : Finset V)
    (hL : L.Nonempty) : Scheme A wt G where
  tree := T
  landmark := paperLandmark A wt G L
  Stores u v := pw A wt G v u ≤ pw A wt G v (paperLandmark A wt G L v) ∨ v ∈ L
  stores_landmark _ v := Or.inr (paperLandmark_mem hL v)
  good_self v := Or.inl (Or.inl (by rw [pw_self]; exact one_le _))
  stores_nh u v hu huv := by
    by_cases hvL : v ∈ L
    · exact Or.inr hvL
    refine Or.inl ?_
    have h1 : pw A wt G v ((T v).nh u) ≤ pw A wt G v u := by
      rw [pw_comm v, pw_comm v u]; exact (T v).pw_nh_le hM huv
    rcases hu with (hu | hu) | rfl
    · exact h1.trans hu
    · exact absurd hu hvL
    · exact h1
  pw_landmark_le _ _ h := (not_le.1 fun h' => h (Or.inl h')).le

/-- With consistent in-trees, the paper's literal scheme does route correctly within stretch 3. -/
theorem paperScheme_delivers (hR : A.IsRegular) (hconn : G.Connected) (T : ∀ t, InTree A wt G t)
    (L : Finset V) (hL : L.Nonempty) : (paperScheme hR.1 T L hL).Delivers :=
  Scheme.delivers _ hR hconn

/-- In a monotone selective algebra with all edge weights equal to `c`, any two distinct nodes of a connected
graph are at preferred weight `c`. -/
theorem pw_eq_of_const (hM : A.IsMonotone) (hS : A.IsSelective) (hconn : G.Connected) {c : W}
    (hwt : ∀ e, wt e = c) {x y : V} (hxy : x ≠ y) : pw A wt G x y = A.emb c := by
  have key : ∀ {a b : V} (p : G.Walk a b), weight A wt p = 1 ∨ weight A wt p = A.emb c := by
    intro a b p
    induction p with
    | nil => exact Or.inl rfl
    | cons h p ih =>
      right
      rw [weight_cons, hwt]
      rcases ih with h' | h'
      · rw [h', mul_one]
      · rw [h', emb_mul_emb, op_eq_max hM hS, max_self]
  obtain ⟨p, -, hp⟩ := exists_isPreferred_weight (A := A) (wt := wt) (hconn.preconnected x y)
  rw [← hp]
  exact (key p).resolve_left (hp ▸ pw_ne_one hxy)

/-- **Memory gap of the paper's balls.** For a monotone selective algebra (e.g. widest path), a connected graph
with all edge weights equal, *any* landmark set and any consistent in-trees, every routing table of the paper's
scheme contains all `n` destinations: `C(u) ⊇ V ∖ L` for every `u`. -/
theorem paperScheme_table_eq_univ (hM : A.IsMonotone) (hS : A.IsSelective) (hconn : G.Connected)
    {c : W} (hwt : ∀ e, wt e = c) (T : ∀ t, InTree A wt G t) (L : Finset V) (hL : L.Nonempty)
    (u : V) : (paperScheme hM T L hL).table u = Finset.univ := by
  ext v
  simp only [Scheme.mem_table, Finset.mem_univ, iff_true]
  change pw A wt G v u ≤ pw A wt G v (paperLandmark A wt G L v) ∨ v ∈ L
  by_cases hvL : v ∈ L
  · exact Or.inr hvL
  refine Or.inl ?_
  have hl : v ≠ paperLandmark A wt G L v := fun h => hvL (h ▸ paperLandmark_mem hL v)
  rw [pw_eq_of_const hM hS hconn hwt hl]
  by_cases hvu : v = u
  · subst hvu; rw [pw_self]; exact (one_lt_emb c).le
  · rw [pw_eq_of_const hM hS hconn hwt hvu]

theorem paperScheme_card_table (hM : A.IsMonotone) (hS : A.IsSelective) (hconn : G.Connected)
    {c : W} (hwt : ∀ e, wt e = c) (T : ∀ t, InTree A wt G t) (L : Finset V) (hL : L.Nonempty)
    (u : V) : ((paperScheme hM T L hL).table u).card = Fintype.card V := by
  rw [paperScheme_table_eq_univ hM hS hconn hwt T L hL u, Finset.card_univ]

end Paper

/-! ### The refined scheme (strict lexicographic keys) -/

section Refined

variable [Fintype V] [LinearOrder V]

/-- The strict key of `x` with respect to destination `v`: preferred weight to `v`, then rank in the in-tree
towards `v`, then the node identifier (lexicographically). -/
noncomputable def key (T : ∀ t, InTree A wt G t) (v x : V) : A.Ext ×ₗ (ℕ ×ₗ V) :=
  toLex (pw A wt G x v, toLex ((T v).rank x, x))

omit [LinearOrder V] in
theorem key_injective (T : ∀ t, InTree A wt G t) (v : V) : Function.Injective (key T v) := by
  intro x y h
  simp only [key, toLex_inj, Prod.mk.injEq] at h
  exact h.2.2

theorem key_lt_of (T : ∀ t, InTree A wt G t) {v x y : V} (h1 : pw A wt G y v ≤ pw A wt G x v)
    (h2 : (T v).rank y < (T v).rank x) : key T v y < key T v x := by
  rw [key, key, Prod.Lex.toLex_lt_toLex]
  rcases h1.lt_or_eq with h | h
  · exact Or.inl h
  · exact Or.inr ⟨h, Prod.Lex.toLex_lt_toLex.2 (Or.inl h2)⟩

theorem key_lt_of_pw_lt (T : ∀ t, InTree A wt G t) {v x y : V} (h : pw A wt G y v < pw A wt G x v) :
    key T v y < key T v x := by
  rw [key, key, Prod.Lex.toLex_lt_toLex]; exact Or.inl h

theorem pw_le_of_key_le (T : ∀ t, InTree A wt G t) {v x y : V} (h : key T v x ≤ key T v y) :
    pw A wt G x v ≤ pw A wt G y v := by
  by_contra h'
  exact absurd h (not_le.2 (key_lt_of_pw_lt T (not_le.1 h')))

theorem key_nh_lt (hM : A.IsMonotone) (T : ∀ t, InTree A wt G t) {v x : V} (hx : x ≠ v) :
    key T v ((T v).nh x) < key T v x :=
  key_lt_of T ((T v).pw_nh_le hM hx) ((T v).rank_lt x hx)

/-- The refined landmark of `v`: the landmark of minimal key (a closest landmark, ties broken by rank and
identifier). -/
noncomputable def refinedLandmark (T : ∀ t, InTree A wt G t) (L : Finset V) (v : V) : V :=
  if h : L.Nonempty then (L.exists_min_image (key T v) h).choose else v

theorem refinedLandmark_mem (T : ∀ t, InTree A wt G t) {L : Finset V} (hL : L.Nonempty) (v : V) :
    refinedLandmark T L v ∈ L := by
  rw [refinedLandmark, dite_eq_left hL]; exact (L.exists_min_image _ hL).choose_spec.1

theorem key_refinedLandmark_le (T : ∀ t, InTree A wt G t) {L : Finset V} (hL : L.Nonempty) (v : V)
    {l : V} (hl : l ∈ L) : key T v (refinedLandmark T L v) ≤ key T v l := by
  rw [refinedLandmark, dite_eq_left hL]; exact (L.exists_min_image _ hL).choose_spec.2 l hl

/-- The refined landmark is a closest landmark in the sense of the paper. -/
theorem pw_refinedLandmark_le (T : ∀ t, InTree A wt G t) {L : Finset V} (hL : L.Nonempty) (v : V)
    {l : V} (hl : l ∈ L) : pw A wt G v (refinedLandmark T L v) ≤ pw A wt G v l := by
  rw [pw_comm, pw_comm v]; exact pw_le_of_key_le T (key_refinedLandmark_le T hL v hl)

/-- The refined ball of `v`: nodes whose key is strictly below the key of `l_v`. -/
noncomputable def refinedBall (T : ∀ t, InTree A wt G t) (L : Finset V) (v : V) : Finset V :=
  Finset.univ.filter fun x => key T v x < key T v (refinedLandmark T L v)

/-- The refined cluster of `u`: `C(u) = {v : u ∈ B(v)}`. -/
noncomputable def refinedCluster (T : ∀ t, InTree A wt G t) (L : Finset V) (u : V) : Finset V :=
  Finset.univ.filter fun v => u ∈ refinedBall T L v

/-- The refined ball is contained in the paper's ball `{x : w(p*_{v,x}) ⪯ w(p*_{v,l_v})}` (same `l_v`). -/
theorem refinedBall_subset_paperBall (T : ∀ t, InTree A wt G t) (L : Finset V) (v : V) :
    refinedBall T L v ⊆
      Finset.univ.filter fun x => pw A wt G v x ≤ pw A wt G v (refinedLandmark T L v) := by
  intro x hx
  simp only [refinedBall, Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
  rw [pw_comm v x, pw_comm v]
  exact pw_le_of_key_le T hx.le

/-- **Ball size control.** If some landmark is among the nodes of key below `k`, the ball lies there:
`B(v) ⊆ {x : key_v x < key_v l}` for every `l ∈ L`. -/
theorem refinedBall_subset (T : ∀ t, InTree A wt G t) {L : Finset V} (hL : L.Nonempty) (v : V)
    {l : V} (hl : l ∈ L) :
    refinedBall T L v ⊆ Finset.univ.filter fun x => key T v x < key T v l := by
  intro x hx
  simp only [refinedBall, Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
  exact hx.trans_le (key_refinedLandmark_le T hL v hl)

/-- The refined scheme: `u` stores `v` iff `v ∈ C(u) ∪ L` with the refined balls. -/
noncomputable def refinedScheme (hM : A.IsMonotone) (T : ∀ t, InTree A wt G t) (L : Finset V)
    (hL : L.Nonempty) : Scheme A wt G where
  tree := T
  landmark := refinedLandmark T L
  Stores u v := u ∈ refinedBall T L v ∨ v ∈ L
  stores_landmark _ v := Or.inr (refinedLandmark_mem T hL v)
  good_self v := by
    by_cases hv : v = refinedLandmark T L v
    · exact Or.inr hv
    refine Or.inl (Or.inl ?_)
    simp only [refinedBall, Finset.mem_filter, Finset.mem_univ, true_and]
    refine key_lt_of_pw_lt T ?_
    rw [pw_self]
    exact lt_of_le_of_ne (one_le _) (pw_ne_one (Ne.symm hv)).symm
  stores_nh u v hu huv := by
    by_cases hvL : v ∈ L
    · exact Or.inr hvL
    refine Or.inl ?_
    simp only [refinedBall, Finset.mem_filter, Finset.mem_univ, true_and] at hu ⊢
    have h1 := key_nh_lt hM T huv
    rcases hu with (hu | hu) | hu
    · exact h1.trans hu
    · exact absurd hu hvL
    · rw [hu] at h1 ⊢; exact h1
  pw_landmark_le u v h := by
    have : key T v (refinedLandmark T L v) ≤ key T v u := by
      refine not_lt.1 fun h' => h (Or.inl ?_)
      simpa [refinedBall] using h'
    rw [pw_comm v, pw_comm v u]
    exact pw_le_of_key_le T this

theorem refinedScheme_table (hM : A.IsMonotone) (T : ∀ t, InTree A wt G t) (L : Finset V)
    (hL : L.Nonempty) (u : V) : (refinedScheme hM T L hL).table u = refinedCluster T L u ∪ L := by
  ext v
  rw [Scheme.mem_table]
  simp [refinedScheme, refinedCluster]

/-- Table size: `|C(u) ∪ L| ≤ |C(u)| + |L|`; Cowen's landmark selection (a purely combinatorial statement about
the key orders, not formalized) makes this `O(n^{2/3})`. -/
theorem card_table_le (hM : A.IsMonotone) (T : ∀ t, InTree A wt G t) (L : Finset V) (hL : L.Nonempty)
    (u : V) :
    ((refinedScheme hM T L hL).table u).card ≤ (refinedCluster T L u).card + L.card := by
  rw [refinedScheme_table]; exact Finset.card_union_le _ _

/-- **Theorem 4.14 of [Rétvári et al.]** (corrected). Let `A` be regular (delimitedness is not needed), `G` a
finite connected graph with arbitrary edge weights, and `L` a nonempty set of landmarks. With consistent in-trees
(`inTree`) and the refined balls, Cowen's scheme delivers every packet along a path within stretch 3, the
forwarding decisions use only the local table and the header, and the table of `u` is exactly `C(u) ∪ L`. -/
theorem theorem_4_14 (hR : A.IsRegular) (hconn : G.Connected) (L : Finset V) (hL : L.Nonempty) :
    (refinedScheme hR.1 (inTree (wt := wt) hR hconn) L hL).Delivers ∧
      ∀ u, (refinedScheme hR.1 (inTree (wt := wt) hR hconn) L hL).table u =
        refinedCluster (inTree (wt := wt) hR hconn) L u ∪ L :=
  ⟨Scheme.delivers _ hR hconn, refinedScheme_table _ _ L hL⟩

end Refined

/-! ### Non-vacuity: a delimited regular selective algebra -/

section Max

variable (X : Type u) [LinearOrder X] [OrderTop X]

/-- The bottleneck algebra `(X, ⊤, max, ≤)` (widest path up to reversing the order). -/
def maxAlgebra : RoutingAlgebra X where
  op := max
  op_assoc := max_assoc
  op_comm := max_comm
  phi := ⊤
  op_phi _ := max_top_right _
  le_phi _ := le_top

theorem maxAlgebra_props : (maxAlgebra X).IsRegular ∧ (maxAlgebra X).IsSelective ∧
    (maxAlgebra X).IsDelimited := by
  have hS : (maxAlgebra X).IsSelective := fun a b => by
    rcases le_total a b with h | h
    · exact Or.inr (max_eq_right h)
    · exact Or.inl (max_eq_left h)
  exact ⟨⟨fun a b => le_max_right b a, fun _ _ c h => max_le_max_left c h⟩, hS, hS.isDelimited⟩

end Max

/-! ### Strict balls make the paper's forwarding loop -/

section StrictLoop

/-- In a monotone selective algebra with constant edge weights `c`, any neighbour map with a decreasing rank is
a consistent in-tree. -/
def inTreeOfConst [Fintype V] (hM : A.IsMonotone) (hS : A.IsSelective) (hconn : G.Connected) {c : W}
    (hwt : ∀ e, wt e = c) (t : V) (nh : V → V) (rank : V → ℕ) (hadj : ∀ x, x ≠ t → G.Adj x (nh x))
    (hrank : ∀ x, x ≠ t → rank (nh x) < rank x) : InTree A wt G t where
  nh := nh
  rank := rank
  adj := hadj
  rank_lt := hrank
  weight_eq x hx := by
    rw [pw_eq_of_const hM hS hconn hwt hx, hwt]
    by_cases h : nh x = t
    · rw [h, pw_self, mul_one]
    · rw [pw_eq_of_const hM hS hconn hwt h, emb_mul_emb, op_eq_max hM hS, max_self]

/-- The path `0 — 1 — 2`. -/
def path3 : SimpleGraph (Fin 3) where
  Adj x y := x.val + 1 = y.val ∨ y.val + 1 = x.val
  symm := ⟨fun _ _ h => h.symm⟩
  loopless := ⟨fun _ h => by rcases h with h | h <;> omega⟩

instance : DecidableRel path3.Adj := fun _ _ => inferInstanceAs (Decidable (_ ∨ _))

theorem path3_connected : path3.Connected := by
  have h01 : path3.Adj 0 1 := Or.inl rfl
  have h12 : path3.Adj 1 2 := Or.inl rfl
  have r : ∀ x, path3.Reachable 0 x := by
    intro x
    fin_cases x
    · rfl
    · exact h01.reachable
    · exact h01.reachable.trans h12.reachable
  exact ⟨fun u v => (r u).symm.trans (r v)⟩

/-- Next hop on `path3` towards `t`. -/
def nh3 (t x : Fin 3) : Fin 3 := if x.val < t.val then x + 1 else if t.val < x.val then x - 1 else x

/-- Hop distance on `path3`. -/
def rank3 (t x : Fin 3) : ℕ := if x.val ≤ t.val then t.val - x.val else x.val - t.val

/-- Constant edge weight `false` in the bottleneck algebra on `Bool`. -/
def wt3 : Sym2 (Fin 3) → Bool := fun _ => false

/-- The (unique) consistent in-trees of `path3`. -/
noncomputable def T3 (t : Fin 3) : InTree (maxAlgebra Bool) wt3 path3 t :=
  inTreeOfConst (maxAlgebra_props Bool).1.1 (maxAlgebra_props Bool).2.1 path3_connected
    (fun _ => rfl) t (nh3 t) (rank3 t) (by revert t; decide) (by revert t; decide)

/-- The *strict* ball variant of the paper's storage rule with landmark set `L = {0}`:
`u` stores `v` iff `w(p*_{v,u}) ≺ w(p*_{v,l_v})` or `v ∈ L`. -/
def strictStores3 (u v : Fin 3) : Prop :=
  pw (maxAlgebra Bool) wt3 path3 v u < pw (maxAlgebra Bool) wt3 path3 v 0 ∨ v = 0

/-- **Strict balls loop.** In the bottleneck (widest-path-like) algebra, which is delimited, regular and
selective, on the path `0 — 1 — 2` with equal edge weights and `L = {0}`, Cowen's forwarding with strict balls
never delivers a packet from `0` to `2`: `l_2 = 0` sends it to `1`, which does not store `2` (it is not
*strictly* closer to `2` than `0`) and returns it to the landmark `0`. -/
theorem strictBall_loops :
    ∀ n, (cowenNext T3 (fun _ => 0) strictStores3 2)^[n] 0 ≠ 2 := by
  have hpw : ∀ x y : Fin 3, x ≠ y → pw (maxAlgebra Bool) wt3 path3 x y = (maxAlgebra Bool).emb false :=
    fun x y h => pw_eq_of_const (maxAlgebra_props Bool).1.1 (maxAlgebra_props Bool).2.1 path3_connected
      (fun _ => rfl) h
  set f := cowenNext T3 (fun _ => 0) strictStores3 2 with hf
  have h0 : f 0 = 1 := by
    simp [hf, cowenNext, cowenForward, cowenLookup, cowenLabel, strictStores3, T3, inTreeOfConst, nh3]
  have h1 : f 1 = 0 := by
    simp [hf, cowenNext, cowenForward, cowenLookup, cowenLabel, strictStores3, T3, inTreeOfConst, nh3,
      hpw]
  have key : ∀ n, f^[n] 0 = 0 ∨ f^[n] 0 = 1 := by
    intro n
    induction n with
    | zero => exact Or.inl rfl
    | succ n ih =>
      rw [Function.iterate_succ_apply']
      rcases ih with h | h <;> rw [h]
      · exact Or.inr h0
      · exact Or.inl h1
  intro n h
  rcases key n with h' | h' <;> rw [h'] at h <;> exact absurd h (by decide)

/-- Non-vacuity of `paperScheme_card_table`: on `path3` with `L = {0}` every table of the paper's scheme has all
`3` entries. -/
theorem paperScheme_card_table_path3 (u : Fin 3) :
    ((paperScheme (maxAlgebra_props Bool).1.1 T3 {0} (Finset.singleton_nonempty 0)).table u).card = 3 :=
  paperScheme_card_table (maxAlgebra_props Bool).1.1 (maxAlgebra_props Bool).2.1 path3_connected
    (c := false) (fun _ => rfl) T3 {0} _ u

end StrictLoop

end Podc.CompactPolicyRouting
